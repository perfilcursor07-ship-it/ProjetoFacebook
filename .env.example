PORT=3000
NODE_ENV=development

DATABASE_URL=mysql://root:@localhost:3306/clipador

# Obrigatória para gerar matéria (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Modelo: deepseek-v4-flash (padrão) | deepseek-v4-pro | deepseek-chat (legado até 2026-07-24)
DEEPSEEK_MODEL=deepseek-v4-flash
# Passes auxiliares que sobraram na DeepSeek. Vazio = usa o DEEPSEEK_MODEL.
DEEPSEEK_WRITER_MODEL=deepseek-v4-flash
PEXELS_API_KEY=

# Busca na internet para complementar matérias (recomendado: pelo menos uma)
# Google News/RSS/Python funciona sem chave. Brave NEWS fica desligado por
# padrão, mas BRAVE_SEARCH_API_KEY continua sendo usada no "Trocar imagem".
SEARCH_ENABLE_BRAVE=false
BRAVE_SEARCH_API_KEY=
SEARCH_ENABLE_SERPER=false
SERPER_API_KEY=
# SerpApi (https://serpapi.com) — Google Images para sugestões de capa (pessoa/assunto)
SERPAPI_API_KEY=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# PostPulse (API comercial — sem App Review da Meta)
# No painel PostPulse, Redirect URI deve ser EXATAMENTE o valor abaixo:
POSTPULSE_CLIENT_ID=
POSTPULSE_CLIENT_SECRET=
POSTPULSE_REDIRECT_URI=http://localhost:3000/api/auth/postpulse/callback

# Ayrshare — publicação Facebook/Instagram/X (Primary Profile API Key)
# Dashboard: https://app.ayrshare.com → API Key
# Conecte a Página do Facebook em Social Accounts antes de publicar.
# Mídia precisa de URL HTTPS pública: defina APP_PUBLIC_URL (ex.: https://www.viralizeai.online)
AYRSHARE_API_KEY=
# X.com: desde 31/03/2026 a Ayrshare exige as credenciais do seu X Developer App.
# Use a mesma dupla em todos os User Profiles da Ayrshare.
AYRSHARE_X_API_KEY=
AYRSHARE_X_API_SECRET=
APP_PUBLIC_URL=

# PostSyncer (legado — alternativa)
# https://app.postsyncer.com → Settings → API Integration → Create
POSTSYNCER_API_KEY=
# Opcional: se vazio, usa o primeiro workspace da conta
POSTSYNCER_WORKSPACE_ID=

# auto = Ayrshare (se key) → PostSyncer (se vinculado) → PostPulse → Graph API
# ayrshare | postsyncer | postpulse | facebook
PUBLISH_PROVIDER=ayrshare

SESSION_SECRET=troque-por-um-segredo-forte

# Caminho do ffmpeg (opcional se estiver no PATH)
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe

# Autenticação yt-dlp/YouTube (não use as duas opções ao mesmo tempo)
# Desenvolvimento local: chrome, edge, firefox, brave, opera ou vivaldi
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Produção: arquivo Netscape cookies.txt fora de public/ e storage/, sempre com caminho absoluto
# YTDLP_COOKIES_FILE=/home/viralizeai/secrets/youtube-cookies.txt

# Extração de fala: Python 3.9+ + faster-whisper
# Produção: python3 -m venv .venv
# ./.venv/bin/python -m pip install -r scripts/requirements.txt
# Se `python` não estiver no PATH, aponte o executável:
# PYTHON_PATH=C:\\Python313\\python.exe
PYTHON_PATH=
# Perfil rápido para transcrever vídeos sem legenda pública (tiny | base | small)
TRANSCRICAO_WHISPER_MODEL=base
TRANSCRICAO_WHISPER_BEAM_SIZE=1
# Perfil usado automaticamente em Reels do Instagram/Facebook
TRANSCRICAO_WHISPER_ACCURATE_MODEL=small
TRANSCRICAO_WHISPER_ACCURATE_BEAM_SIZE=3

# YouTube / yt-dlp (produção CloudPanel)
# YTDLP_COOKIES_FILE=/home/viralizeai/secrets/youtube-cookies.txt
# Cookies do Instagram (Netscape) — Biblioteca + gerar matéria a partir de link IG em /conteudo
# Windows local: YTDLP_IG_COOKIES_FILE=C:/caminho/do/projeto/secrets/instagram-cookies.txt
# Linux/produção: YTDLP_IG_COOKIES_FILE=/home/viralizeai/secrets/instagram-cookies.txt

# Cookies do Facebook (Netscape) — posts que exigem login ("only available for
# registered users"). Destrava a leitura sem gastar créditos de ScrapeCreators/Apify.
# Precisa conter c_user e xs. Valide com: node scripts/test-fb-cookies.js
# Windows local: YTDLP_FB_COOKIES_FILE=C:/caminho/do/projeto/secrets/facebook-cookies.txt
# Linux/produção: YTDLP_FB_COOKIES_FILE=/home/viralizeai/secrets/facebook-cookies.txt

# Evitar bloqueio "várias sessões" da Meta (Facebook/Instagram):
# - Use uma conta só para o servidor e exporte os cookies do Chrome do próprio
#   servidor (noVNC), para a sessão ter o mesmo IP e o mesmo navegador.
# - SOCIAL_USER_AGENT: User-Agent exato do navegador de onde os cookies saíram.
# SOCIAL_USER_AGENT=
# - Teste de login dos cookies no boot: no máximo a cada N horas (0 desliga).
# SOCIAL_VALIDACAO_HORAS=12
# - Cabeçalho do app Android do Instagram com a mesma sessão = outro "aparelho".
#   Desligado por padrão; só ligue se souber o que está fazendo.
# INSTAGRAM_API_MOBILE=0

# Raciocínio estendido do DeepSeek: qualidade x latência na escrita de matéria.
# auto (padrão) = pensa na redação/apuração e pula em tarefas simples | on = sempre | off = nunca
# DEEPSEEK_THINKING=auto
# DEEPSEEK_REASONING_EFFORT=high   # high|max (só quando thinking ligado)

# ScrapeCreators — posts Facebook/Instagram (pay-as-you-go, 100 créditos grátis no cadastro)
# Radar Face (página FB) usa isto ANTES do Apify — curtidas/comentários reais, sem limite 24h
# https://scrapecreators.com/
SEARCH_ENABLE_SCRAPECREATORS=false
SCRAPECREATORS_API_KEY=

# Bright Data - coleta um post do Instagram pela URL (5 mil registros/mes no plano gratuito)
# https://brightdata.com/products/web-scraper/instagram
BRIGHTDATA_API_TOKEN=

# ElevenLabs — narração humanizada para Reel (imagem da matéria + voz)
# Cadastro/teste: https://elevenlabs.io (free ~10k chars/mês) | pay-as-you-go na API
# Free: use voz de "My Voices" (não Voice Library). Sem VOICE_ID, o app escolhe uma da conta.
# My Voices: https://elevenlabs.io/app/voice-lab
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Apify — fallback Radar Face (Trends + posts FB). Free tier: ~1 run/24h por actor
# Token: https://console.apify.com/account/integrations
APIFY_TOKEN=
# Actor oficial para legenda/imagem de um post individual do Instagram.
APIFY_IG_POST_ACTOR=apify/instagram-scraper
# Actor de busca por keyword (curtidas/comentários). Ajustável se trocar de actor.
APIFY_FB_SEARCH_ACTOR=scrapeforge/facebook-search-posts
# Opcional: Facebook location UID para filtrar geo (Brasil). Sem isso, a query inclui "Brasil".
# APIFY_FB_LOCATION_UID=
# YTDLP_JS_RUNTIME=node:/usr/local/bin/node
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Produção (CloudPanel exemplo) ---
# PORT=3010
# NODE_ENV=production
# DATABASE_URL=mysql://clipador:SENHA@127.0.0.1:3306/clipador
# FACEBOOK_REDIRECT_URI=https://www.viralizeai.online/api/auth/facebook/callback
# POSTPULSE_CLIENT_ID=
# POSTPULSE_CLIENT_SECRET=
# POSTPULSE_REDIRECT_URI=https://www.viralizeai.online/api/auth/postpulse/callback
# AYRSHARE_API_KEY=
# APP_PUBLIC_URL=https://www.viralizeai.online
# PUBLISH_PROVIDER=ayrshare
# Checklist Ayrshare: Social Accounts → conectar Página Facebook; regenerar API Key se ela vazou.
# POSTSYNCER_API_KEY=
# POSTSYNCER_WORKSPACE_ID=
# SESSION_SECRET=gere-um-segredo-longo-aleatorio
# Fuso para logs/processo (opcional; agendamento de matérias usa Araguaína UTC−3 no código)
# TZ=America/Araguaina
# --- IA das materias ---
# deepseek (padrao) | claude | token-free
AI_PROVIDER=deepseek

# token-free-gateway — usado somente nas tarefas listadas abaixo.
# Instale/autorize/inicie no MESMO servidor do Node:
#   npm install -g token-free-gateway
#   token-free-gateway webauth
#   token-free-gateway start
# Windows: se o release npm 0.5.1 falhar ao localizar playwright-core, use a
# versao-fonte em .tools/token-free-gateway e os scripts npm gateway:auth/start.
# O /v1 e acrescentado automaticamente se voce informar so http://127.0.0.1:3456.
TOKEN_FREE_GATEWAY_BASE_URL=http://127.0.0.1:3456/v1
# Deve ser igual ao apiKey/TFG_API_KEY configurado no gateway. Se o gateway
# estiver sem autenticacao, qualquer valor nao vazio funciona.
TOKEN_FREE_GATEWAY_API_KEY=
TOKEN_FREE_GATEWAY_MODEL=claude-sonnet-5
# conversa = fluxo do /materia-manual; separe outras tarefas por virgula.
TOKEN_FREE_GATEWAY_TAREFAS=conversa
# O gateway espera ate 300s pelo navegador; o cliente precisa esperar um pouco mais.
TOKEN_FREE_GATEWAY_TIMEOUT_MS=330000
# Painel administrativo /claude. As credenciais continuam fora de public/,
# em ~/.token-free-gateway. Ajuste somente se o fonte/Bun estiver em outro local.
# TOKEN_FREE_GATEWAY_SOURCE_DIR=C:/caminho/token-free-gateway
# BUN_PATH=C:/caminho/bun.exe
# Em produção, fixe este caminho no usuário que executa o PM2 para não criar
# uma credencial diferente quando o deploy for rodado por outro shell.
# TFG_STORE_PATH=/home/viralizeai/.token-free-gateway/auth-profiles.json
# TFG_AUTO_RECAPTURE=true

# Imagem com IA (Recortar foto > Criar nova versao com ChatGPT). Opcional:
# com a chave, a imagem sai direto da API oficial (mais rapida, paga por
# imagem); sem ela ou se a API falhar, usa o ChatGPT web pelo Chrome isolado.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high (medium equilibra custo e qualidade para o feed)
# OPENAI_IMAGE_QUALITY=medium

ANTHROPIC_API_KEY=
# Modelo caro: so a redacao da materia
CLAUDE_WRITER_MODEL=claude-sonnet-5
# Modelo barato: titulo, hashtags, resumo, classificacao, memoria de estilo
CLAUDE_AUX_MODEL=claude-haiku-4-5
# Quais tarefas vao no Claude; o resto fica na DeepSeek
# redacao = escrever materia | conversa = chat do /materia-manual | auxiliar = imagem, titulo, hashtags, radar
CLAUDE_TAREFAS=redacao,conversa
# off (padrao) | adaptive — raciocinio custa token de saida
CLAUDE_THINKING=off
# on (padrao) | off — cache de prompt do bloco fixo do system
CLAUDE_CACHE=on

# Ritmo das chamadas ao YouTube (o YouTube limita por IP: HTTP 429 / "not a bot").
# Intervalo entre chamadas, pausa após um bloqueio (dobra até o teto) e por
# quanto tempo a busca de vídeos do Furos do dia é reaproveitada.
YOUTUBE_INTERVALO_MS=5000
YOUTUBE_PAUSA_MIN=30
YOUTUBE_PAUSA_MAX_MIN=120
YOUTUBE_BUSCA_CACHE_MIN=30

# Publicacao automatica quando a pagina ja tem noticia parecida.
# Padrao (vazio/false): publica assim mesmo, so registra aviso no log.
# true: devolve a materia para rascunho e cancela o agendamento.
# PUBLICAR_BLOQUEAR_REPETIDA=false
