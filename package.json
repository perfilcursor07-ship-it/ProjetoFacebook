{
  "name": "viralizeai",
  "version": "1.0.0",
  "description": "ViralizeAI — buscar, cortar com IA e publicar vídeos no Facebook",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "node scripts/install-token-free-gateway-overrides.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "build:css": "tailwindcss -i ./src/assets/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/input.css -o ./public/css/app.css --watch",
    "gateway:auth": "bun .tools/token-free-gateway/index.ts webauth",
    "gateway:sync": "node scripts/install-token-free-gateway-overrides.js --required",
    "pregateway:start": "npm run gateway:sync",
    "gateway:start": "bun .tools/token-free-gateway/index.ts start",
    "gateway:stop": "bun .tools/token-free-gateway/index.ts stop",
    "pregateway:restart": "npm run gateway:sync",
    "gateway:restart": "bun .tools/token-free-gateway/index.ts restart",
    "gateway:status": "bun .tools/token-free-gateway/index.ts status",
    "claude-desktop:start": "pm2 startOrReload ecosystem.claude-desktop.config.cjs",
    "claude-desktop:restart": "pm2 restart claude-xvfb claude-openbox claude-vnc claude-novnc",
    "check:claude-production": "node scripts/check-claude-production.js",
    "check:token-free": "node scripts/check-token-free-gateway.js",
    "test:token-free": "node --test --experimental-test-isolation=none tests/tokenFreeGatewayService.test.js",
    "test:gateway-overrides": "node --experimental-transform-types --no-warnings --test \"gateway-overrides/token-free-gateway/test/*.test.ts\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "npm run gateway:sync && pm2 startOrReload ecosystem.config.cjs --only viralizeai --update-env",
    "pm2:reload-with-gateway": "npm run gateway:restart && pm2 startOrReload ecosystem.config.cjs --only viralizeai --update-env",
    "pm2:logs": "pm2 logs viralizeai --lines 80"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@tesseract.js-data/por": "^1.0.0",
    "apify-client": "^2.23.4",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bgutils-js": "^4.0.3",
    "canvas": "^3.2.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "google-trends-api": "^4.9.2",
    "jsdom": "^26.1.0",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pdf-parse": "1.1.1",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.17",
    "tesseract.js": "^7.0.0",
    "youtube-dl-exec": "^3.1.9",
    "youtubei.js": "^17.2.0"
  }
}
