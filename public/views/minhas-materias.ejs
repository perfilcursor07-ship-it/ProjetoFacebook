<%- include('partials/app-start') %>
  <link rel="stylesheet" href="/css/dots.css?v=20261003e" />
<%
  const mattersList = typeof matters !== 'undefined' && Array.isArray(matters) ? matters : [];
  const q = typeof searchQuery !== 'undefined' ? String(searchQuery || '') : '';
  const activeStatus = typeof statusFilter !== 'undefined' ? String(statusFilter || 'all') : 'all';
  const activeViralLevel = typeof viralLevel !== 'undefined' ? String(viralLevel || 'all') : 'all';
  const activeViralOrder = typeof viralOrder !== 'undefined' ? String(viralOrder || 'viral') : 'viral';
  const counts = typeof statusCounts !== 'undefined' && statusCounts ? statusCounts : { all: 0 };
  const pag = typeof pagination !== 'undefined' && pagination ? pagination : {
    page: 1, perPage: 10, total: mattersList.length, totalPages: 1,
  };
  const statusLabels = {
    rascunho: 'Rascunho',
    pronto: 'Pronta',
    agendado: 'Agendada',
    publicado: 'Publicada',
    erro: 'Erro',
  };
  const statusClass = {
    rascunho: 'bg-slate-800 text-slate-300',
    pronto: 'bg-sky-500/15 text-sky-300',
    agendado: 'bg-amber-500/15 text-amber-300',
    publicado: 'bg-emerald-500/15 text-emerald-300',
    erro: 'bg-rose-500/15 text-rose-300',
  };
  const tabDefs = [
    { key: 'all', label: 'Todas' },
    { key: 'viralizou', label: 'Viralizou' },
    { key: 'agendado', label: 'Agendadas' },
    { key: 'rascunho', label: 'Rascunhos' },
    { key: 'pronto', label: 'Prontas' },
    { key: 'publicado', label: 'Publicadas' },
    { key: 'erro', label: 'Erros' },
  ];
  function formatViews(n) {
    // Number(null) === 0 — não tratar null/undefined/'' como zero
    if (n == null || n === '') return null;
    const v = Number(n);
    if (!Number.isFinite(v) || v < 0) return null;
    if (v >= 1000000) return (v / 1000000).toFixed(1).replace(/\.0$/, '') + ' mi';
    if (v >= 1000) return (v / 1000).toFixed(1).replace(/\.0$/, '') + ' mil';
    return String(Math.round(v));
  }
  function viralBadge(likes, comments, shares, views) {
    const l = Number(likes) || 0;
    const c = Number(comments) || 0;
    const s = Number(shares) || 0;
    const v = Number(views) || 0;
    const score = l + c * 3 + s * 5 + Math.min(v, 5000) / 50;
    if (score >= 180 || l >= 80 || c >= 25) {
      return { nivel: 'alto', label: 'Viralizou', score, cls: 'bg-rose-500/20 text-rose-200 ring-rose-500/30' };
    }
    if (score >= 80 || l >= 40 || c >= 10) {
      return { nivel: 'medio', label: 'Bom', score, cls: 'bg-amber-500/15 text-amber-200 ring-amber-500/25' };
    }
    if (l > 0 || c > 0 || s > 0 || v > 0) {
      return { nivel: 'baixo', label: 'Baixo', score, cls: 'bg-slate-700/40 text-slate-400 ring-slate-600/40' };
    }
    return null;
  }
  function formatQuando(value) {
    if (!value) return '';
    try {
      return new Date(value).toLocaleString('pt-BR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return '';
    }
  }
  function formatQuandoCurto(value) {
    if (!value) return '';
    try {
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return '';
      const months = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
      const day = String(d.getDate()).padStart(2, '0');
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      return day + ' ' + months[d.getMonth()] + ' · ' + hh + ':' + mm;
    } catch {
      return '';
    }
  }
  function listHref({ status, page, keepQuery, nivel, ordem } = {}) {
    const params = new URLSearchParams();
    if (keepQuery !== false && q) params.set('q', q);
    const st = status != null ? status : activeStatus;
    if (st && st !== 'all') params.set('status', st);
    if (st === 'viralizou') {
      const selectedLevel = nivel != null ? nivel : activeViralLevel;
      const selectedOrder = ordem != null ? ordem : activeViralOrder;
      if (selectedLevel && selectedLevel !== 'all') params.set('nivel', selectedLevel);
      if (selectedOrder && selectedOrder !== 'viral') params.set('ordem', selectedOrder);
    }
    const p = page != null ? page : pag.page;
    if (p && p > 1) params.set('page', String(p));
    const qs = params.toString();
    return '/minhas-materias' + (qs ? '?' + qs : '');
  }
  function pageWindow(current, total, size = 5) {
    if (total <= size) {
      return Array.from({ length: total }, (_, i) => i + 1);
    }
    let start = Math.max(1, current - Math.floor(size / 2));
    let end = start + size - 1;
    if (end > total) {
      end = total;
      start = Math.max(1, end - size + 1);
    }
    return Array.from({ length: end - start + 1 }, (_, i) => start + i);
  }
  function artThumbUrl(item) {
    if (item && item.imagem_path) {
      return '/media/' + String(item.imagem_path).replace(/^\/+/, '').replace(/\\/g, '/');
    }
    const img = String(item?.imagem_url || '').trim();
    if (/^https?:\/\//i.test(img) || img.startsWith('/')) return img;
    const fonte = String(item?.imagem_fonte_url || '').trim();
    if (/^https?:\/\//i.test(fonte) || fonte.startsWith('/')) return fonte;
    return '';
  }
  // Abas com matéria que ainda pode sair: dá para escolher várias e agendar ou publicar.
  const selecionavel = ['rascunho', 'pronto', 'erro'].includes(activeStatus);
  const pages = pageWindow(pag.page, pag.totalPages, 5);
  const fromItem = pag.total === 0 ? 0 : (pag.page - 1) * pag.perPage + 1;
  const toItem = Math.min(pag.page * pag.perPage, pag.total);
%>

  <main class="dots-pagina matters-page mx-auto max-w-8xl px-4 py-6 sm:px-6 sm:py-10" data-matters-page>
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="dots-etiqueta">Matérias</p>
        <h1 class="dots-titulo mt-1">Matérias salvas</h1>
        <p class="dots-sub">
          Tudo que foi criado, agendado ou publicado fica aqui. Filtre por status, acompanhe
          desempenho e abra uma matéria para ajustar antes de publicar.
        </p>
      </div>
      <a href="/materia-manual"
        class="d-btn d-btn--principal">
        Criar matéria
      </a>
    </header>

    <section class="d-card mt-7 p-3 sm:p-4">
      <form method="get" action="/minhas-materias" class="matters-search">
        <% if (activeStatus && activeStatus !== 'all') { %>
          <input type="hidden" name="status" value="<%= activeStatus %>" />
        <% } %>
        <% if (activeStatus === 'viralizou' && activeViralLevel !== 'all') { %>
          <input type="hidden" name="nivel" value="<%= activeViralLevel %>" />
        <% } %>
        <% if (activeStatus === 'viralizou' && activeViralOrder !== 'viral') { %>
          <input type="hidden" name="ordem" value="<%= activeViralOrder %>" />
        <% } %>
        <label class="matters-search-field">
          <span class="sr-only">Buscar matérias</span>
          <input type="search" name="q" value="<%= q %>" placeholder="Buscar título, texto, fonte..." />
        </label>
        <button type="submit" class="d-btn d-btn--neutro">
          Buscar
        </button>
        <% if (q) { %>
          <a href="<%= listHref({ status: activeStatus, page: 1, keepQuery: false }) %>" class="d-btn d-btn--fantasma">Limpar</a>
        <% } %>
      </form>

      <div class="matters-tabs mt-3" role="tablist" aria-label="Filtrar por status" id="mia-status-tabs">
        <% tabDefs.forEach((tab) => {
          const count = counts[tab.key] || 0;
          const isActive = activeStatus === tab.key;
          if (tab.key !== 'all' && tab.key !== 'viralizou' && count === 0 && !isActive) return;
        %>
          <a href="<%= listHref({ status: tab.key, page: 1 }) %>"
            role="tab"
            aria-selected="<%= isActive ? 'true' : 'false' %>"
            data-status="<%= tab.key %>"
            class="mia-status-tab <%= isActive ? 'is-active' : '' %> <%= tab.key === 'viralizou' ? 'is-viral' : '' %>">
            <%= tab.label %>
            <span class="mia-tab-count"><%= count %></span>
          </a>
        <% }) %>
      </div>

      <% if (activeStatus === 'viralizou') { %>
        <p class="mt-3 text-xs leading-relaxed" style="color: var(--d-texto-3)">
          Mostra posts com engajamento <span class="text-rose-300">Viralizou</span> ou <span class="text-amber-300">Bom</span>.
          Ao abrir esta aba, o sistema atualiza as publicações recentes no Facebook.
          <% if (typeof engajamentoSync !== 'undefined' && engajamentoSync) { %>
            <span style="color: var(--d-texto-2)">Sync: <%= engajamentoSync.checked || 0 %> posts, <%= engajamentoSync.destaques || 0 %> em destaque.</span>
          <% } %>
        </p>

        <form method="get" action="/minhas-materias" class="matters-viral-filter mt-3">
          <input type="hidden" name="status" value="viralizou" />
          <% if (q) { %><input type="hidden" name="q" value="<%= q %>" /><% } %>
          <label>
            <span>Desempenho</span>
            <select name="nivel">
              <option value="all" <%= activeViralLevel === 'all' ? 'selected' : '' %>>Todos: Viralizou + Bom</option>
              <option value="alto" <%= activeViralLevel === 'alto' ? 'selected' : '' %>>Somente Viralizou</option>
              <option value="medio" <%= activeViralLevel === 'medio' ? 'selected' : '' %>>Somente Bom</option>
            </select>
          </label>
          <label>
            <span>Ordenar por</span>
            <select name="ordem">
              <option value="viral" <%= activeViralOrder === 'viral' ? 'selected' : '' %>>Mais viralizou primeiro</option>
              <option value="curtidas" <%= activeViralOrder === 'curtidas' ? 'selected' : '' %>>Mais curtidas</option>
              <option value="comentarios" <%= activeViralOrder === 'comentarios' ? 'selected' : '' %>>Mais comentários</option>
              <option value="compartilhamentos" <%= activeViralOrder === 'compartilhamentos' ? 'selected' : '' %>>Mais compartilhamentos</option>
              <option value="visualizacoes" <%= activeViralOrder === 'visualizacoes' ? 'selected' : '' %>>Mais visualizações</option>
              <option value="recente" <%= activeViralOrder === 'recente' ? 'selected' : '' %>>Mais recentes</option>
            </select>
          </label>
          <button type="submit" class="d-btn d-btn--neutro">
            Aplicar filtro
          </button>
          <% if (activeViralLevel !== 'all' || activeViralOrder !== 'viral') { %>
            <a href="<%= listHref({ status: 'viralizou', page: 1, nivel: 'all', ordem: 'viral' }) %>"
              class="d-btn d-btn--fantasma">Limpar</a>
          <% } %>
        </form>
      <% } %>
    </section>

    <% if (!mattersList.length) { %>
      <div class="d-vazio mt-5">
        <span class="d-vazio-icone" aria-hidden="true"><i></i><i></i><i></i></span>
        <p>
          <%= q
            ? 'Nenhuma matéria encontrada para essa busca.'
            : (activeStatus === 'viralizou'
              ? 'Nenhuma matéria com bom engajamento ainda. Abra Publicadas para sincronizar curtidas/comentários, ou aguarde o sync automático desta aba.'
              : (activeStatus !== 'all' ? 'Nenhuma matéria neste status.' : 'Nenhuma matéria gerada ainda.')) %>
        </p>
        <a href="<%= q || activeStatus !== 'all' ? '/minhas-materias' : '/materia-manual' %>" class="mt-2 inline-flex text-emerald-300 hover:text-emerald-200">
          <%= q || activeStatus !== 'all' ? 'Ver todas →' : 'Criar matéria →' %>
        </a>
      </div>
    <% } else { %>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
        <h2 class="d-secao">Lista</h2>
        <p id="mia-matters-count" class="d-stat">
          <b><%= fromItem %>–<%= toItem %></b> de <span id="mia-visible-count"><%= pag.total %></span> matéria(s)<%= q ? ' encontrada(s)' : '' %>
        </p>
      </div>

      <% if (selecionavel) { %>
        <div id="mia-bulk-bar" class="matters-bulk d-card mt-3">
          <label class="inline-flex cursor-pointer items-center gap-2 text-xs" style="color: var(--d-texto-2)">
            <input type="checkbox" id="mia-select-all" class="h-3.5 w-3.5 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500/40" />
            <span>Selecionar todas nesta página</span>
          </label>
          <span id="mia-selected-count" class="d-stat">0 selecionada(s)</span>
          <div class="ml-auto flex flex-wrap items-center gap-1.5">
            <button type="button" id="mia-bulk-publicar" disabled
              class="d-btn d-btn--principal disabled:cursor-not-allowed disabled:opacity-40">
              Publicar agora
            </button>
            <button type="button" id="mia-bulk-agendar" disabled
              class="d-btn d-btn--neutro disabled:cursor-not-allowed disabled:opacity-40">
              Agendar
            </button>
            <% if (activeStatus === 'rascunho') { %>
            <button type="button" id="mia-bulk-delete" disabled
              class="d-btn d-btn--neutro d-btn--perigo disabled:cursor-not-allowed disabled:opacity-40">
              Excluir selecionadas
            </button>
            <% } %>
            <% if (activeStatus === 'rascunho' && pag.total > 0) { %>
              <button type="button" id="mia-bulk-delete-all"
                class="d-btn d-btn--fantasma d-btn--perigo"
                data-total="<%= pag.total %>"
                title="Apaga todos os rascunhos, inclusive das outras páginas">
                Excluir todos (<%= pag.total %>)
              </button>
            <% } %>
          </div>
        </div>
      <% } %>

      <ul id="mia-matters-list" class="mia-matters-list d-card mt-3 <%= selecionavel ? 'is-select' : '' %>">
        <li class="mia-matters-head" aria-hidden="true">
          <% if (selecionavel) { %><span></span><% } %>
          <span></span>
          <span>Matéria</span>
          <span>Quando</span>
          <span class="text-right">Ações</span>
        </li>
        <% mattersList.forEach((item) => {
          const st = item.status || 'rascunho';
          const thumbUrl = artThumbUrl(item);
          const viewsLabel = formatViews(item.pub_fb_views);
          const likesLabel = formatViews(item.pub_fb_likes);
          const commentsLabel = formatViews(item.pub_fb_comments);
          const sharesLabel = formatViews(item.pub_fb_shares);
          const isPub = st === 'publicado' || item.publication_id;
          const viral = isPub
            ? viralBadge(item.pub_fb_likes, item.pub_fb_comments, item.pub_fb_shares, item.pub_fb_views)
            : null;
          const hasImg = Boolean(thumbUrl);
          const whenValue = st === 'agendado' && item.scheduled_at
            ? item.scheduled_at
            : (isPub ? (item.published_at || item.pub_published_at || item.updated_at) : item.created_at);
          const whenLabel = st === 'agendado' && item.scheduled_at
            ? 'Agendada'
            : (isPub ? 'Publicada' : 'Criada');
          const whenCls = st === 'agendado' && item.scheduled_at
            ? 'text-amber-300/90'
            : (isPub ? 'text-emerald-300/90' : 'text-slate-500');
        %>
          <li class="mia-matter-row group"
            data-id="<%= item.id %>"
            data-status="<%= st %>">
            <% if (selecionavel) { %>
              <label class="flex shrink-0 cursor-pointer items-center justify-center">
                <input type="checkbox"
                  class="mia-matter-check h-3.5 w-3.5 rounded border-slate-600 bg-slate-800 text-emerald-500 focus:ring-emerald-500/40"
                  value="<%= item.id %>"
                  data-id="<%= item.id %>"
                  aria-label="Selecionar matéria" />
              </label>
            <% } %>
            <a href="/materias-ia/<%= item.id %>"
              class="mia-matter-thumb flex shrink-0 items-center justify-center overflow-hidden"
              title="Abrir matéria">
              <% if (thumbUrl) { %>
                <img src="<%= thumbUrl %>" alt="" loading="lazy"
                  class="h-full w-full object-cover transition duration-150 group-hover:scale-[1.03]" />
              <% } else { %>
                <span class="px-1 text-center text-[9px] leading-tight">sem arte</span>
              <% } %>
            </a>
            <div class="min-w-0">
              <div class="flex min-w-0 flex-wrap items-center gap-1.5">
                <span class="mia-matter-status shrink-0 rounded px-1.5 py-0.5 text-[9px] font-medium uppercase <%= statusClass[st] || statusClass.rascunho %>"><%= statusLabels[st] || st %></span>
                <% if (viral) { %>
                  <span class="mia-viral-badge shrink-0 rounded px-1.5 py-0.5 text-[9px] font-semibold uppercase ring-1 <%= viral.cls %>"><%= viral.label %></span>
                <% } %>
                <% if (activeStatus === 'viralizou' && viral) { %>
                  <span class="mia-viral-score shrink-0 text-[9px] tabular-nums text-slate-500" title="Pontuação ponderada de engajamento">score <%= Math.round(viral.score) %></span>
                <% } %>
                <a href="/materias-ia/<%= item.id %>" class="mia-matter-title">
                  <%= item.titulo || 'Sem título' %>
                </a>
              </div>
              <div class="mia-when-mobile mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[10px]">
                <% if (item.page_name) { %>
                  <span class="truncate"><%= item.page_name %></span>
                <% } %>
                <% if (whenValue) { %>
                  <span class="font-medium <%= whenCls %>"><%= whenLabel %>: <%= formatQuandoCurto(whenValue) %></span>
                <% } %>
              </div>
              <% if (isPub) { %>
                <button type="button"
                  class="mia-matter-views mia-matter-metrics mt-0.5 text-[10px] text-slate-400 hover:text-sky-300"
                  data-id="<%= item.id %>"
                  title="Atualizar engajamento no Facebook (curtidas, comentários, views)">
                  <span class="mia-likes-label"><%= likesLabel != null ? likesLabel + ' curtidas' : 'curtidas' %></span>
                  <span class="text-slate-600">·</span>
                  <span class="mia-comments-label"><%= commentsLabel != null ? commentsLabel + ' coment.' : 'coment.' %></span>
                  <span class="text-slate-600">·</span>
                  <span class="mia-shares-label"><%= sharesLabel != null ? sharesLabel + ' compart.' : 'compart.' %></span>
                  <span class="text-slate-600">·</span>
                  <span class="mia-views-label"><%= viewsLabel != null ? viewsLabel + ' views' : 'views' %></span>
                  <span class="text-[9px] text-sky-400/80">↻</span>
                </button>
              <% } %>
            </div>
            <div class="mia-matter-when">
              <% if (whenValue) { %>
                <span class="font-medium tabular-nums <%= whenCls %>"><%= whenLabel %> · <%= formatQuandoCurto(whenValue) %></span>
              <% } else { %>
                <span>—</span>
              <% } %>
              <% if (item.page_name) { %>
                <span class="mia-matter-page"><%= item.page_name %></span>
              <% } %>
            </div>
            <div class="mia-matter-actions">
              <button type="button" class="mia-matter-menu-btn" aria-haspopup="menu" aria-expanded="false">
                Ações
                <svg class="h-3 w-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div class="mia-matter-menu" role="menu">
                <a href="/materias-ia/<%= item.id %>" role="menuitem">Editar</a>
                <% if (hasImg) { %>
                  <button type="button" role="menuitem"
                    class="mia-matter-reel"
                    data-id="<%= item.id %>"
                    data-titulo="<%= item.titulo || 'Sem título' %>"
                    data-has-video="<%= item.video_path ? '1' : '0' %>">
                    Gerar Reel
                  </button>
                <% } %>
                <button type="button" role="menuitem"
                  class="mia-matter-variacao"
                  data-id="<%= item.id %>"
                  data-titulo="<%= item.titulo || 'Sem título' %>">
                  Nova variação
                </button>
                <button type="button" role="menuitem"
                  class="mia-matter-remove"
                  data-id="<%= item.id %>"
                  data-titulo="<%= item.titulo || 'Sem título' %>">
                  Remover
                </button>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>

      <% if (pag.totalPages > 1) { %>
        <nav class="matters-pagination mt-4" aria-label="Paginação">
          <p class="d-stat">Página <b><%= pag.page %></b> de <%= pag.totalPages %></p>
          <div class="flex flex-wrap items-center gap-1.5">
            <% if (pag.page > 1) { %>
              <a href="<%= listHref({ page: pag.page - 1 }) %>"
                class="d-btn d-btn--neutro">
                ← Anterior
              </a>
            <% } else { %>
              <span class="d-btn d-btn--fantasma opacity-40">← Anterior</span>
            <% } %>

            <% pages.forEach((p) => { %>
              <% if (p === pag.page) { %>
                <span class="matters-page-number is-active"><%= p %></span>
              <% } else { %>
                <a href="<%= listHref({ page: p }) %>"
                  class="matters-page-number"><%= p %></a>
              <% } %>
            <% }) %>

            <% if (pag.page < pag.totalPages) { %>
              <a href="<%= listHref({ page: pag.page + 1 }) %>"
                class="d-btn d-btn--neutro">
                Próxima →
              </a>
            <% } else { %>
              <span class="d-btn d-btn--fantasma opacity-40">Próxima →</span>
            <% } %>
          </div>
        </nav>
      <% } %>
    <% } %>
  </main>

  <% if (selecionavel && mattersList.length) { %>
    <!-- Publicar agora / agendar as matérias selecionadas -->
    <div id="mm-lote" class="mm-lote-fundo" hidden>
      <div class="mm-lote" role="dialog" aria-modal="true" aria-labelledby="mm-lote-titulo">
        <h3 id="mm-lote-titulo">Agendar</h3>
        <p id="mm-lote-resumo" class="mm-lote-resumo"></p>

        <label class="mm-lote-rotulo" for="mm-lote-pagina">Publicar em</label>
        <select id="mm-lote-pagina" class="mm-lote-campo"><option value="">Carregando páginas…</option></select>

        <div id="mm-lote-inicio-bloco">
          <label class="mm-lote-rotulo" for="mm-lote-inicio">Começar em (horário de Brasília)</label>
          <input id="mm-lote-inicio" type="datetime-local" class="mm-lote-campo" step="300" />
        </div>

        <label class="mm-lote-rotulo" for="mm-lote-intervalo" id="mm-lote-intervalo-rotulo">Uma a cada</label>
        <select id="mm-lote-intervalo" class="mm-lote-campo"></select>

        <ul id="mm-lote-horarios" class="mm-lote-horarios"></ul>
        <p id="mm-lote-erro" class="mm-lote-erro" role="alert" hidden></p>

        <div class="mm-lote-acoes">
          <button type="button" class="d-btn d-btn--fantasma" data-lote="cancelar">Cancelar</button>
          <button type="button" class="d-btn d-btn--principal" data-lote="confirmar" id="mm-lote-confirmar">Agendar</button>
        </div>
      </div>
    </div>
    <style>
