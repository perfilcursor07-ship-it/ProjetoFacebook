  <script>
    (function () {
      var topo = document.getElementById('lp-topo');
      var alternar = document.getElementById('lp-alternar');
      var menuMobile = document.getElementById('lp-menu-mobile');

      function fecharMenu() {
        if (!topo || !topo.classList.contains('is-aberto')) return;
        topo.classList.remove('is-aberto');
        if (alternar) alternar.setAttribute('aria-expanded', 'false');
      }

      if (alternar) {
        alternar.addEventListener('click', function () {
          var aberto = topo.classList.toggle('is-aberto');
          alternar.setAttribute('aria-expanded', aberto ? 'true' : 'false');
          alternar.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
        });
      }

      // Fecha ao escolher uma seção, para o destino não ficar escondido atrás do menu.
      if (menuMobile) {
        menuMobile.addEventListener('click', function (evento) {
          if (evento.target.closest('a')) fecharMenu();
        });
      }

      document.addEventListener('keydown', function (evento) {
        if (evento.key === 'Escape') fecharMenu();
      });

      // Sombra do cabeçalho só depois de rolar a página.
      function aoRolar() {
        if (!topo) return;
        topo.classList.toggle('is-fixo', window.scrollY > 8);
      }
      aoRolar();
      window.addEventListener('scroll', aoRolar, { passive: true });

      // Revelação progressiva; sem IntersectionObserver, tudo aparece de uma vez.
      var alvos = document.querySelectorAll('[data-revelar]');
      var semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!('IntersectionObserver' in window) || semMovimento) {
        Array.prototype.forEach.call(alvos, function (el) { el.classList.add('is-visivel'); });
        return;
      }

      var observador = new IntersectionObserver(function (entradas) {
        entradas.forEach(function (entrada) {
          if (!entrada.isIntersecting) return;
          entrada.target.classList.add('is-visivel');
          observador.unobserve(entrada.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.06 });

      Array.prototype.forEach.call(alvos, function (el) { observador.observe(el); });
    })();
  </script>
