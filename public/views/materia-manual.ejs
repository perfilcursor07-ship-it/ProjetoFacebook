<%- include('partials/app-start') %>
  <link rel="stylesheet" href="/css/materia-chat.css?v=20261001selecao1" />
  <link rel="stylesheet" href="/css/materia-manual.css?v=20261001chips1" />
  <link rel="stylesheet" href="/css/feed-sugerido.css?v=20260927feed4" />

  <main class="mia-chat mia-manual-claude" data-recolher-menu>
    <div id="chat-drawer-backdrop" class="mia-chat-drawer-backdrop" hidden aria-hidden="true"></div>

    <div id="mia-manual" class="mia-chat-shell mia-panel">
      <!-- Sidebar de conversas (drawer no mobile) -->
      <aside id="chat-sidebar" class="mia-chat-sidebar">
        <div class="mia-chat-sidebar-head">
          <p class="mia-chat-sidebar-head-title">Seu espaço de escrita</p>
          <button type="button" id="chat-drawer-close" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Fechar conversas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <button type="button" id="chat-nova" class="mia-chat-new">
          <svg class="mia-chat-new-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Nova matéria
        </button>
        <label class="mia-chat-search">
          <span class="sr-only">Buscar conversa</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
          <input id="chat-busca" type="search" placeholder="Buscar conversas…" autocomplete="off" />
        </label>
        <div class="mia-chat-sidebar-row">
          <p class="mia-chat-sidebar-label">Conversas</p>
          <button type="button" id="chat-selecionar" class="mia-chat-select-toggle" aria-pressed="false">Selecionar</button>
        </div>
        <div id="chat-selecao" class="mia-chat-select-bar hidden" role="group" aria-label="Excluir conversas selecionadas">
          <button type="button" id="chat-selecao-todas" class="mia-chat-select-all">Selecionar todas</button>
          <button type="button" id="chat-selecao-excluir" class="mia-chat-select-del" disabled>Excluir</button>
        </div>
        <div id="chat-lista" class="mia-chat-list">
          <p class="mia-chat-list-empty">Carregando…</p>
        </div>
        <div class="mia-chat-sidebar-foot">
          <a href="/minhas-materias" class="mia-chat-foot-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Matérias salvas
          </a>
          <a href="/conteudo" class="mia-chat-foot-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v18M3 12h18"/></svg>
            Criar conteúdo
          </a>
        </div>
      </aside>

      <!-- Thread + composer -->
      <section class="mia-chat-main">
        <header class="mia-chat-header">
          <button type="button" id="chat-drawer-open" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Abrir conversas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h10"/>
            </svg>
          </button>
          <div class="mia-chat-header-title">
            <span>ViralizeAI · Escrita</span>
            <p id="chat-titulo" class="truncate">Nova conversa</p>
          </div>
          <div class="mia-chat-header-actions">
            <button type="button" class="mia-furos-open mia-furos-header-btn" aria-haspopup="dialog" aria-controls="furos-dialog" title="Furos do dia: notícias mais quentes por nicho">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22c4 0 7-3 7-7 0-3-1.5-5.5-4-8-1 3-2.5 4-4 5 0-4-2-7-4-9 0 4-3 6-3 11 0 4.5 3.5 8 8 8Z"/></svg>
              <span>Furos do dia</span>
            </button>
            <a id="piloto-chip" href="/piloto-automatico" class="mia-piloto-chip" hidden title="Piloto automático do Furos do dia"></a>
            <button type="button" id="chat-nova-top" class="mia-chat-icon-btn mia-chat-mobile-only" aria-label="Nova matéria">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
            <button type="button" id="chat-renomear" class="mia-chat-icon-btn hidden" title="Renomear conversa" aria-label="Renomear conversa">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
            </button>
          </div>
        </header>

        <div id="chat-mensagens" class="mia-chat-messages">
          <div id="chat-vazio" class="mia-chat-empty">
            <div class="mia-chat-empty-copy">
              <span class="mia-chat-empty-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8Z"/></svg>
              </span>
              <span class="mia-chat-empty-eyebrow">Redação com IA</span>
              <h1 class="mia-chat-empty-title">Sua próxima matéria <em>começa aqui.</em></h1>
              <p class="mia-chat-empty-sub">Cole um link, conte uma ideia ou envie um arquivo. A IA ajuda a pesquisar, escrever e revisar.</p>
            </div>
            <div class="mia-start-actions" aria-label="Como começar sua matéria">
              <button type="button" class="mia-furos-open mia-start-featured" aria-haspopup="dialog" aria-controls="furos-dialog">
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c4 0 7-3 7-7 0-3-1.5-5.5-4-8-1 3-2.5 4-4 5 0-4-2-7-4-9 0 4-3 6-3 11 0 4.5 3.5 8 8 8Z"/></svg></span>
                <strong>Furos do dia</strong><small>O que está bombando no Google News, YouTube, Instagram e Facebook no seu nicho vira várias matérias prontas para o Facebook</small>
              </button>
              <button type="button" data-start-matter="link">
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></span>
                <strong>Criar de um link</strong><small>Transforme uma notícia em matéria</small>
              </button>
              <button type="button" data-start-matter="tema">
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></span>
                <strong>Escrever sobre um tema</strong><small>Comece com uma ideia ou fatos</small>
              </button>
              <button type="button" data-start-matter="video">
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="m10 9 5 3-5 3Z"/></svg></span>
                <strong>Usar um vídeo</strong><small>Cole o link para extrair o conteúdo</small>
              </button>
              <button type="button" data-start-matter="pautas" aria-controls="chat-radar-options" aria-expanded="false">
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-9"/><path d="M15 6h6v6"/></svg></span>
                <strong>Descobrir pautas</strong><small>Encontre seu próximo assunto</small>
              </button>
              <button type="button" class="mia-start-feed" data-feed-sugerido-open hidden>
                <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="m10.5 9.5 4 2.5-4 2.5Z"/></svg></span>
                <strong>Vídeos sugeridos</strong><small>Reels, Shorts e vídeos que as redes sugerem viram matérias</small>
              </button>
            </div>
            <section id="chat-radar-options" class="mia-chat-radar-start" aria-labelledby="chat-radar-start-title" hidden>
              <div class="mia-chat-radar-start-head">
                <div>
                  <p class="mia-chat-radar-start-eyebrow">Radar de pautas</p>
                  <h2 id="chat-radar-start-title">Descubra o que pode virar matéria agora</h2>
                </div>
                <span class="mia-chat-radar-start-live"><i aria-hidden="true"></i> Atualizado ao buscar</span>
              </div>
              <div class="mia-chat-radar-start-grid">
                <button type="button" id="chat-radar-alta" class="mia-chat-radar-start-card">
                  <span class="mia-chat-radar-start-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-6 4 4 8-9"/><path d="M15 6h6v6"/></svg>
                  </span>
                  <span><strong>Google + redes</strong><small>Buscas crescendo, notícias e posts recentes</small></span>
                </button>
                <button type="button" id="chat-radar-publico" class="mia-chat-radar-start-card">
                  <span class="mia-chat-radar-start-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"/><path d="M16 3.2a4 4 0 0 1 0 7.6M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
                  </span>
                  <span><strong>Para meu público</strong><small>Pautas parecidas com o que mais engajou</small></span>
                </button>
                <button type="button" id="chat-radar-mais-lidas" class="mia-chat-radar-start-card">
                  <span class="mia-chat-radar-start-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/><path d="M9 7h7M9 11h7"/></svg>
                  </span>
                  <span><strong>Mais lidas</strong><small>Rankings dos portais cadastrados</small></span>
                </button>
              </div>
              <p class="mia-chat-radar-start-help">Escolha uma pauta para a IA pesquisar e escrever, ou marque várias para gerar em lote.</p>
            </section>
            <details class="mia-chat-title-tone">
              <summary id="chat-title-tone-label" class="mia-chat-title-tone-label">Personalizar o tom da escrita</summary>
              <p class="mia-chat-title-tone-help">Escolha como os títulos serão sugeridos nesta conversa.</p>
              <div class="mia-chat-title-tone-options" role="group" aria-label="Tom dos títulos sugeridos">
                <button type="button" class="chat-title-tone is-active" data-title-tone="natural" aria-pressed="true">Natural</button>
                <button type="button" class="chat-title-tone" data-title-tone="polemico" aria-pressed="false">Suspense e polêmica</button>
                <button type="button" class="chat-title-tone" data-title-tone="factual" aria-pressed="false">Factual</button>
                <button type="button" class="chat-title-tone" data-title-tone="direto" aria-pressed="false">Direto</button>
                <button type="button" class="chat-title-tone" data-title-tone="emocional" aria-pressed="false">Emocional</button>
                <button type="button" class="chat-title-tone" data-title-tone="curiosidade" aria-pressed="false">Curiosidade</button>
              </div>
            </details>
          </div>
        </div>

        <div class="mia-chat-composer-wrap">
          <div class="mia-chat-composer" id="chat-composer">
            <textarea id="chat-input" rows="1"
              placeholder="Como posso ajudar? Escreva uma ideia ou cole um link…"
              aria-label="Mensagem para a IA"
              class="mia-chat-input"></textarea>
            <span id="chat-links-detectados" class="mia-chat-links-hint hidden"></span>
            <div id="chat-video-options" class="mia-video-options" hidden>
              <label for="chat-video-count">Quantas matérias quer criar deste conteúdo?</label>
              <select id="chat-video-count">
                <option value="1">Uma matéria</option>
                <option value="2">Até 2 matérias</option>
                <option value="3">Até 3 matérias</option>
                <option value="4">Até 4 matérias</option>
                <option value="5">Até 5 matérias</option>
              </select>
              <small>A IA separa assuntos diferentes quando houver conteúdo suficiente. Links de posts também são aceitos.</small>
            </div>

            <div class="mia-chat-toolbar">
              <div class="mia-chat-toolbar-main">
                <details class="mia-chat-more" id="chat-ferramentas">
                  <summary title="Ferramentas" aria-label="Abrir ferramentas">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <div class="mia-chat-more-menu">
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Pauta</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" class="chat-exemplo mia-chat-menu-item" data-modo-exemplo="pautas" title="Pautas gospel da semana">
                          <span class="mia-chat-menu-item-title">Buscar</span>
                          <span class="mia-chat-prompt-text">Pautas gospel da semana</span>
                        </button>
                      </div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Exemplos</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Católicos e evangélicos na política em 2026">
                          <span class="mia-chat-menu-item-title">Texto</span>
                          <span class="mia-chat-prompt-text">Católicos e evangélicos na política em 2026</span>
                        </button>
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Crescimento das igrejas">
                          <span class="mia-chat-menu-item-title">Texto</span>
                          <span class="mia-chat-prompt-text">Crescimento das igrejas</span>
                        </button>
                      </div>
                    </section>

                    <!-- Anexos e atalhos de pauta entram por materia-chat-extras.js.
                         A seção some sozinha quando o script não preenche nada. -->
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Anexar</p>
                      <div class="mia-chat-menu-grid" id="chat-menu-anexos"></div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Descobrir</p>
                      <div class="mia-chat-menu-grid" id="chat-menu-descobrir"></div>
                    </section>

                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Ajustes</p>
                      <div class="mia-chat-tools">
                        <button type="button" id="chat-toggle-transcricao" aria-pressed="true"
                          title="Primeiro usa a transcrição disponibilizada pela plataforma. Se não houver, processa somente o áudio."
                          class="mia-chat-chip is-on">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 7v10"/><path d="M20 10v4"/>
                          </svg>
                          Áudio auto
                        </button>

                        <label class="mia-chat-tool-field">
                          <span>Período da busca</span>
                          <select id="chat-periodo" title="Período da busca" class="mia-chat-select">
                            <option value="24h">24h</option>
                            <option value="3d">3 dias</option>
                            <option value="7d">7 dias</option>
                            <option value="15d">15 dias</option>
                            <option value="30d" selected>30 dias</option>
                            <option value="60d">60 dias</option>
                            <option value="90d">90 dias</option>
                            <option value="180d">180 dias</option>
                          </select>
                        </label>

                        <label class="mia-chat-tool-field">
                          <span>Tom dos títulos</span>
                          <select id="chat-tom" title="Tom dos títulos sugeridos pelo Claude" class="mia-chat-select">
                            <option value="natural" selected>Natural</option>
                            <option value="polemico">Suspense e polêmica</option>
                            <option value="direto">Direto</option>
                            <option value="curiosidade">Curiosidade</option>
                            <option value="emocional">Emocional</option>
                            <option value="factual">Factual</option>
                          </select>
                        </label>
                      </div>
                    </section>
                  </div>
                </details>

                <div class="mia-chat-seg" id="chat-tipo-seg" role="group" aria-label="Tipo de conversa">
                  <button type="button" data-chat-tipo="livre" aria-pressed="false"
                    title="Conversa normal com o Claude, sem critérios editoriais"
                    class="chat-tipo-btn mia-chat-seg-btn">Conversar</button>
                  <button type="button" data-chat-tipo="materia" aria-pressed="true"
                    title="Cria matérias usando as regras editoriais do sistema"
                    class="chat-tipo-btn mia-chat-seg-btn is-active">Criar matéria</button>
                </div>
                <div class="mia-chat-seg" id="chat-modo-seg" role="group" aria-label="O que a IA deve fazer">
                  <button type="button" data-chat-modo="escrever" aria-pressed="true"
                    title="A IA já escreve a matéria com o que você pedir"
                    class="chat-modo-btn mia-chat-seg-btn is-active">Texto</button>
                  <button type="button" data-chat-modo="pautas" aria-pressed="false"
                    title="A IA pesquisa o tema e lista as matérias publicadas para você escolher"
                    class="chat-modo-btn mia-chat-seg-btn">Pauta</button>
                </div>
                <button type="button" id="chat-toggle-web" aria-pressed="false"
                  title="Desligado: extrai o link e escreve sem verificar. Ligado: pesquisa outras fontes, verifica os fatos e revisa."
                  class="mia-chat-chip mia-chat-web-toggle">
                  <span class="mia-chat-chip-dot"></span>
                  <span id="chat-toggle-web-label">Pesquisar fontes</span>
                </button>
                <div class="mia-chat-model">
                  <button type="button" id="chat-ai-model" class="mia-chat-model-pill" title="Modelo de IA em uso nesta conversa"
                    aria-haspopup="listbox" aria-expanded="false" aria-controls="chat-ai-model-menu">
                    <span id="chat-ai-model-name">IA</span>
                    <span id="chat-ai-model-level">—</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </button>
                  <div id="chat-ai-model-menu" class="mia-chat-model-menu" role="listbox" aria-label="Modelo para escrever" hidden></div>
                </div>
              </div>

              <span id="chat-status" class="mia-chat-status" aria-live="polite"></span>

              <div class="mia-chat-send-row">
                <button type="button" id="chat-parar" class="mia-chat-stop hidden">Parar</button>
                <details class="mia-chat-more mia-chat-more--criar" id="chat-criar">
                  <summary title="Criar" aria-label="Criar matéria">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </summary>
                  <div class="mia-chat-more-menu">
                    <section class="mia-chat-menu-sec">
                      <p class="mia-chat-menu-label">Criar</p>
                      <div class="mia-chat-menu-list">
                        <button type="button" id="chat-criar-manual" class="mia-chat-menu-item" title="Escrever minha própria matéria">
                          <span class="mia-chat-menu-item-title">Manual</span>
                          <span class="mia-chat-prompt-text">Escrever minha própria matéria</span>
                        </button>
                        <button type="button" class="chat-exemplo mia-chat-menu-item" title="Matéria deste link">
                          <span class="mia-chat-menu-item-title">Link</span>
                          <span class="mia-chat-prompt-text">Matéria deste link</span>
                        </button>
                        <button type="button" id="chat-varios-links" class="chat-varios-links mia-chat-menu-item" title="Cole até 12 links, um por linha">
                          <span class="mia-chat-menu-item-title">Links</span>
                          <span class="mia-chat-prompt-text">Criar uma matéria por link</span>
                        </button>
                        <button type="button" class="mia-chat-menu-item" data-feed-sugerido-open hidden title="Matérias a partir dos vídeos sugeridos pelas redes">
                          <span class="mia-chat-menu-item-title">Feed</span>
                          <span class="mia-chat-prompt-text">Vídeos sugeridos das redes</span>
                        </button>
                      </div>
                    </section>
                  </div>
                </details>
                <button type="button" id="chat-voz" class="mia-chat-voice" title="Gravar áudio para escrever" aria-label="Gravar áudio para escrever" aria-pressed="false">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <path d="M12 19v3"/>
                    <path d="M8 22h8"/>
                  </svg>
                </button>
                <button type="button" id="chat-enviar" class="mia-chat-send" title="Enviar (Enter)" aria-label="Enviar">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 19V5m-6 6 6-6 6 6"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <p class="mia-chat-hint">Enter envia · Shift+Enter quebra linha</p>
        </div>

        <div id="chat-manual-backdrop" class="mia-manual-backdrop hidden" hidden></div>
