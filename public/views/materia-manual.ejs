              <label class="feed-sug-check"><input id="feed-sugerido-todos" type="checkbox" /><span>Marcar todos</span></label>
              <button type="button" id="feed-sugerido-escrever" class="feed-sug-primary" disabled>Escrever matérias dos marcados</button>
            </div>
            <ol id="feed-sugerido-itens" class="feed-sug-itens"></ol>
