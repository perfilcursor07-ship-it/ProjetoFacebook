<%- include('partials/app-start') %>
<%
  const statusLabels = {
    rascunho: 'Rascunho',
    pronto: 'Pronta',
    agendado: 'Agendada',
    publicado: 'Publicada',
    erro: 'Erro',
  };
  const statusClass = {
    rascunho: 'bg-slate-700 text-slate-200',
    pronto: 'bg-sky-500/20 text-sky-300',
    agendado: 'bg-amber-500/20 text-amber-300',
    publicado: 'bg-emerald-500/20 text-emerald-300',
    erro: 'bg-rose-500/20 text-rose-300',
  };
  const st = matter.status || 'rascunho';
  const canEdit = st !== 'publicado';
  const canRepublish = st === 'publicado';
  const isReel = matter.tipo_publicacao === 'reel';
  const imageUrl = matter.imagem_url || '';
  const imagemFonteUrl = String(matter.imagem_fonte_url || '').trim();
  const videoUrl = matter.video_path ? '/media/' + String(matter.video_path).replace(/^\/+/, '') : '';
  const reelProcessing = isReel && (!videoUrl || String(matter.materia || '').startsWith('⏳'));
  const canReloadBrand =
    !isReel &&
    (Boolean(imagemFonteUrl) ||
      (!matter.imagem_path && /^https?:\/\//i.test(String(imageUrl))));
  const fonteUrl = String(matter.fonte_url || '').trim();
  const fonteTitulo = String(matter.fonte_titulo || '').trim();
  const fontesLinks = Array.isArray(matter.fontes_links) ? matter.fontes_links : [];
  const hashtagsList = hashtags && hashtags.length
    ? hashtags.map((h) => '#' + String(h).replace(/^#/, '')).join(' ')
    : '';
  const canGerarReelNarrado =
    Boolean(matter.imagem_path) ||
    /^https?:\/\//i.test(String(imageUrl || '')) ||
    /^https?:\/\//i.test(String(imagemFonteUrl || ''));
%>

  <main class="mx-auto max-w-9xl px-3 py-3 sm:px-5 sm:py-4">
    <% if (success) { %><div class="mb-3 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200"><%= success %></div><% } %>
    <% if (error) { %><div class="mb-3 rounded-lg border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-200"><%= error %></div><% } %>
    <p id="matter-status" class="mb-2 hidden text-sm text-slate-400 empty:hidden"></p>

    <!-- Barra estilo WP: voltar + status + ações -->
    <div class="sticky top-0 z-20 -mx-3 mb-3 flex flex-wrap items-center gap-2 border-b border-slate-800 bg-slate-950/95 px-3 py-2 backdrop-blur sm:-mx-5 sm:px-5 md:top-0">
      <a href="/minhas-materias" class="text-xs text-slate-500 hover:text-emerald-300">← Matérias</a>
      <span class="hidden text-slate-700 sm:inline">|</span>
      <h1 class="text-sm font-semibold text-white">Editar post</h1>
      <span class="rounded px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide <%= statusClass[st] || statusClass.rascunho %>"><%= statusLabels[st] || st %></span>
      <div class="ml-auto flex flex-wrap items-center gap-1.5">
        <button type="button" id="btn-limpar-nova-materia"
          class="rounded border border-slate-800 px-2.5 py-1.5 text-[11px] text-slate-400 hover:border-slate-500 hover:text-slate-200"
          title="Começar outra matéria a partir de um novo link">
          Novo
        </button>
        <% if (canEdit) { %>
          <button type="button" id="btn-publicar"
            class="rounded bg-emerald-500 px-3 py-1.5 text-[11px] font-semibold text-slate-950 hover:bg-emerald-400 sm:text-xs"
            <%= reelProcessing ? 'disabled' : '' %>>
            <%= isReel ? 'Publicar Reel' : 'Publicar' %>
          </button>
          <button type="button" id="btn-salvar"
            class="rounded border border-slate-600 bg-slate-800 px-3 py-1.5 text-[11px] font-semibold text-slate-100 hover:bg-slate-700 sm:text-xs">
            Salvar
          </button>
        <% } else if (canRepublish) { %>
          <button type="button" id="btn-publicar" data-republicar="1"
            class="rounded bg-emerald-500 px-3 py-1.5 text-[11px] font-semibold text-slate-950 hover:bg-emerald-400 sm:text-xs">
            Republicar
          </button>
        <% } %>
      </div>
    </div>

    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_280px] xl:grid-cols-[minmax(0,1fr)_300px]">
      <!-- Coluna principal: documento -->
      <div class="min-w-0 space-y-3">
        <!-- Nova matéria a partir do link -->
        <div id="matter-nova-link" class="hidden rounded-lg border border-slate-800 bg-slate-900 p-4 space-y-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-400/80">Nova matéria a partir do link</p>
            <p class="mt-1 text-xs text-slate-400">Cole o próximo link. A matéria atual permanece salva.</p>
          </div>
          <label class="block text-sm">
            <span class="text-slate-400">Link (foto do Facebook, notícia ou Reel)</span>
            <input id="matter-nova-link-url" type="url" inputmode="url"
              placeholder="https://…"
              class="mt-1 w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm text-slate-100 focus:border-emerald-500 focus:outline-none" />
          </label>
          <details class="rounded border border-amber-500/25 bg-amber-500/5">
            <summary class="cursor-pointer px-3 py-2 text-xs font-medium text-amber-100 hover:text-white">
              Se o Facebook bloquear a leitura — cole a legenda aqui
            </summary>
            <div class="space-y-2 border-t border-amber-500/20 px-3 py-3">
              <textarea id="matter-nova-link-texto" rows="3" placeholder="Cole a legenda completa do post…"
                class="w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none"></textarea>
              <input id="matter-nova-link-imagem" type="url" placeholder="URL da imagem (opcional)"
                class="w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none" />
            </div>
          </details>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="block text-xs">
              <span class="text-slate-400">Tipo de publicação</span>
              <select id="matter-nova-link-tipo" class="mt-1 w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm text-slate-100">
                <option value="foto" selected>Foto + legenda</option>
                <option value="auto">Automático (detecta Reel)</option>
                <option value="texto">Texto</option>
                <option value="reel">Reel (vídeo)</option>
              </select>
            </label>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="btn-gerar-nova-link"
              class="rounded bg-emerald-500 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-emerald-400">
              Gerar a partir do link
            </button>
            <button type="button" id="btn-cancelar-nova-link"
              class="rounded border border-slate-600 px-3 py-2 text-xs text-slate-300 hover:border-slate-400">
              Voltar à matéria
            </button>
          </div>
          <p id="matter-nova-link-status" class="text-xs text-slate-400"></p>
        </div>

        <div id="matter-edit-atual" class="space-y-3">
          <!-- Documento estilo WP -->
          <article class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900/40 shadow-sm">
            <!-- Título grande (estilo WP) -->
            <div class="border-b border-slate-800 px-4 pt-4 sm:px-6 sm:pt-5">
              <input id="matter-titulo" <%= canEdit ? '' : 'readonly' %> value="<%= matter.titulo || '' %>"
                placeholder="Adicionar título"
                class="w-full border-0 bg-transparent text-xl font-semibold leading-snug text-white placeholder:text-slate-600 focus:outline-none focus:ring-0 sm:text-2xl <%= canEdit ? '' : 'opacity-80' %>" />
              <% if (typeof marcaModeloArte !== 'undefined' && (marcaModeloArte === 'urgente_alerta' || (typeof artModelChoices !== 'undefined' && artModelChoices.some((m) => m.id === 'urgente_alerta')))) { %>
                <p class="mt-1.5 pb-1 text-[11px] leading-relaxed text-slate-500">
                  Modelo <span class="text-slate-400">Urgente alerta</span>:
                  use <code class="text-yellow-400/90">[[palavra]]</code> na cor principal e
                  <code class="text-red-400/90">((frase))</code> na faixa vermelha da imagem destacada.
                </p>
            <% } %>
              <% if (typeof marcaModeloArte !== 'undefined' && (marcaModeloArte === 'jm' || (typeof artModelChoices !== 'undefined' && artModelChoices.some((m) => m.id === 'jm')))) { %>
                <p class="mt-1.5 pb-1 text-[11px] leading-relaxed text-slate-500">
                  Modelo <span class="text-slate-400">JM</span>:
                  use <code class="text-amber-400/90">[[palavra]]</code> para destacar um trecho na cor principal da marca.
                  Sem marcação, o destaque é escolhido automaticamente.
          </p>
        <% } %>
        <% if (canEdit) { %>
                <div class="mt-2 space-y-2 pb-3">
                  <div class="flex flex-wrap items-center gap-2">
                    <label class="flex items-center gap-1.5 text-[11px] text-slate-500">
                      <span>Tom</span>
                      <select id="matter-titulo-tom" class="rounded border border-slate-600 bg-slate-900 px-2 py-1 text-[11px] text-slate-300 focus:border-emerald-500 focus:outline-none">
                <option value="natural" selected>Natural</option>
                        <option value="polemico">Polêmico (forte)</option>
                <option value="direto">Direto</option>
                <option value="curiosidade">Curiosidade</option>
                <option value="emocional">Emocional</option>
                <option value="factual">Factual</option>
                        <option value="manual">Manual (eu escrevo)</option>
              </select>
            </label>
            <button type="button" id="btn-sugerir-titulo"
                      class="rounded border border-slate-600 px-2 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-sky-300">
                      Sugerir título
                    </button>
                  </div>
                  <%
                    const titulosAlt =
                      typeof titulosAlternativos !== 'undefined' && Array.isArray(titulosAlternativos)
                        ? titulosAlternativos.slice(0, 3)
                        : [];
                  %>
                  <div id="matter-titulos-alt-wrap" class="rounded-lg border border-slate-800 bg-slate-950/40 p-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                        3 títulos alternativos pelo Claude
                      </span>
                      <button type="button" id="btn-titulos-alt"
                        class="rounded border border-slate-600 px-2 py-1 text-[11px] text-slate-300 hover:border-emerald-500 hover:text-sky-300">
                        <%= titulosAlt.length ? 'Gerar outros 3 com Claude' : 'Gerar 3 com Claude' %>
                      </button>
                    </div>
                    <label for="matter-titulos-alt-pedido" class="mt-2 block text-[10px] text-slate-500">
                      Como você quer os títulos? <span class="text-slate-600">Ex.: mais polêmico, com “dispara”, sem perder os fatos.</span>
                    </label>
                    <div class="mt-1 flex gap-1.5">
                      <input id="matter-titulos-alt-pedido" type="text" maxlength="500"
                        placeholder="Descreva o tom ou ângulo que deseja…"
                        class="min-w-0 flex-1 rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-[11px] text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none" />
                    </div>
                    <div id="matter-titulos-alt" class="mt-1.5 grid gap-1.5">
                      <% titulosAlt.forEach(function (t) { %>
                        <button type="button" data-titulo-alt="<%= t %>"
                          class="w-full rounded-md border border-slate-700 px-2.5 py-1.5 text-left text-xs leading-snug text-slate-300 transition hover:border-emerald-500/60 hover:text-white"><%= t %></button>
                      <% }) %>
                    </div>
                    <p class="mt-1.5 text-[11px] text-slate-500 <%= titulosAlt.length ? '' : 'hidden' %>" id="matter-titulos-alt-dica">
                      Clique em um título para aplicá-lo na matéria e na arte.
                    </p>
                  </div>

                  <div id="matter-titulo-manual-wrap" class="hidden">
                    <label for="matter-titulo-manual" class="mb-1 block text-[11px] text-slate-500">
                      Seu rascunho — a IA reescreve mantendo o que você quer
                    </label>
                    <textarea id="matter-titulo-manual" rows="2"
                      placeholder="Cole ou escreva aqui o título do seu jeito…"
                      class="w-full resize-y rounded-lg border border-slate-700 bg-slate-950/80 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none"></textarea>
                  </div>
                </div>
              <% } else { %>
                <div class="pb-3"></div>
              <% } %>
            </div>

            <!-- Corpo / legenda -->
            <div class="px-4 py-3 sm:px-6 sm:py-4">
              <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Conteúdo</span>
                <div class="flex items-center gap-2">
                  <span id="matter-char-count" class="text-[10px] tabular-nums text-slate-500">0</span>
                  <button type="button" id="btn-copiar-legenda"
                    class="rounded border border-slate-600 bg-slate-900/40 px-2 py-0.5 text-[10px] font-medium text-slate-300 hover:border-emerald-500/50 hover:text-emerald-300">
                    Copiar
                  </button>
                </div>
              </div>
              <textarea id="matter-materia" rows="16" <%= canEdit ? '' : 'readonly' %>
                placeholder="Escreva a matéria / legenda…"
                class="min-h-[320px] w-full resize-y border-0 bg-transparent text-[15px] leading-7 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:ring-0 <%= canEdit ? '' : 'opacity-80' %>"><%= matter.materia || '' %></textarea>
              <p class="mt-1 border-t border-slate-800/60 pt-2 text-[10px] leading-snug text-slate-500">Parágrafos com linha em branco · alvo ~1700–2100 caracteres</p>
            </div>
          </article>

          <!-- Metabox: Fonte / crédito -->
          <details class="wp-metabox group rounded-lg border border-slate-800 bg-slate-900/40 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 border-b border-transparent px-3 py-2.5 text-xs font-semibold text-slate-200 group-open:border-slate-800 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
              <span>Fonte / crédito</span>
              <span class="text-slate-600 group-open:rotate-180 transition">▾</span>
            </summary>
            <div class="space-y-2 px-3 py-3">
              <textarea id="matter-fonte-credito" rows="2" <%= canEdit ? '' : 'readonly' %>
                placeholder="Ex.: Fonte: G1&#10;(Foto: Reprodução)"
                class="w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm leading-relaxed text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none <%= canEdit ? '' : 'opacity-80' %>"><%= matter.fonte_credito || '' %></textarea>
              <p class="text-[10px] text-slate-500">Opcional. Se o crédito já estiver no Conteúdo (ex.: Por … — Site: …), deixe este campo vazio para não repetir na postagem.</p>
            </div>
          </details>

          <% if (canEdit) { %>
            <!-- Metabox: Ferramentas IA -->
            <details class="wp-metabox group rounded-lg border border-slate-800 bg-slate-900/40">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 border-b border-transparent px-3 py-2.5 text-xs font-semibold text-slate-200 group-open:border-slate-800 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
                <span>Ferramentas da IA</span>
                <span class="text-slate-600 group-open:rotate-180 transition">▾</span>
              </summary>
              <div class="space-y-3 border-t border-slate-800 px-3 py-3">
                <div class="rounded border border-sky-500/25 bg-sky-500/5 p-3">
                  <p class="text-xs font-medium text-slate-200">Texto manual</p>
                  <p class="mt-0.5 text-[11px] leading-snug text-slate-500">
                    Corrige gramÃ¡tica, clareza e ritmo sem acrescentar fatos novos.
                  </p>
                  <button type="button" id="btn-revisar-texto-manual"
                    class="mt-2 rounded-lg border border-sky-500/40 bg-sky-500/10 px-3 py-1.5 text-[11px] font-semibold text-sky-200 hover:bg-sky-500/20">
                    Corrigir texto com IA
                  </button>
                </div>
                <div class="rounded border border-slate-800/80 bg-slate-900/50 p-3">
                  <p class="text-xs font-medium text-slate-200">Mais fatos na web</p>
                  <p class="mt-0.5 text-[11px] leading-snug text-slate-500">
                    Usa a mesma busca de <strong class="font-medium text-slate-400">Pautas com IA</strong> (Google News + Brave), depois acrescenta só fatos — sem copiar texto.
                  </p>
                  <label class="mt-2.5 block text-[11px] text-slate-400">
                    Palavras-chave da busca
                    <%
                      const kwDefault = String(matter.titulo || '')
                        .replace(/[^\wÀ-ÿ\s]/gi, ' ')
                        .replace(/\s+/g, ' ')
                        .trim()
                        .split(/\s+/)
                        .filter((w) => w.length > 3)
                        .slice(0, 6)
                        .join(' ');
                    %>
                    <input id="matter-enriquecer-keywords" type="text"
                      value="<%= kwDefault %>"
                      placeholder="ex.: pastora PL entregador Minas Gerais"
                      class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2.5 py-1.5 text-sm text-slate-100 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none" />
                  </label>
                  <div class="mt-2 flex flex-wrap items-center gap-2">
                    <label class="text-[11px] text-slate-500">
                      Período
                      <select id="matter-enriquecer-periodo" class="ml-1 rounded border border-slate-700 bg-slate-950 px-2 py-1 text-[11px] text-slate-200">
                        <option value="7d">7 dias</option>
                        <option value="30d">30 dias</option>
                        <option value="90d">90 dias</option>
                        <option value="180d" selected>180 dias</option>
                      </select>
                    </label>
                    <button type="button" id="btn-enriquecer-fontes"
                      class="ml-auto rounded-lg bg-emerald-500 px-3 py-1.5 text-[11px] font-semibold text-slate-950 hover:bg-emerald-400">
                      Buscar e enriquecer
                    </button>
                  </div>
                </div>
                <div id="matter-fontes-enriquecimento" class="hidden rounded border border-slate-800 bg-slate-900/50 px-2.5 py-2 text-[11px] text-slate-400"></div>

                <div>
                  <label class="block text-xs text-slate-400">
                    Informações extras (manual)
                    <textarea id="matter-info-extra" rows="3"
                      placeholder="Cole fatos, nomes, números…"
                      class="mt-1 w-full rounded border border-slate-800 bg-slate-900/50 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-600 focus:border-sky-500 focus:outline-none"></textarea>
                  </label>
                  <button type="button" id="btn-reescrever-info"
                    class="mt-2 rounded border border-sky-500/40 bg-sky-500/10 px-2.5 py-1.5 text-[11px] font-semibold text-sky-200 hover:bg-sky-500/20">
                    Reescrever com informações
            </button>
          </div>
              </div>
            </details>
        <% } %>

          <!-- Metabox: Hashtags -->
          <details class="wp-metabox group rounded-lg border border-slate-800 bg-slate-900/40 <%= hashtagsList ? '' : 'hidden' %>" id="matter-hashtags-wrap">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 border-b border-transparent px-3 py-2.5 text-xs font-semibold text-slate-200 group-open:border-slate-800 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
              <span>Hashtags</span>
              <span class="text-slate-600 group-open:rotate-180 transition">▾</span>
            </summary>
            <div class="border-t border-slate-800 px-3 py-3">
              <p id="matter-hashtags-line" class="text-sm leading-relaxed text-sky-300/90"><%= hashtagsList %></p>
            </div>
          </details>

          <!-- Metabox: Fonte da matéria -->
          <details class="wp-metabox group rounded-lg border border-slate-800 bg-slate-900/40 <%= (fontesLinks.length || fonteTitulo) ? '' : 'hidden' %>" id="matter-fonte-wrap">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 border-b border-transparent px-3 py-2.5 text-xs font-semibold text-slate-200 group-open:border-slate-800 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
              <span><%= fontesLinks.length > 1 ? 'Links das fontes' : 'Link da fonte' %></span>
              <span class="text-slate-600 group-open:rotate-180 transition">▾</span>
            </summary>
            <div class="space-y-1 border-t border-slate-800 px-3 py-3">
              <p class="text-sm text-slate-300" id="matter-fonte-titulo"><%= fonteTitulo %></p>
              <% if (fontesLinks.length) { %>
                <div id="matter-fonte-links" class="space-y-2">
                  <% fontesLinks.forEach((fonte, index) => { %>
                    <div class="rounded border border-slate-800/80 bg-slate-950/40 px-2.5 py-2">
                      <a <%= index === 0 ? 'id="matter-fonte-link"' : '' %> href="<%= fonte.url %>" target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-sm font-medium text-sky-400 hover:underline break-all">
                        <%= fonte.label || 'Abrir fonte' %> →
                      </a>
                      <p class="mt-0.5 text-[10px] text-slate-600 break-all"><%= fonte.url %></p>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <a id="matter-fonte-link" href="#" target="_blank" rel="noopener"
                  class="hidden inline-flex items-center gap-1 text-sm text-sky-400 hover:underline break-all"></a>
              <% } %>
            </div>
          </details>
        </div>
      </div>

      <!-- Sidebar estilo WP -->
      <aside class="space-y-3 lg:sticky lg:top-14 lg:self-start">
        <!-- Publicar (metabox WP) -->
        <%- include('partials/page-distribution', { mode: 'editor', matterId: matter.id }) %>
        <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/40">
          <div class="border-b border-slate-800 px-3 py-2">
            <p class="text-xs font-semibold text-slate-200">Publicar</p>
          </div>
          <div class="space-y-3 px-3 py-3">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-500">Status</span>
              <span class="font-medium text-slate-300"><%= statusLabels[st] || st %></span>
            </div>

            <details class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-950/30">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-2.5 py-2 text-[11px] font-medium text-slate-300 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
                <span>
                  Canais e formato
                  <span class="mt-0.5 block text-[10px] font-normal text-slate-500">Facebook, Instagram, X.com e tipo do post</span>
                </span>
                <span class="text-slate-600 transition group-open:rotate-180">▾</span>
              </summary>
              <div class="space-y-3 border-t border-slate-800 px-2.5 py-2.5">
                <label class="block text-[11px] text-slate-500">
                  Tipo
                  <select id="matter-tipo" class="mt-1 w-full rounded border border-slate-800 bg-slate-900/50 px-2.5 py-1.5 text-sm text-white focus:border-emerald-500 focus:outline-none" <%= isReel ? 'disabled' : '' %>>
                <% if (isReel) { %>
                  <option value="reel" selected>Reel (vídeo)</option>
                <% } else {
                  const tipoSel = String(matter.tipo_publicacao || 'foto').toLowerCase();
                %>
                  <option value="foto" <%= tipoSel !== 'texto' ? 'selected' : '' %>>Foto + legenda</option>
                  <option value="texto" <%= tipoSel === 'texto' ? 'selected' : '' %>>Texto</option>
                <% } %>
                  </select>
                </label>

            <%
              const igPagina =
                typeof instagramPagina !== 'undefined' && instagramPagina
                  ? instagramPagina
                  : { ativo: false, username: null };
              const igMarcado = Boolean(matter.publicar_instagram);
              const xPage =
                typeof xPagina !== 'undefined' && xPagina
                  ? xPagina
                  : { ativo: false, username: null };
              const xMarcado = Boolean(matter.publicar_x);
            %>
                <div class="space-y-2">
              <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-sky-500/30 bg-sky-500/5 px-2.5 py-2">
                <input type="checkbox" id="matter-publicar-facebook" checked
                  class="mt-0.5 rounded border-slate-600 bg-slate-950 text-sky-500 focus:ring-sky-500/30" />
                <span class="text-[11px] leading-snug text-sky-100">
                  Publicar no Facebook
                  <span class="block text-[10px] text-slate-400">Marcado por padrão. Desmarque para publicar somente no Instagram.</span>
                </span>
              </label>
              <% if (igPagina.ativo) { %>
                <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-pink-500/30 bg-pink-500/5 px-2.5 py-2">
                  <input type="checkbox" id="matter-publicar-instagram" <%= igMarcado ? 'checked' : '' %>
                    class="mt-0.5 rounded border-slate-600 bg-slate-950 text-pink-500 focus:ring-pink-500/30" />
                  <span class="text-[11px] leading-snug text-pink-100">
                    Publicar no Instagram
                    <% if (igPagina.username) { %>
                      <span class="block text-[10px] text-pink-300/80">@<%= igPagina.username %></span>
                    <% } %>
                    <span class="block text-[10px] text-slate-400">Exige imagem ou vídeo na matéria.</span>
                  </span>
                </label>
              <% } else { %>
                <p class="rounded-lg border border-slate-800 bg-slate-900/40 px-2.5 py-2 text-[11px] leading-snug text-slate-500">
                  Instagram desligado para esta Página.
                  <a href="/paginas" class="text-pink-300 hover:underline">Ativar em /paginas</a>
                </p>
        <% } %>
              <% if (xPage.ativo) { %>
                <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-300/30 bg-slate-100/5 px-2.5 py-2">
                  <input type="checkbox" id="matter-publicar-x" <%= xMarcado ? 'checked' : '' %>
                    class="mt-0.5 rounded border-slate-600 bg-slate-950 text-slate-100 focus:ring-slate-200/30" />
                  <span class="text-[11px] leading-snug text-slate-100">
                    Publicar no X.com
                    <% if (xPage.username) { %>
                      <span class="block text-[10px] text-slate-300/80">@<%= String(xPage.username).replace(/^@/, '') %></span>
                    <% } %>
                    <span class="block text-[10px] text-slate-400">Desmarcado por padrão. O texto é reduzido a 280 caracteres no X.</span>
                  </span>
                </label>
                <button type="button" id="btn-editar-x"
                  class="hidden w-full rounded-lg border border-slate-500/40 bg-slate-100/5 px-2.5 py-1.5 text-[11px] font-medium text-slate-200 hover:border-slate-300 hover:bg-slate-100/10">
                  Revisar texto e imagem do X.com
                </button>
              <% } else { %>
                <p class="rounded-lg border border-slate-800 bg-slate-900/40 px-2.5 py-2 text-[11px] leading-snug text-slate-500">
                  X.com desligado para esta Página.
                  <a href="/paginas" class="text-slate-300 hover:underline">Ativar em /paginas</a>
                </p>
              <% } %>
                </div>
              </div>
            </details>

        <% if (canEdit) { %>
              <div class="flex flex-col gap-1.5 border-t border-slate-800 pt-3">
                <button type="button" class="wp-btn-publicar-dup rounded bg-emerald-500 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-emerald-400 disabled:opacity-50"
                  <%= reelProcessing ? 'disabled' : '' %>
                  onclick="document.getElementById('btn-publicar')?.click()">
                  <%= isReel ? 'Publicar Reel' : 'Publicar' %>
                </button>
                <button type="button" class="wp-btn-salvar-dup rounded border border-slate-600 bg-slate-800 px-3 py-2 text-xs font-semibold text-slate-100 hover:bg-slate-700"
                  onclick="document.getElementById('btn-salvar')?.click()">
                  Salvar rascunho
                </button>
              </div>

              <div class="space-y-2 rounded-lg border border-amber-500/25 bg-amber-500/5 p-2.5">
                <div class="flex items-center justify-between gap-2">
                  <p class="text-[11px] font-semibold text-amber-100">Agendar publicação</p>
                  <span class="text-[9px] uppercase tracking-wide text-amber-300/60">Araguaína −03</span>
                </div>
                <%
                  const ult = typeof ultimoAgendamento !== 'undefined' ? ultimoAgendamento : null;
                  const proxLocal = typeof proximoSlotLocal !== 'undefined' ? proximoSlotLocal : null;
                  const proxLabel = typeof proximoSlotLabel !== 'undefined' ? proximoSlotLabel : null;
                  const atualAg = typeof horarioAtualAgendado !== 'undefined' ? horarioAtualAgendado : null;
                  const agendaBib = typeof agendaBiblioteca !== 'undefined' ? agendaBiblioteca : null;
                  const jaEstaAgendada = st === 'agendado' && atualAg && atualAg.local;
                  const preAgendaBib = !jaEstaAgendada && agendaBib && agendaBib.horario && agendaBib.horario.local;
                  const horarioNoCampo = (jaEstaAgendada || preAgendaBib) && atualAg && atualAg.local ? atualAg.local : '';
                %>
                <% if (jaEstaAgendada) { %>
                  <div class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-2.5 py-2">
                    <p class="text-[11px] font-semibold text-amber-100">Já agendada</p>
                    <p class="mt-0.5 text-[12px] font-medium text-amber-50"><%= atualAg.label %></p>
                    <p class="mt-1 text-[10px] text-amber-200/70">Altere o horário abaixo e clique em Agendar para remarcar.</p>
                  </div>
                <% } else if (preAgendaBib) { %>
                  <div class="rounded-lg border border-sky-500/40 bg-sky-500/10 px-2.5 py-2">
                    <p class="text-[11px] font-semibold text-sky-100">Pré-agendada na Biblioteca</p>
                    <p class="mt-0.5 text-[12px] font-medium text-sky-50"><%= atualAg.label %></p>
                    <p class="mt-1 text-[10px] text-sky-200/70">Clique em Agendar para confirmar esse horário.</p>
                  </div>
                <% } %>
                <label class="block text-[11px] text-slate-400"><%= jaEstaAgendada ? 'Novo horário' : 'Data e horário' %>
                  <input
                    id="matter-schedule"
                    type="datetime-local"
                    class="mt-1 w-full rounded border border-slate-800 bg-slate-900/50 px-2 py-1.5 text-xs text-slate-200 focus:border-emerald-500 focus:outline-none"
                    value="<%= horarioNoCampo %>"
                  />
                </label>
                <% if (ult && ult.label) { %>
                  <button
                    type="button"
                    id="btn-agendar-mais-30"
                    class="w-full rounded border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 text-[11px] font-semibold text-amber-100 hover:bg-amber-500/20"
                    data-slot="<%= proxLocal || '' %>"
                    title="Preenche o horário com 30 minutos após o último agendamento das Matérias"
                  >
                    +30 min após o último<%= proxLabel ? ' → ' + proxLabel : '' %>
                  </button>
                  <p id="matter-ultimo-agendamento" class="text-[10px] leading-snug text-slate-500">
                    Última matéria agendada:
                    <span class="font-medium text-slate-300"><%= ult.label %></span>
                    <% if (ult.titulo) { %>
                      · <span class="text-slate-400"><%= String(ult.titulo).slice(0, 60) %><%= String(ult.titulo).length > 60 ? '…' : '' %></span>
                    <% } %>
                  </p>
                <% } else if (!jaEstaAgendada) { %>
                  <p class="text-[10px] text-slate-600">Nenhuma outra matéria agendada ainda.</p>
                <% } %>
                <button type="button" id="btn-agendar" class="w-full rounded border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 text-[11px] font-semibold text-amber-100 hover:bg-amber-500/20">
                  <%= jaEstaAgendada ? 'Remarcar' : 'Agendar' %>
                </button>
              </div>

              <details class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-950/30">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-2.5 py-2 text-[11px] font-medium text-slate-300 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
                  <span>Outras ações</span>
                  <span class="text-slate-600 transition group-open:rotate-180">▾</span>
                </summary>
                <div class="space-y-2 border-t border-slate-800 p-2.5">
                  <button type="button" id="btn-variacao-tema"
                    class="w-full rounded border border-violet-500/30 px-3 py-2 text-[11px] font-medium text-violet-200 hover:bg-violet-500/10"
                  <%= reelProcessing ? 'disabled' : '' %>>
                    Nova matéria neste tema
                  </button>
                  <% if (canGerarReelNarrado) { %>
                    <button type="button" id="btn-gerar-reel"
                      class="w-full rounded border border-sky-500/30 px-3 py-2 text-[11px] font-medium text-sky-200 hover:bg-sky-500/10"
                      data-has-video="<%= matter.video_path ? '1' : '0' %>"
                      <%= reelProcessing ? 'disabled' : '' %>>
                      <%= matter.video_path && isReel ? 'Regenerar Reel narrado' : 'Gerar Reel narrado' %>
                    </button>
                    <p class="text-[10px] leading-snug text-slate-500">Resumo narrado até 60s + voz + trilha (sem legenda no vídeo).</p>
                  <% } %>
                </div>
              </details>
            <% } else if (canRepublish) { %>
              <% if (matter.published_at) { %>
                <p class="text-[10px] text-slate-500">Publicada em <%= new Date(matter.published_at).toLocaleString('pt-BR') %></p>
              <% } %>
              <p class="text-[10px] leading-snug text-slate-500">Republicar cria um novo post (não edita o antigo).</p>
              <button type="button" id="btn-variacao-tema"
                class="w-full rounded border border-violet-500/30 px-3 py-2 text-[11px] font-medium text-violet-200 hover:bg-violet-500/10">
                Nova matéria neste tema
              </button>
              <% if (canGerarReelNarrado) { %>
                <button type="button" id="btn-gerar-reel"
                  class="w-full rounded border border-sky-500/30 px-3 py-2 text-[11px] font-medium text-sky-200 hover:bg-sky-500/10"
                  data-has-video="<%= matter.video_path ? '1' : '0' %>">
                  <%= matter.video_path && isReel ? 'Regenerar Reel narrado' : 'Gerar Reel narrado' %>
                </button>
              <% } %>
              <button type="button" id="btn-matter-views"
                class="w-full rounded border border-slate-800 px-3 py-1.5 text-[11px] text-slate-400 hover:border-sky-500/40 hover:text-sky-300">
                Atualizar engajamento
              </button>
            <% } else if (matter.published_at) { %>
              <p class="text-[10px] text-slate-500">Publicada em <%= new Date(matter.published_at).toLocaleString('pt-BR') %></p>
              <button type="button" id="btn-variacao-tema"
                class="w-full rounded border border-violet-500/30 px-3 py-2 text-[11px] font-medium text-violet-200 hover:bg-violet-500/10">
                Nova matéria neste tema
              </button>
              <button type="button" id="btn-matter-views"
                class="w-full rounded border border-slate-800 px-3 py-1.5 text-[11px] text-slate-400 hover:border-sky-500/40 hover:text-sky-300">
                Atualizar engajamento
              </button>
            <% } %>
          </div>
        </div>

        <!-- Imagem destacada / Reel -->
        <% if (isReel) { %>
          <div id="matter-reel-wrap" class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/40">
            <div class="flex items-center justify-between border-b border-slate-800 px-3 py-2">
              <p class="text-xs font-semibold text-slate-200">Reel</p>
              <span class="text-[10px] text-slate-500">9:16</span>
            </div>
            <div class="p-2">
            <% if (videoUrl) { %>
                <video id="matter-reel-video" class="block w-full rounded border border-slate-800 bg-black" controls playsinline
                src="<%= videoUrl %>?t=<%= Date.now() %>" poster="<%= imageUrl || '' %>"></video>
            <% } else { %>
                <div id="matter-reel-placeholder" class="flex min-h-[220px] flex-col items-center justify-center gap-2 rounded border border-dashed border-slate-800 bg-slate-900/50 px-3 py-6 text-center">
                  <span class="inline-block h-6 w-6 animate-spin rounded-full border-2 border-violet-400/30 border-t-violet-300"></span>
                  <p class="text-xs text-slate-300">Processando o Reel…</p>
              </div>
            <% } %>
            <% if (matter.error_message) { %>
                <p class="mt-2 text-[11px] text-amber-200"><%= matter.error_message %></p>
            <% } %>
            </div>
          </div>
        <% } else { %>
          <div id="matter-img-wrap" class="<%= imageUrl ? '' : 'hidden' %> overflow-hidden rounded-lg border border-slate-800 bg-slate-900/40">
            <div class="flex items-center justify-between border-b border-slate-800 px-3 py-2">
              <p class="text-xs font-semibold text-slate-200">Imagem destacada</p>
              <div class="flex items-center gap-2">
                <% if (canEdit) { %>
                  <button type="button" id="btn-abrir-recorte"
                    class="<%= imagemFonteUrl ? '' : 'hidden' %> rounded border border-amber-500/40 bg-amber-500/10 px-2 py-1 text-[10px] font-semibold text-amber-200 hover:bg-amber-500/20">
                    Recortar foto
                  </button>
                <% } %>
                <a id="btn-baixar-arte" href="<%= imageUrl || '#' %>" download="arte-materia-<%= matter.id %>.jpg"
                  class="<%= imageUrl ? '' : 'hidden' %> text-[10px] text-sky-400 hover:underline">Baixar</a>
                <span class="text-[10px] text-slate-500">4:5</span>
              </div>
            </div>
            <% if (canEdit && typeof artModelChoices !== 'undefined' && artModelChoices.length > 1) { %>
              <details id="matter-art-models" class="group border-b border-slate-800">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-[10px] font-medium text-slate-400 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
                  <span>Modelo da arte</span>
                  <span class="text-slate-600 transition group-open:rotate-180">▾</span>
                </summary>
                <div class="grid grid-cols-2 gap-2 border-t border-slate-800 px-3 py-2">
                  <% artModelChoices.forEach((m) => {
                    const ativo = String(typeof arteModeloAtivo !== 'undefined' ? arteModeloAtivo : '') === m.id;
                  %>
                    <button type="button"
                      class="js-matter-art-model group overflow-hidden rounded-lg border text-left transition <%= ativo ? 'border-emerald-400 ring-1 ring-emerald-400/30' : 'border-slate-700 hover:border-slate-500' %>"
                      data-model="<%= m.id %>"
                      aria-pressed="<%= ativo ? 'true' : 'false' %>"
                      title="<%= m.description %>">
                      <img src="/minha-marca/preview/<%= m.id %>.png?v=<%= typeof brandPreviewVersion !== 'undefined' ? brandPreviewVersion : '' %>"
                        alt="<%= m.name %>" class="aspect-[4/5] w-full bg-slate-900 object-cover" loading="lazy" />
                      <span class="block border-t border-slate-800 px-1.5 py-1">
                        <span class="block truncate text-[10px] font-semibold text-white"><%= m.name %></span>
                        <span class="text-[9px] <%= m.role === 'principal' ? 'text-emerald-400/80' : 'text-sky-400/80' %>">
                          <%= m.role === 'principal' ? 'Principal' : 'Secundário' %>
                        </span>
                      </span>
                    </button>
                  <% }) %>
                </div>
              </details>
        <% } %>
            <div class="p-2">
              <div id="matter-img-frame-preview" class="relative overflow-hidden rounded border border-slate-800 bg-slate-900/50">
                <% if (canEdit && imagemFonteUrl) { %>
                  <img id="matter-img-fonte-bg" src="<%= imagemFonteUrl %>" alt="" aria-hidden="true"
                    class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full object-cover"
                    style="filter: blur(24px); opacity: .4; transform: scale(1.1)" />
                  <img id="matter-img-fonte" src="<%= imagemFonteUrl %>" alt="Foto de origem"
                    class="pointer-events-none absolute inset-0 z-10 hidden h-full w-full object-cover" />
                <% } %>
                <img id="matter-img-marca" alt="Minha marca"
                  class="pointer-events-none absolute inset-0 z-20 hidden h-full w-full object-fill" />
                <img id="matter-img" src="<%= imageUrl %>" alt="Arte da matéria" class="relative z-10 block h-auto w-full object-cover" />
              </div>
              <% if (canEdit) { %>
                <details id="matter-art-frame" class="group mt-2 rounded-lg border border-slate-700/80 bg-slate-950/60">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-2.5 py-2 text-[11px] font-medium text-slate-300 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
                    <span>Enquadramento da imagem</span>
                    <span class="text-slate-600 transition group-open:rotate-180">▾</span>
                  </summary>
                  <div class="space-y-2 border-t border-slate-800 p-2">
                    <p class="text-[10px] leading-relaxed text-slate-500">
                      Ajuste zoom e posição da foto. A marca permanece fixa por cima.
                    </p>
                  <label class="block">
                    <span class="flex items-center justify-between text-[10px] text-slate-400">
                      Zoom
                      <span id="art-zoom-valor" class="tabular-nums text-slate-500">100%</span>
                    </span>
                    <input id="art-zoom" type="range" min="80" max="160" step="1" value="100"
                      class="mt-1 w-full accent-emerald-500" />
                  </label>
                  <label class="block">
                    <span class="flex items-center justify-between text-[10px] text-slate-400">
                      Horizontal
                      <span id="art-offset-x-valor" class="tabular-nums text-slate-500">50%</span>
                    </span>
                    <input id="art-offset-x" type="range" min="0" max="100" step="1" value="50"
                      class="mt-1 w-full accent-sky-500" />
                  </label>
                  <label class="block">
                    <span class="flex items-center justify-between text-[10px] text-slate-400">
                      Vertical
                      <span id="art-offset-y-valor" class="tabular-nums text-slate-500">50%</span>
                    </span>
                    <input id="art-offset-y" type="range" min="0" max="100" step="1" value="50"
                      class="mt-1 w-full accent-sky-500" />
                  </label>
                    <button type="button" id="btn-art-enquadrar"
                      class="w-full rounded border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-200 hover:bg-emerald-500/20 disabled:opacity-40">
                      Aplicar enquadramento
                    </button>
                  </div>
                </details>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if (canEdit && !isReel) { %>
          <details open class="group overflow-hidden rounded-lg border border-slate-800 bg-slate-900/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-slate-800/40 [&::-webkit-details-marker]:hidden">
              <span>Trocar imagem</span>
              <span class="text-slate-600 transition group-open:rotate-180">▾</span>
            </summary>
            <div class="space-y-2.5 px-3 py-3">
              <div id="matter-img-suggest-loading" class="hidden items-center gap-2 rounded border border-amber-500/40 bg-amber-500/10 px-2.5 py-1.5">
                <span class="inline-block h-3 w-3 shrink-0 animate-spin rounded-full border-2 border-amber-300/30 border-t-amber-300"></span>
                <p class="text-[11px] text-amber-100">Alterando a arte…</p>
              </div>
              <p id="matter-img-suggest-meta" class="line-clamp-2 text-[10px] text-slate-500">Sugestões</p>
              <div id="matter-img-suggest-strip" class="flex max-h-[11rem] flex-wrap gap-1.5 overflow-y-auto pr-0.5">
                <div class="h-[4.5rem] w-14 shrink-0 animate-pulse rounded bg-slate-800"></div>
                <div class="h-[4.5rem] w-14 shrink-0 animate-pulse rounded bg-slate-800"></div>
                <div class="h-[4.5rem] w-14 shrink-0 animate-pulse rounded bg-slate-800"></div>
                <div class="h-[4.5rem] w-14 shrink-0 animate-pulse rounded bg-slate-800"></div>
              </div>

              <% if (canReloadBrand) { %>
                <button type="button" id="btn-recarregar-marca" class="w-full rounded border border-emerald-500/40 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-200 hover:bg-emerald-500/10">
                  ↻ Aplicar Minha marca
                </button>
            <% } else { %>
                <p class="rounded border border-amber-500/20 bg-amber-500/10 px-2 py-1.5 text-[10px] text-amber-200">Escolha uma imagem para aplicar a marca.</p>
              <% if (matter.fonte_url) { %>
                <button type="button" id="btn-buscar-imagem-fonte"
                    class="w-full rounded border border-sky-500/40 px-2.5 py-1.5 text-[11px] font-semibold text-sky-200 hover:bg-sky-500/10">
                  Buscar imagem da fonte
                </button>
              <% } %>
            <% } %>

              <button type="button" id="btn-banco-imagens"
                class="flex w-full items-center justify-center gap-1.5 rounded border border-emerald-500/50 bg-emerald-500/10 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-100 hover:bg-emerald-500/20"
                title="Imagens limpas (sem título) já geradas com IA, enviadas ou importadas do ChatGPT/Grok">
                Minhas imagens (sem gerar de novo)
              </button>

              <button type="button" id="btn-sugerir-imagens"
                class="w-full rounded border border-violet-500/40 px-2.5 py-1.5 text-[11px] font-semibold text-violet-200 hover:bg-violet-500/10">
                Buscar novas sugestões
              </button>

              <label class="block cursor-pointer rounded border border-dashed border-slate-600 px-2.5 py-2 text-center text-[11px] font-medium text-slate-300 hover:border-emerald-500 hover:text-emerald-200">
                Enviar imagem
              <input id="matter-image-input" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" />
            </label>

              <div class="space-y-1.5 rounded-lg border border-slate-700/80 bg-slate-950/50 p-2">
                <label for="matter-img-busca-q" class="block text-[10px] font-medium uppercase tracking-wide text-slate-500">
                  Digite a palavra para buscar imagem
                </label>
                <div class="flex gap-1.5">
                  <input
                    id="matter-img-busca-q"
                    type="search"
                    maxlength="120"
                    placeholder="Ex.: Ester Bezerra, pastor, culto…"
                    class="min-w-0 flex-1 rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-[12px] text-slate-100 placeholder:text-slate-600 focus:border-violet-500 focus:outline-none focus:ring-1 focus:ring-violet-500/30"
                  />
                  <button
                    type="button"
                    id="btn-buscar-img-palavra"
                    class="shrink-0 rounded border border-violet-500/50 bg-violet-500/15 px-2.5 py-1.5 text-[11px] font-semibold text-violet-100 hover:bg-violet-500/25"
                  >
                    Buscar
                  </button>
                </div>
              </div>

              <div id="matter-colagem-panel" class="space-y-2 rounded-lg border border-amber-500/30 bg-amber-500/5 p-2">
                <div class="flex items-center justify-between gap-2">
                  <p class="text-[10px] font-medium uppercase tracking-wide text-amber-200/90">Montar com 2 imagens</p>
                  <button type="button" id="btn-colagem-toggle"
                    class="rounded border border-amber-500/40 px-2 py-0.5 text-[10px] font-semibold text-amber-100 hover:bg-amber-500/15">
                    Ativar
                  </button>
                </div>
                <div id="matter-colagem-body" class="hidden space-y-2">
                  <p class="text-[10px] leading-relaxed text-slate-400">
                    A arte final fica em 1080×1350 (post do Facebook). Escolha preservar rostos para evitar cortes excessivos ou preencher painel para ampliar as fotos.
                  </p>
                  <div class="flex gap-1.5">
                    <button type="button" data-colagem-fit="preservar" class="colagem-fit-btn flex-1 rounded border border-amber-500/50 bg-amber-500/15 px-2 py-1 text-[10px] font-semibold text-amber-100">Preservar rostos</button>
                    <button type="button" data-colagem-fit="preencher" class="colagem-fit-btn flex-1 rounded border border-slate-600 px-2 py-1 text-[10px] font-semibold text-slate-300 hover:border-amber-500/40">Preencher painel</button>
                  </div>
                  <label class="block">
                    <span class="flex items-center justify-between text-[10px] text-amber-200/80">
                      Zoom das 2 fotos
                      <span id="colagem-zoom-valor" class="tabular-nums text-slate-500">92%</span>
                    </span>
                    <input id="colagem-zoom" type="range" min="80" max="150" step="1" value="92"
                      class="mt-1 w-full accent-amber-500" />
                  </label>
                  <div class="flex gap-1.5">
                    <button type="button" data-colagem-layout="lado" class="colagem-layout-btn flex-1 rounded border border-amber-500/50 bg-amber-500/15 px-2 py-1 text-[10px] font-semibold text-amber-100">Lado a lado</button>
                    <button type="button" data-colagem-layout="cima" class="colagem-layout-btn flex-1 rounded border border-slate-600 px-2 py-1 text-[10px] font-semibold text-slate-300 hover:border-amber-500/40">Cima / baixo</button>
                  </div>
                  <div class="grid grid-cols-2 gap-1.5">
                    <div id="colagem-slot-a" class="flex h-16 items-center justify-center overflow-hidden rounded border border-dashed border-slate-600 bg-slate-950 text-[10px] text-slate-500">1ª foto</div>
                    <div id="colagem-slot-b" class="flex h-16 items-center justify-center overflow-hidden rounded border border-dashed border-slate-600 bg-slate-950 text-[10px] text-slate-500">2ª foto</div>
                  </div>
                  <div class="flex gap-1.5">
                    <button type="button" id="btn-colagem-gerar" disabled
                      class="flex-1 rounded border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-200 hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-40">
                      Gerar arte com as 2 fotos
                    </button>
                    <button type="button" id="btn-colagem-limpar"
                      class="rounded border border-slate-600 px-2 py-1.5 text-[11px] text-slate-300 hover:border-slate-500">
                      Limpar
                    </button>
                  </div>
                </div>
              </div>

              <div id="matter-image-preview-wrap" class="hidden">
                <img id="matter-image-preview" src="" alt="Pré-visualização" class="block max-h-48 w-full rounded border border-slate-800 bg-slate-900/50 object-contain" />
                <div class="mt-2 flex gap-1.5">
                  <button type="button" id="btn-confirmar-imagem" class="flex-1 rounded bg-emerald-500 px-2 py-1.5 text-[11px] font-semibold text-slate-950 hover:bg-emerald-400">Usar esta</button>
                  <button type="button" id="btn-cancelar-imagem" class="rounded border border-slate-600 px-2 py-1.5 text-[11px] text-slate-300">Cancelar</button>
                </div>
              </div>
            </div>
          </details>
        <% } %>
      </aside>
    </div>
  </main>

  <div id="matter-crop-modal" class="hidden fixed inset-0 flex items-center justify-center bg-slate-950/90 p-3 backdrop-blur-sm" style="z-index:70" role="dialog" aria-modal="true" aria-labelledby="matter-crop-title">
    <div class="flex w-full max-w-5xl flex-col overflow-hidden rounded-xl border border-slate-700 bg-slate-900 shadow-xl shadow-black/50" style="max-height:96vh">
      <div class="flex items-start justify-between gap-3 border-b border-slate-800 px-4 py-3">
        <div>
          <h2 id="matter-crop-title" class="text-sm font-semibold text-white">Recortar foto da imagem destacada</h2>
          <p class="mt-1 text-[11px] leading-relaxed text-slate-400">Escolha livremente qualquer parte da foto. Mova o quadro ou arraste cantos e laterais sem proporção fixa.</p>
        </div>
        <button type="button" id="matter-crop-close" class="rounded px-2 py-1 text-lg leading-none text-slate-400 hover:bg-slate-800 hover:text-white disabled:cursor-not-allowed disabled:opacity-40" aria-label="Fechar">×</button>
      </div>

      <div class="overflow-y-auto p-3 sm:p-4">
        <div class="mb-3 rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-3">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <p id="matter-image-generator-title" class="text-xs font-semibold text-emerald-200">Criar nova versão com ChatGPT</p>
              <p id="matter-image-generator-desc" class="mt-1 text-[10px] leading-relaxed text-slate-400">Na versão com referência, a foto atual é enviada ao ChatGPT. Cada clique abre uma conversa separada. Para temas sensíveis, você também pode criar uma ilustração simbólica sem enviar a foto.</p>
            </div>
            <span class="rounded-full border border-emerald-500/30 px-2 py-0.5 text-[9px] font-semibold text-emerald-300">SEM TEXTO</span>
          </div>
          <textarea id="matter-chatgpt-image-prompt" rows="4" maxlength="1800"
            class="mt-2 w-full resize-y rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-[11px] leading-relaxed text-slate-200 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none"
            placeholder="Descreva a nova imagem…"></textarea>
          <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
            <p id="matter-chatgpt-image-status" class="min-w-0 flex-1 text-[10px] text-slate-500" aria-live="polite">A imagem gerada aparecerá abaixo para você recortar antes de salvar.</p>
            <button type="button" id="matter-chatgpt-image-generate"
              class="rounded-lg border border-emerald-500/50 bg-emerald-500/15 px-3 py-1.5 text-[11px] font-semibold text-emerald-100 hover:bg-emerald-500/25 disabled:cursor-wait disabled:opacity-50">
              Gerar imagem sem texto
            </button>
            <button type="button" id="matter-chatgpt-image-symbolic"
              class="rounded-lg border border-amber-500/50 bg-amber-500/10 px-3 py-1.5 text-[11px] font-semibold text-amber-100 hover:bg-amber-500/20">
              Criar ilustração simbólica sem pessoas
            </button>
            <button type="button" id="matter-chatgpt-image-recover"
              class="rounded-lg border border-sky-500/50 bg-sky-500/10 px-3 py-1.5 text-[11px] font-semibold text-sky-100 hover:bg-sky-500/20 disabled:cursor-wait disabled:opacity-50">
              Pegar imagem nova gerada
            </button>
          </div>
          <p class="mt-1 text-[10px] text-slate-500">A ilustração simbólica não usa a foto nem representa o acontecimento. Ao publicar, identifique-a como imagem gerada por IA.</p>
          <div id="matter-chatgpt-image-jobs" class="mt-2 grid gap-1.5"></div>
        </div>
        <div class="flex min-h-[240px] items-center justify-center overflow-hidden rounded-lg border border-slate-700 bg-black/60 p-2">
          <div id="matter-crop-stage" class="relative inline-block max-w-full overflow-hidden" style="touch-action:none; user-select:none; cursor:move;">
            <img id="matter-crop-image" src="" alt="Foto original para recorte" class="block max-w-full object-contain" style="max-height:62vh;" draggable="false" />
            <div id="matter-crop-selection" class="absolute border-2 border-amber-300" style="box-shadow:0 0 0 9999px rgba(2,6,23,.72); cursor:move; touch-action:none;">
              <span class="pointer-events-none absolute left-1 top-1 rounded px-1.5 py-0.5 text-[9px] font-bold text-slate-950" style="background:#fcd34d">ARRASTE PARA MOVER</span>
              <span data-crop-handle="nw" title="Redimensionar" class="absolute rounded-full" style="left:-8px;top:-8px;width:16px;height:16px;background:#fcd34d;border:2px solid #020617;cursor:nwse-resize;"></span>
              <span data-crop-handle="ne" title="Redimensionar" class="absolute rounded-full" style="right:-8px;top:-8px;width:16px;height:16px;background:#fcd34d;border:2px solid #020617;cursor:nesw-resize;"></span>
              <span data-crop-handle="sw" title="Redimensionar" class="absolute rounded-full" style="left:-8px;bottom:-8px;width:16px;height:16px;background:#fcd34d;border:2px solid #020617;cursor:nesw-resize;"></span>
              <span data-crop-handle="se" title="Redimensionar" class="absolute rounded-full" style="right:-8px;bottom:-8px;width:16px;height:16px;background:#fcd34d;border:2px solid #020617;cursor:nwse-resize;"></span>
              <span data-crop-handle="n" title="Mover borda superior" class="absolute rounded-full" style="left:50%;top:-7px;transform:translateX(-50%);width:22px;height:12px;background:#fcd34d;border:2px solid #020617;cursor:ns-resize;"></span>
              <span data-crop-handle="s" title="Mover borda inferior" class="absolute rounded-full" style="left:50%;bottom:-7px;transform:translateX(-50%);width:22px;height:12px;background:#fcd34d;border:2px solid #020617;cursor:ns-resize;"></span>
              <span data-crop-handle="w" title="Mover borda esquerda" class="absolute rounded-full" style="left:-7px;top:50%;transform:translateY(-50%);width:12px;height:22px;background:#fcd34d;border:2px solid #020617;cursor:ew-resize;"></span>
              <span data-crop-handle="e" title="Mover borda direita" class="absolute rounded-full" style="right:-7px;top:50%;transform:translateY(-50%);width:12px;height:22px;background:#fcd34d;border:2px solid #020617;cursor:ew-resize;"></span>
            </div>
          </div>
        </div>

        <div class="mt-3 grid gap-3 rounded-lg border border-slate-800 bg-slate-950/60 p-3" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
          <label class="block">
            <span class="flex items-center justify-between text-[10px] text-slate-400">
              Largura <span id="matter-crop-width-value" class="tabular-nums text-slate-500">90%</span>
            </span>
            <input id="matter-crop-width" type="range" min="0.1" max="100" step="0.1" value="90" class="mt-1 w-full accent-amber-400" />
          </label>
          <label class="block">
            <span class="flex items-center justify-between text-[10px] text-slate-400">
              Altura <span id="matter-crop-height-value" class="tabular-nums text-slate-500">90%</span>
            </span>
            <input id="matter-crop-height" type="range" min="0.1" max="100" step="0.1" value="90" class="mt-1 w-full accent-amber-400" />
          </label>
          <label class="block">
            <span class="flex items-center justify-between text-[10px] text-slate-400">
              Horizontal <span id="matter-crop-x-value" class="tabular-nums text-slate-500">50%</span>
            </span>
            <input id="matter-crop-x" type="range" min="0" max="100" step="1" value="50" class="mt-1 w-full accent-sky-500" />
          </label>
          <label class="block">
            <span class="flex items-center justify-between text-[10px] text-slate-400">
              Vertical <span id="matter-crop-y-value" class="tabular-nums text-slate-500">50%</span>
            </span>
            <input id="matter-crop-y" type="range" min="0" max="100" step="1" value="50" class="mt-1 w-full accent-sky-500" />
          </label>
        </div>
        <p id="matter-crop-help" class="mt-2 text-center text-[10px] text-slate-500">Arraste dentro do quadro para mover. Use cantos e laterais para definir exatamente a área desejada.</p>
      </div>

      <div class="flex items-center justify-end gap-2 border-t border-slate-800 px-4 py-3">
        <button type="button" id="matter-crop-cancel" class="rounded border border-slate-600 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40">Cancelar</button>
        <button type="button" id="matter-crop-save" class="rounded bg-amber-400 px-3 py-1.5 text-xs font-bold text-slate-950 hover:bg-amber-300 disabled:opacity-50">Recortar e salvar</button>
      </div>
    </div>
  </div>

  <div id="publish-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/85 p-6 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="publish-modal-title">
    <div class="w-full max-w-sm rounded-xl border border-slate-800 bg-slate-900 p-8 text-center shadow-xl shadow-black/40">
      <div id="publish-modal-spin" class="mx-auto h-12 w-12 animate-spin rounded-full border-2 border-emerald-500/30 border-t-emerald-400"></div>
      <div id="publish-modal-ok" class="mx-auto hidden flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/15 text-2xl text-emerald-300">✓</div>
      <h2 id="publish-modal-title" class="mt-5 text-lg font-semibold text-white">Publicando…</h2>
      <p id="publish-modal-text" class="mt-2 text-sm leading-relaxed text-slate-400">Enviando a matéria para as redes selecionadas.</p>
      <a id="publish-modal-link" href="#" target="_blank" rel="noopener" class="mt-4 hidden inline-block text-sm text-sky-400 hover:underline">Ver publicação →</a>
    </div>
  </div>

  <div id="x-editor-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-slate-950/85 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="x-editor-title">
    <div class="my-auto w-full max-w-2xl overflow-hidden rounded-xl border border-slate-700 bg-slate-900 shadow-2xl shadow-black/50">
      <div class="flex items-start justify-between gap-3 border-b border-slate-800 px-5 py-4">
        <div>
          <h2 id="x-editor-title" class="text-base font-semibold text-white">Versão exclusiva para o X.com</h2>
          <p class="mt-1 text-xs leading-relaxed text-slate-400">Facebook e Instagram continuarão usando o texto e a imagem originais.</p>
        </div>
        <button type="button" id="x-editor-fechar" class="rounded px-2 py-1 text-xl leading-none text-slate-500 hover:bg-slate-800 hover:text-white" aria-label="Fechar">×</button>
      </div>
      <div class="grid gap-4 p-5 md:grid-cols-[minmax(0,1fr)_220px]">
        <div>
          <div class="mb-2 flex items-center justify-between gap-2">
            <label for="matter-texto-x" class="text-xs font-semibold text-slate-200">Texto do post</label>
            <span id="matter-texto-x-count" class="text-xs font-medium tabular-nums text-emerald-300">0 / 280</span>
          </div>
          <textarea id="matter-texto-x" rows="8" maxlength="560"
            placeholder="O Claude criará uma versão curta desta matéria…"
            class="w-full resize-y rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm leading-relaxed text-slate-100 placeholder:text-slate-600 focus:border-sky-400 focus:outline-none"><%= matter.texto_x || '' %></textarea>
          <div class="mt-2 flex flex-wrap gap-2">
            <button type="button" id="btn-gerar-texto-x" class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-950 hover:bg-white disabled:opacity-50">
              Gerar resumo com Claude
            </button>
          </div>
          <p id="matter-texto-x-status" class="mt-2 text-[11px] text-slate-500"></p>
        </div>
        <div>
          <p class="mb-2 text-xs font-semibold text-slate-200">Imagem do X.com</p>
          <div class="overflow-hidden rounded-lg border border-slate-700 bg-slate-950">
            <img id="matter-imagem-x-preview" src="<%= matter.imagem_x_url || imageUrl || '' %>" alt="Prévia exclusiva do X" class="aspect-square w-full object-contain <%= (matter.imagem_x_url || imageUrl) ? '' : 'hidden' %>" />
            <p id="matter-imagem-x-vazia" class="px-3 py-10 text-center text-[11px] text-slate-600 <%= (matter.imagem_x_url || imageUrl) ? 'hidden' : '' %>">Sem imagem</p>
          </div>
          <label class="mt-2 block text-[11px] text-slate-400">
            URL exclusiva (opcional)
            <input id="matter-imagem-x-url" type="url" value="<%= matter.imagem_x_url || '' %>" placeholder="Vazio = usar a arte atual"
              class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-2 text-xs text-slate-100 placeholder:text-slate-600 focus:border-sky-400 focus:outline-none" />
          </label>
          <button type="button" id="btn-x-usar-imagem-atual" class="mt-2 w-full rounded-lg border border-slate-700 px-2.5 py-1.5 text-[11px] text-slate-300 hover:border-slate-500 hover:text-white">Usar arte atual</button>
          <p class="mt-2 text-[10px] leading-relaxed text-slate-500">No envio, somente a imagem do X é convertida para JPEG, até 1200 px e abaixo de 5 MB.</p>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 border-t border-slate-800 px-5 py-3">
        <button type="button" id="x-editor-cancelar" class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:bg-slate-800">Fechar</button>
        <button type="button" id="x-editor-salvar" class="rounded-lg bg-sky-500 px-3 py-1.5 text-xs font-semibold text-slate-950 hover:bg-sky-400">Salvar versão do X</button>
      </div>
    </div>
  </div>

  <script>
    window.__MATTER_EDIT__ = {
      id: <%= matter.id %>,
      pageId: <%= matter.facebook_page_id ? Number(matter.facebook_page_id) : 'null' %>,
      canEdit: <%= canEdit ? 'true' : 'false' %>,
      canRepublish: <%= canRepublish ? 'true' : 'false' %>,
      isReel: <%= isReel ? 'true' : 'false' %>,
      reelProcessing: <%= reelProcessing ? 'true' : 'false' %>,
      videoUrl: <%- JSON.stringify(videoUrl || null) %>,
      imagemFonteUrl: <%- JSON.stringify(imagemFonteUrl || null) %>,
      arteModelo: <%- JSON.stringify(typeof arteModeloAtivo !== 'undefined' ? arteModeloAtivo : null) %>,
      artModelChoices: <%- JSON.stringify(typeof artModelChoices !== 'undefined' ? artModelChoices : []) %>,
      instagramAtivo: <%= (typeof instagramPagina !== 'undefined' && instagramPagina && instagramPagina.ativo) ? 'true' : 'false' %>,
      xAtivo: <%= (typeof xPagina !== 'undefined' && xPagina && xPagina.ativo) ? 'true' : 'false' %>,
      imagemAtual: <%- JSON.stringify(imageUrl || null) %>,
      listUrl: '/minhas-materias',
      ultimoAgendamento: <%- JSON.stringify(typeof ultimoAgendamento !== 'undefined' ? ultimoAgendamento : null) %>,
      proximoSlotLocal: <%- JSON.stringify(typeof proximoSlotLocal !== 'undefined' ? proximoSlotLocal : null) %>,
      horarioAtualAgendado: <%- JSON.stringify(typeof horarioAtualAgendado !== 'undefined' ? horarioAtualAgendado : null) %>,
      agendaBiblioteca: <%- JSON.stringify(typeof agendaBiblioteca !== 'undefined' ? agendaBiblioteca : null) %>,
    };
    (function () {
      const ta = document.getElementById('matter-materia');
      const counter = document.getElementById('matter-char-count');
      if (!ta || !counter) return;
      function update() {
        const n = (ta.value || '').length;
        counter.textContent = n.toLocaleString('pt-BR') + ' caracteres';
        counter.classList.toggle('text-amber-400', n > 0 && (n < 1200 || n > 2200));
        counter.classList.toggle('text-emerald-400', n >= 1700 && n <= 2100);
      }
      ta.addEventListener('input', update);
      update();
    })();
  </script>
