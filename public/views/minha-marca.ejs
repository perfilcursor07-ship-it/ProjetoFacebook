<%- include('partials/app-start') %>
  <link rel="stylesheet" href="/css/dots.css?v=20261003e" />
<%
  const activeTab = typeof tab !== 'undefined' && tab === 'video' ? 'video' : 'imagem';
  const videoModeloAtual = profile.marca_video_modelo || defaultVideoBrandModel;
  const videoCorDestaque = profile.marca_video_cor_destaque || '#facc15';
%>

  <main class="dots-pagina brand-page mx-auto max-w-8xl px-4 py-6 sm:px-6 sm:py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="dots-etiqueta">Identidade visual</p>
        <h1 class="dots-titulo mt-1">Minha marca</h1>
        <p class="dots-sub">
          Marca de <strong class="font-medium text-slate-300">imagem</strong> (artes das matérias) e marca de
          <strong class="font-medium text-slate-300">vídeo</strong> (Reels / tela dividida) — podem ser diferentes.
        </p>
      </div>
      <a href="/materia-manual" class="d-btn d-btn--neutro">Voltar para criar matéria</a>
    </header>

    <% if (saved) { %>
      <div class="mt-5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">Identidade visual salva com sucesso.</div>
    <% } %>
    <% if (error) { %>
      <div class="mt-5 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200"><%= error %></div>
    <% } %>

    <div class="brand-tabs mt-6" role="tablist" aria-label="Tipo de marca">
      <a href="/minha-marca"
        class="rounded-lg px-4 py-2 text-sm font-semibold <%= activeTab === 'imagem' ? 'bg-emerald-500 text-slate-950' : 'text-slate-300 hover:text-white' %>">
        Marca para imagem
      </a>
      <a href="/minha-marca?tab=video"
        class="rounded-lg px-4 py-2 text-sm font-semibold <%= activeTab === 'video' ? 'bg-fuchsia-500 text-white' : 'text-slate-300 hover:text-white' %>">
        Marca para vídeo
      </a>
    </div>

    <%- include('partials/page-distribution', { mode: 'brands' }) %>
    <form action="/minha-marca" method="POST" enctype="multipart/form-data" class="brand-form mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
      <input type="hidden" name="marca_tab" value="<%= activeTab %>" />
      <input type="hidden" name="marca_modelo_arte" value="<%= profile.marca_modelo_arte || defaultArtModel %>" id="hidden-modelo-arte" />
      <input type="hidden" name="marca_modelo_arte_secundario" value="<%= profile.marca_modelo_arte_secundario || '' %>" id="hidden-modelo-arte-sec" />
      <input type="hidden" name="marca_video_modelo" value="<%= videoModeloAtual %>" id="hidden-modelo-video" />

      <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-base font-semibold text-white">Dados da marca</h2>
        <p class="mt-1 text-xs text-slate-500">Nome, logo e cores valem para os dois (imagem e vídeo).</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block sm:col-span-2">
            <span class="text-sm text-slate-400">Logomarca</span>
            <input id="logo-input" type="file" name="logo" accept="image/png,image/jpeg,image/webp"
              class="mt-1.5 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-300 file:mr-3 file:rounded-md file:border-0 file:bg-emerald-500 file:px-3 file:py-1.5 file:font-semibold file:text-slate-950" />
            <span class="mt-1 block text-xs text-slate-500">PNG, JPG ou WebP, até 3 MB. Prefira PNG com fundo transparente.</span>
          </label>
          <label class="block sm:col-span-2">
            <span class="text-sm text-slate-400">Nome exibido</span>
            <input name="marca_nome" maxlength="120" value="<%= profile.marca_nome || profile.nome || '' %>"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-white focus:border-emerald-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-sm text-slate-400">Categoria</span>
            <input name="marca_categoria" maxlength="80" value="<%= profile.marca_categoria || 'ÚLTIMAS' %>"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-white focus:border-emerald-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-sm text-slate-400">Texto do rodapé</span>
            <input name="marca_rodape" maxlength="160" value="<%= profile.marca_rodape || '' %>" placeholder="@sua_pagina"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-white focus:border-emerald-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-sm text-slate-400">Cor principal</span>
            <div class="mt-1.5 flex gap-2 rounded-lg border border-slate-700 bg-slate-950 p-2">
              <input type="color" name="marca_cor_primaria" value="<%= profile.marca_cor_primaria || '#ffbd59' %>" class="h-8 w-full cursor-pointer border-0 bg-transparent" />
            </div>
          </label>
          <label class="block">
            <span class="text-sm text-slate-400">Cor secundária</span>
            <div class="mt-1.5 flex gap-2 rounded-lg border border-slate-700 bg-slate-950 p-2">
              <input type="color" name="marca_cor_secundaria" value="<%= profile.marca_cor_secundaria || '#fb923c' %>" class="h-8 w-full cursor-pointer border-0 bg-transparent" />
            </div>
          </label>
        </div>

        <% if (activeTab === 'imagem') { %>
        <div class="mt-7 border-t border-slate-800 pt-6">
          <h3 class="text-sm font-semibold text-white">Tipografia do título</h3>
          <p class="mt-1 text-xs text-slate-500">Usada nas artes de imagem (Matérias IA).</p>

          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-slate-500">Fonte principal</p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <% brandFonts.forEach((font) => { %>
              <label class="cursor-pointer">
                <input type="radio" name="marca_fonte" value="<%= font.id %>" class="peer sr-only js-brand-font"
                  <%= (profile.marca_fonte || defaultBrandFont) === font.id ? 'checked' : '' %> />
                <span class="block rounded-xl border-2 border-slate-700 bg-slate-950 px-3 py-3 transition peer-checked:border-emerald-400 peer-checked:ring-2 peer-checked:ring-emerald-400/25 hover:border-slate-500">
                  <span class="block text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= font.name %><% if (font.id === defaultBrandFont) { %> · padrão<% } %></span>
                  <span class="mt-1 block text-xl leading-none text-white" style="font-family: <%= font.cssFamily %>; font-weight: <%= font.previewWeight %>;">TÍTULO DA NOTÍCIA</span>
                </span>
              </label>
            <% }) %>
          </div>

          <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-slate-500">Cor bold do título</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <% titleColors.forEach((c) => {
              const swatch = c.id === 'primaria' ? (profile.marca_cor_primaria || '#ffbd59')
                : c.id === 'secundaria' ? (profile.marca_cor_secundaria || '#fb923c')
                : c.value;
            %>
              <label class="cursor-pointer">
                <input type="radio" name="marca_titulo_cor" value="<%= c.id %>" class="peer sr-only js-title-color"
                  <%= (profile.marca_titulo_cor || defaultTitleColor) === c.id ? 'checked' : '' %> />
                <span class="inline-flex items-center gap-2 rounded-lg border-2 border-slate-700 bg-slate-950 px-3 py-2 text-xs text-slate-300 transition peer-checked:border-emerald-400 peer-checked:text-white hover:border-slate-500">
                  <span class="h-4 w-4 rounded-full border border-white/20" style="background: <%= swatch %>"></span>
                  <%= c.name %>
                </span>
              </label>
            <% }) %>
          </div>

          <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-slate-500">Tamanho do título</p>
          <div class="mt-2 rounded-xl border border-slate-700 bg-slate-950 px-4 py-3">
            <div class="flex items-center justify-between gap-3 text-xs text-slate-400">
              <span><%= titleSizeMin %></span>
              <span class="font-semibold text-white">Tamanho: <span id="title-size-value"><%= Number(profile.marca_titulo_tamanho) >= titleSizeMin && Number(profile.marca_titulo_tamanho) <= titleSizeMax ? Number(profile.marca_titulo_tamanho) : defaultTitleSize %></span>px</span>
              <span><%= titleSizeMax %></span>
            </div>
            <input id="title-size-input" type="range" name="marca_titulo_tamanho" min="<%= titleSizeMin %>" max="<%= titleSizeMax %>" step="1"
              value="<%= Number(profile.marca_titulo_tamanho) >= titleSizeMin && Number(profile.marca_titulo_tamanho) <= titleSizeMax ? Number(profile.marca_titulo_tamanho) : defaultTitleSize %>"
              class="js-title-size mt-3 w-full accent-emerald-500" />
          </div>

          <div class="mt-5 overflow-hidden rounded-xl border border-slate-700 bg-gradient-to-br from-slate-700 via-slate-900 to-black p-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Prévia do título</p>
            <p id="title-preview" class="mt-3 text-center text-2xl font-black uppercase leading-tight text-white">
              Título da notícia em destaque
            </p>
          </div>
        </div>

        <div class="mt-7 border-t border-slate-800 pt-6">
          <h3 class="text-sm font-semibold text-white">Modelos da arte (imagem)</h3>
          <p class="mt-1 text-xs text-slate-500">
            Escolha até <strong class="font-medium text-slate-300">2 modelos</strong>: o principal (padrão) e um secundário opcional.
            No editor da matéria você troca entre eles sem voltar aqui.
          </p>

          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-emerald-400/90">Principal</p>
          <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            <% artModels.forEach((model) => { %>
              <label class="cursor-pointer" title="<%= model.description %>">
                <input type="radio" name="marca_modelo_arte_ui" value="<%= model.id %>" class="peer sr-only js-modelo-arte"
                  <%= (profile.marca_modelo_arte || defaultArtModel) === model.id ? 'checked' : '' %> />
                <span class="block overflow-hidden rounded-xl border-2 border-slate-600 bg-slate-950 transition peer-checked:border-emerald-400 peer-checked:ring-2 peer-checked:ring-emerald-400/25 hover:border-slate-400">
                  <img src="/minha-marca/preview/<%= model.id %>.png?v=<%= previewVersion %>"
                    alt="Prévia do modelo <%= model.name %>" width="432" height="540" loading="lazy" decoding="async"
                    class="block aspect-[4/5] w-full bg-slate-900 object-cover" />
                  <span class="block border-t border-slate-700 px-2 py-1.5">
                    <span class="block truncate text-center text-xs font-semibold text-white"><%= model.name %></span>
                  </span>
                </span>
              </label>
            <% }) %>
          </div>

          <% const secAtual = profile.marca_modelo_arte_secundario || ''; %>
          <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-sky-400/90">Secundário <span class="font-normal text-slate-500">(opcional)</span></p>
          <p class="mt-1 text-[11px] text-slate-500">Aparece junto do principal no editor da matéria para troca rápida.</p>
          <div class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            <label class="cursor-pointer" title="Sem modelo secundário">
              <input type="radio" name="marca_modelo_arte_sec_ui" value="" class="peer sr-only js-modelo-arte-sec"
                <%= !secAtual ? 'checked' : '' %> />
              <span class="flex aspect-[4/5] flex-col items-center justify-center rounded-xl border-2 border-slate-600 bg-slate-950 px-2 text-center transition peer-checked:border-sky-400 peer-checked:ring-2 peer-checked:ring-sky-400/25 hover:border-slate-400">
                <span class="text-xs font-semibold text-slate-300">Nenhum</span>
                <span class="mt-1 text-[10px] text-slate-500">Só o principal</span>
              </span>
            </label>
            <% artModels.forEach((model) => { %>
              <label class="cursor-pointer js-sec-model-label" data-model-id="<%= model.id %>" title="<%= model.description %>">
                <input type="radio" name="marca_modelo_arte_sec_ui" value="<%= model.id %>" class="peer sr-only js-modelo-arte-sec"
                  <%= secAtual === model.id ? 'checked' : '' %> />
                <span class="block overflow-hidden rounded-xl border-2 border-slate-600 bg-slate-950 transition peer-checked:border-sky-400 peer-checked:ring-2 peer-checked:ring-sky-400/25 hover:border-slate-400">
                  <img src="/minha-marca/preview/<%= model.id %>.png?v=<%= previewVersion %>"
                    alt="Prévia secundário <%= model.name %>" width="432" height="540" loading="lazy" decoding="async"
                    class="block aspect-[4/5] w-full bg-slate-900 object-cover" />
                  <span class="block border-t border-slate-700 px-2 py-1.5">
                    <span class="block truncate text-center text-xs font-semibold text-white"><%= model.name %></span>
                  </span>
                </span>
              </label>
            <% }) %>
          </div>

          <div class="mt-5 rounded-xl border border-red-500/25 bg-red-500/5 px-4 py-3 text-xs leading-relaxed text-slate-400">
            <strong class="block font-semibold text-slate-300">Modelo “Urgente alerta”</strong>
            A faixa do topo usa o campo <span class="text-slate-300">Categoria</span> (ex.: <span class="text-slate-300">URGENTE!</span>).
            No título da matéria, use <code class="text-yellow-300">[[palavra]]</code> para pintar na cor principal e
            <code class="text-red-300">((frase))</code> para criar a faixa vermelha.
            <span class="mt-1.5 block text-slate-500">
              Ex.: <span class="text-slate-300">[[Vaza reação]] dentro do STF ((e revela suspeita de articulação)) para “afastar” [[Mendonça]]</span>
            </span>
          </div>

          <p class="mt-3 text-[11px] text-slate-500">
            Clique em um modelo para escolhê-lo e abrir a
            <strong class="font-medium text-slate-400">personalização</strong> — tamanho da fonte, cores, degradê,
            escurecimento e tamanho da foto valem só para aquele modelo.
          </p>

          <!-- Painel de personalização por modelo -->
          <div id="modelo-config-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-3 backdrop-blur-sm">
            <div class="max-h-[92vh] w-full max-w-4xl overflow-y-auto rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl">
              <div class="sticky top-0 flex items-center justify-between gap-3 border-b border-slate-800 bg-slate-900/95 px-4 py-3 backdrop-blur">
                <div class="min-w-0">
                  <p class="text-[10px] font-semibold uppercase tracking-wider text-emerald-400/90">Personalizar modelo</p>
                  <h4 id="modelo-config-nome" class="truncate text-sm font-semibold text-white">—</h4>
                </div>
                <button type="button" id="modelo-config-fechar"
                  class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:border-slate-500 hover:text-white">
                  Fechar
                </button>
              </div>

              <div class="grid gap-4 p-4 md:grid-cols-[300px_minmax(0,1fr)]">
                <div>
                  <div class="relative overflow-hidden rounded-xl border border-slate-700 bg-slate-950">
                    <img id="modelo-config-preview" alt="Prévia do modelo" class="block aspect-[4/5] w-full object-cover" />
                    <span id="modelo-config-carregando" class="absolute inset-0 hidden items-center justify-center bg-slate-950/60 text-xs text-slate-300">
                      gerando prévia…
                    </span>
                  </div>
                  <p class="mt-1.5 text-[11px] text-slate-500">A prévia usa o gerador real da arte.</p>
                </div>

                <div class="space-y-4">
                  <label class="block">
                    <span class="flex items-center justify-between text-xs text-slate-400">
                      <span>Tamanho da fonte do título</span>
                      <span class="font-semibold text-white"><span id="cfg-tamanho-valor">43</span>px</span>
                    </span>
                    <input id="cfg-tamanho" type="range" min="<%= typeof titleSizeMin !== 'undefined' ? titleSizeMin : 30 %>" max="<%= typeof titleSizeMax !== 'undefined' ? titleSizeMax : 50 %>" step="1" class="mt-1.5 w-full accent-emerald-500" />
                  </label>

                  <label id="cfg-titulo-espaco-wrap" class="hidden block rounded-lg border border-amber-500/25 bg-amber-500/10 p-3">
                    <span class="flex items-center justify-between text-xs text-amber-100">
                      <span>Espaço entre a faixa da logo e o título</span>
                      <span class="font-semibold text-white"><span id="cfg-titulo-espaco-valor"><%= typeof jmTitleGapDefault !== 'undefined' ? jmTitleGapDefault : 18 %></span>px</span>
                    </span>
                    <input id="cfg-titulo-espaco" type="range"
                      min="<%= typeof jmTitleGapMin !== 'undefined' ? jmTitleGapMin : 0 %>"
                      max="<%= typeof jmTitleGapMax !== 'undefined' ? jmTitleGapMax : 140 %>"
                      step="1"
                      value="<%= typeof jmTitleGapDefault !== 'undefined' ? jmTitleGapDefault : 18 %>"
                      class="mt-1.5 w-full accent-amber-400" />
                    <span class="mt-1 block text-[11px] text-slate-500">Diminua para aproximar a manchete do retângulo JM Notícia.</span>
                  </label>

                  <label id="cfg-painel-largura-wrap" class="hidden block rounded-lg border border-sky-500/25 bg-sky-500/10 p-3">
                    <span class="flex items-center justify-between text-xs text-sky-100">
                      <span>Largura do painel</span>
                      <span class="font-semibold text-white"><span id="cfg-painel-largura-valor"><%= typeof painelWidthDefault !== 'undefined' ? painelWidthDefault : 92 %></span>%</span>
                    </span>
                    <input id="cfg-painel-largura" type="range"
                      min="<%= typeof painelWidthMin !== 'undefined' ? painelWidthMin : 80 %>"
                      max="<%= typeof painelWidthMax !== 'undefined' ? painelWidthMax : 100 %>"
                      step="1"
                      value="<%= typeof painelWidthDefault !== 'undefined' ? painelWidthDefault : 92 %>"
                      class="mt-1.5 w-full accent-sky-400" />
                    <span class="mt-1 block text-[11px] text-slate-500">Ajusta somente a largura do bloco azul do Painel premium.</span>
                  </label>

                  <label id="cfg-painel-altura-wrap" class="hidden block rounded-lg border border-sky-500/25 bg-sky-500/10 p-3">
                    <span class="flex items-center justify-between text-xs text-sky-100">
                      <span>Altura do painel</span>
                      <span class="font-semibold text-white"><span id="cfg-painel-altura-valor"><%= typeof painelHeightDefault !== 'undefined' ? painelHeightDefault : 27 %></span>%</span>
                    </span>
                    <input id="cfg-painel-altura" type="range"
                      min="<%= typeof painelHeightMin !== 'undefined' ? painelHeightMin : 22 %>"
                      max="<%= typeof painelHeightMax !== 'undefined' ? painelHeightMax : 40 %>"
                      step="1"
                      value="<%= typeof painelHeightDefault !== 'undefined' ? painelHeightDefault : 27 %>"
                      class="mt-1.5 w-full accent-sky-400" />
                    <span class="mt-1 block text-[11px] text-slate-500">Diminua para deixar o bloco azul mais baixo.</span>
                  </label>

                  <label class="block">
                    <span class="flex items-center justify-between text-xs text-slate-400">
                      <span>Tamanho da foto (zoom)</span>
                      <span class="font-semibold text-white"><span id="cfg-zoom-valor">100</span>%</span>
                    </span>
                    <input id="cfg-zoom" type="range" min="<%= typeof zoomMin !== 'undefined' ? zoomMin : 80 %>" max="<%= typeof zoomMax !== 'undefined' ? zoomMax : 140 %>" step="1" class="mt-1.5 w-full accent-emerald-500" />
                    <span class="mt-1 block text-[11px] text-slate-500">Acima de 100% aproxima a foto; abaixo, mostra mais.</span>
                  </label>

                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class="block">
                      <span class="text-xs text-slate-400">Cor principal</span>
                      <div class="mt-1.5 flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-950 p-2">
                        <input id="cfg-cor1" type="color" class="h-8 w-full cursor-pointer border-0 bg-transparent" />
                      </div>
                    </label>
                    <label class="block">
                      <span class="text-xs text-slate-400">Cor secundária</span>
                      <div class="mt-1.5 flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-950 p-2">
                        <input id="cfg-cor2" type="color" class="h-8 w-full cursor-pointer border-0 bg-transparent" />
                      </div>
                    </label>
                  </div>

                  <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2">
                    <input id="cfg-degrade" type="checkbox" class="mt-0.5 rounded border-slate-600 bg-slate-950 text-emerald-500 focus:ring-emerald-500/30" />
                    <span class="text-xs leading-snug text-slate-300">
                      Degradê nas faixas
                      <span class="block text-[11px] text-slate-500">Ligado: principal → secundária. Desligado: só a cor principal.</span>
                    </span>
                  </label>

                  <div>
                    <span class="text-xs text-slate-400">Escurecimento sobre a foto</span>
                    <div class="mt-1.5 inline-flex rounded-lg border border-slate-700 bg-slate-950 p-0.5">
                      <% (typeof sombraOptions !== 'undefined' ? sombraOptions : []).forEach(function (s) { %>
                        <button type="button" data-cfg-sombra="<%= s.id %>" class="cfg-sombra-btn rounded-md px-3 py-1.5 text-xs text-slate-300 hover:text-white"><%= s.name %></button>
                      <% }) %>
                    </div>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-2">
                    <label class="block">
                      <span class="text-xs text-slate-400">Cor do título</span>
                      <select id="cfg-titulo-cor" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none">
                        <% (typeof titleColors !== 'undefined' ? titleColors : []).forEach(function (c) { %>
                          <option value="<%= c.id %>"><%= c.name %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label class="block">
                      <span class="text-xs text-slate-400">Fonte do título</span>
                      <select id="cfg-fonte" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none">
                        <% (typeof brandFonts !== 'undefined' ? brandFonts : []).forEach(function (f) { %>
                          <option value="<%= f.id %>"><%= f.name %></option>
                        <% }) %>
                      </select>
                    </label>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 border-t border-slate-800 pt-3">
                    <button type="button" id="cfg-salvar" class="rounded-lg bg-emerald-500 px-4 py-2 text-xs font-semibold text-slate-950 hover:bg-emerald-400">
                      Salvar personalização
                    </button>
                    <button type="button" id="cfg-restaurar" class="rounded-lg border border-slate-700 px-3 py-2 text-xs text-slate-300 hover:border-rose-500/60 hover:text-rose-200">
                      Restaurar padrão da marca
                    </button>
                    <span id="cfg-status" class="text-xs text-slate-400"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-3 rounded-xl border border-amber-500/25 bg-amber-500/5 px-4 py-3 text-xs leading-relaxed text-slate-400">
            <strong class="block font-semibold text-slate-300">Modelo “JM”</strong>
            Foto ocupando a arte inteira, faixa com a sua logo sobre a foto e manchete branca em caixa alta.
            O rodapé usa o campo <span class="text-slate-300">Rodapé</span> (ex.:
            <span class="text-slate-300">JMNOTICIA.COM.BR</span>) na <span class="text-slate-300">cor principal</span>.
            No título, use <code class="text-amber-300">[[palavra]]</code> para destacar um trecho na cor principal — sem
            marcação, o sistema destaca sozinho o nome ou a informação central.
            <span class="mt-1.5 block text-slate-500">
              Ex.: <span class="text-slate-300">Eduardo Gomes reúne [[movimento pró-Flávio Bolsonaro]] e prevê vitória da direita</span>
            </span>
          </div>
        </div>
        <% } else { %>
        <div class="mt-7 border-t border-slate-800 pt-6">
          <h3 class="text-sm font-semibold text-white">Modelo para vídeo / Reels</h3>
          <p class="mt-1 text-xs text-slate-500">
            Estilo do texto fixo na tela dividida (depois da capa). Independente do modelo de arte das imagens.
          </p>

          <label class="mt-4 block max-w-xs">
            <span class="text-sm text-slate-400">Cor dos destaques</span>
            <div class="mt-1.5 flex gap-2 rounded-lg border border-slate-700 bg-slate-950 p-2">
              <input type="color" name="marca_video_cor_destaque" id="video-cor-destaque" value="<%= videoCorDestaque %>" class="h-8 w-full cursor-pointer border-0 bg-transparent" />
            </div>
            <span class="mt-1 block text-xs text-slate-500">Caixas atrás das palavras marcadas com [[assim]].</span>
          </label>

          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <% videoBrandModels.forEach((model) => { %>
              <label class="cursor-pointer" title="<%= model.description %>">
                <input type="radio" name="marca_video_modelo_ui" value="<%= model.id %>" class="peer sr-only js-modelo-video"
                  <%= videoModeloAtual === model.id ? 'checked' : '' %> />
                <span class="block overflow-hidden rounded-xl border-2 border-slate-600 bg-slate-950 transition peer-checked:border-fuchsia-400 peer-checked:ring-2 peer-checked:ring-fuchsia-400/25 hover:border-slate-400">
                  <span class="relative flex aspect-[9/16] max-h-[220px] flex-col overflow-hidden bg-gradient-to-br from-slate-700 via-slate-900 to-black">
                    <span class="absolute inset-y-0 left-0 w-1/2 bg-slate-800/80"></span>
                    <span class="absolute inset-y-0 right-0 w-1/2 bg-slate-600/40"></span>
                    <span class="absolute inset-y-0 left-1/2 w-px bg-white/20"></span>
                    <% if (model.id === 'faixa_rodape') { %>
                      <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-black/40 px-2 py-2">
                        <span class="block text-center text-[9px] font-black uppercase leading-tight text-white">Título do reel em destaque</span>
                      </span>
                    <% } else if (model.id === 'faixa_topo') { %>
                      <span class="absolute inset-x-0 top-0 bg-gradient-to-b from-black/90 to-black/40 px-2 py-2">
                        <span class="block text-center text-[9px] font-black uppercase leading-tight text-white">Título do reel em destaque</span>
                      </span>
                    <% } else if (model.id === 'destaque_viral') { %>
                      <span class="absolute bottom-3 left-2 right-[42%] space-y-1 text-left">
                        <span class="block text-[8px] font-black uppercase leading-tight text-white drop-shadow">Sabe por que o livro</span>
                        <span class="inline-block px-1 text-[8px] font-black uppercase leading-tight text-slate-950" style="background:<%= videoCorDestaque %>">secreto</span>
                        <span class="block text-[8px] font-black uppercase leading-tight text-white drop-shadow">de <span class="inline-block px-0.5 text-slate-950" style="background:<%= videoCorDestaque %>">enoque</span> não está na</span>
                        <span class="inline-block px-1 text-[8px] font-black uppercase leading-tight text-slate-950" style="background:<%= videoCorDestaque %>">bíblia?</span>
                      </span>
                    <% } else { %>
                      <span class="absolute inset-x-4 bottom-6 rounded-lg bg-black/75 px-2 py-2 text-center">
                        <span class="block text-[8px] font-black uppercase leading-tight text-white">Título com <span class="inline-block px-0.5 text-slate-950" style="background:<%= videoCorDestaque %>">destaque</span></span>
                      </span>
                    <% } %>
                  </span>
                  <span class="block border-t border-slate-700 px-2 py-2">
                    <span class="block text-xs font-semibold text-white"><%= model.name %></span>
                    <span class="mt-0.5 block text-[10px] leading-snug text-slate-500"><%= model.description %></span>
                  </span>
                </span>
              </label>
            <% }) %>
          </div>

          <div class="mt-5 rounded-xl border border-fuchsia-500/20 bg-fuchsia-500/5 px-4 py-3 text-xs leading-relaxed text-slate-400">
            No editor do corte, use <code class="text-fuchsia-300">[[palavra]]</code> no texto da tela dividida para pintar a caixa.
            Ex.: <span class="text-slate-300">SABE POR QUE O LIVRO [[SECRETO]] DE [[ENOQUE]] NÃO ESTÁ NA [[BÍBLIA?]]</span>
          </div>
        </div>
        <% } %>

        <% if (profile.logo_path) { %>
          <label data-remove-logo class="mt-5 flex cursor-pointer items-start gap-3 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-sm text-rose-200">
            <input id="remove-logo-input" type="checkbox" name="remover_logo" value="1" class="mt-0.5 rounded border-rose-400/50 bg-slate-950 text-rose-500" />
            <span><strong class="block font-semibold">Remover logomarca</strong><span class="mt-0.5 block text-xs text-slate-400">Ao salvar, a logo atual será apagada.</span></span>
          </label>
        <% } %>

        <div class="mt-6 flex justify-end">
          <button type="submit" class="rounded-lg <%= activeTab === 'video' ? 'bg-fuchsia-500 hover:bg-fuchsia-400 text-white' : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950' %> px-5 py-2.5 text-sm font-semibold">
            Salvar <%= activeTab === 'video' ? 'marca de vídeo' : 'identidade visual' %>
          </button>
        </div>
      </section>

      <aside class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
        <% if (activeTab === 'imagem') { %>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Prévia da logo</p>
          <div class="mt-4 flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl border border-slate-700 bg-gradient-to-br from-slate-800 to-slate-950 p-6">
            <img id="logo-preview" src="<%= profile.logo_path ? '/media/' + profile.logo_path.replace(/\\/g, '/') : '' %>" alt="Prévia da logomarca"
              class="<%= profile.logo_path ? '' : 'hidden' %> max-h-full max-w-full object-contain" />
            <p id="logo-empty" class="<%= profile.logo_path ? 'hidden' : '' %> text-center text-sm text-slate-500">Nenhuma logomarca configurada.</p>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-slate-500">Arte 4:5 para o feed. Vídeos usam a aba <strong class="text-slate-400">Marca para vídeo</strong>.</p>
        <% } else { %>
          <p class="text-xs font-semibold uppercase tracking-wider text-fuchsia-300">Prévia estilo vídeo</p>
          <div class="relative mt-4 mx-auto aspect-[9/16] w-full max-w-[220px] overflow-hidden rounded-xl border border-slate-700 bg-slate-950">
            <div class="absolute inset-y-0 left-0 w-1/2 bg-slate-800"></div>
            <div class="absolute inset-y-0 right-0 w-1/2 bg-gradient-to-br from-slate-600 to-slate-900"></div>
            <div class="absolute inset-y-0 left-1/2 w-px bg-white/20"></div>
            <div id="video-preview-overlay" class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-black/40 px-2 py-2">
              <p id="video-preview-text" class="text-center text-[10px] font-black uppercase leading-tight text-white">Título do reel</p>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-slate-500">Esse estilo entra no texto da tela dividida em <a href="/fila" class="text-fuchsia-300 hover:underline">/fila</a> → Revisar corte.</p>
        <% } %>
      </aside>
    </form>
  </main>

  <script>
    (function loadBrandFonts() {
      const href = <%- JSON.stringify(googleFontsHref || '') %>;
      if (!href) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    })();

    const activeTab = <%- JSON.stringify(activeTab) %>;
    const logoInput = document.getElementById('logo-input');
    const logoPreview = document.getElementById('logo-preview');
    const logoEmpty = document.getElementById('logo-empty');
    const removeLogoInput = document.getElementById('remove-logo-input');
    const brandNameInput = document.querySelector('input[name="marca_nome"]');
    const titlePreview = document.getElementById('title-preview');
    const currentLogoUrl = <%- JSON.stringify(profile.logo_path ? '/media/' + profile.logo_path.replace(/\\/g, '/') : '').replace(/</g, '\\u003c') %>;
    const brandFonts = <%- JSON.stringify(brandFonts).replace(/</g, '\\u003c') %>;
    const defaultTitleSize = <%= Number(defaultTitleSize) || 43 %>;
    const titleSizeInput = document.getElementById('title-size-input');
    const titleSizeValue = document.getElementById('title-size-value');
    const hiddenArte = document.getElementById('hidden-modelo-arte');
    const hiddenArteSec = document.getElementById('hidden-modelo-arte-sec');
    const hiddenVideo = document.getElementById('hidden-modelo-video');
    let previewObjectUrl = null;

    if (brandNameInput) {
      brandNameInput.required = false;
      brandNameInput.value = <%- JSON.stringify(profile.marca_nome || '').replace(/</g, '\\u003c') %>;
      brandNameInput.placeholder = 'Opcional — deixe vazio para não exibir nome';
    }

    const removeLogoCard = document.querySelector('[data-remove-logo]');
    if (removeLogoCard && logoInput) logoInput.closest('label').insertAdjacentElement('afterend', removeLogoCard);

    function syncSecundarioVsPrincipal() {
      const principal = hiddenArte?.value || '';
      document.querySelectorAll('.js-sec-model-label').forEach((label) => {
        const id = label.getAttribute('data-model-id');
        const input = label.querySelector('input');
        const same = id === principal;
        label.classList.toggle('opacity-40', same);
        label.classList.toggle('pointer-events-none', same);
        if (input) {
          input.disabled = same;
          if (same && input.checked) {
            const none = document.querySelector('.js-modelo-arte-sec[value=""]');
            if (none) none.checked = true;
            if (hiddenArteSec) hiddenArteSec.value = '';
          }
        }
      });
    }

    document.querySelectorAll('.js-modelo-arte').forEach((el) => {
      el.addEventListener('change', () => {
        if (el.checked && hiddenArte) hiddenArte.value = el.value;
        syncSecundarioVsPrincipal();
      });
    });
    document.querySelectorAll('.js-modelo-arte-sec').forEach((el) => {
      el.addEventListener('change', () => {
        if (el.checked && hiddenArteSec) hiddenArteSec.value = el.value || '';
      });
    });
    syncSecundarioVsPrincipal();

    document.querySelectorAll('.js-modelo-video').forEach((el) => {
      el.addEventListener('change', () => {
        if (el.checked && hiddenVideo) hiddenVideo.value = el.value;
        updateVideoPreview();
      });
    });

    function selectedValue(name) {
      const el = document.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : null;
    }

    function resolvePreviewColor(colorId) {
      const primary = document.querySelector('input[name="marca_cor_primaria"]')?.value || '#ffbd59';
      const secondary = document.querySelector('input[name="marca_cor_secundaria"]')?.value || '#fb923c';
      if (colorId === 'primaria') return primary;
      if (colorId === 'secundaria') return secondary;
      if (colorId === 'preto') return '#111827';
      if (colorId === 'amarelo') return '#ffbd59';
      if (colorId === 'laranja') return '#fb923c';
      return '#ffffff';
    }

    function updateTitlePreview() {
      if (!titlePreview) return;
      const fontId = selectedValue('marca_fonte') || 'serithai_condensed';
      const colorId = selectedValue('marca_titulo_cor') || 'branco';
      const sizePx = Number(titleSizeInput?.value) || defaultTitleSize;
      const font = brandFonts.find((f) => f.id === fontId) || brandFonts[0];
      if (titleSizeValue) titleSizeValue.textContent = String(sizePx);
      titlePreview.style.fontFamily = font.cssFamily;
      titlePreview.style.fontWeight = String(font.previewWeight || 900);
      titlePreview.style.color = resolvePreviewColor(colorId);
      titlePreview.style.fontSize = Math.max(18, Math.round(sizePx * 0.7)) + 'px';
    }

    function updateVideoPreview() {
      const overlay = document.getElementById('video-preview-overlay');
      const textEl = document.getElementById('video-preview-text');
      if (!overlay || !textEl) return;
      const model = selectedValue('marca_video_modelo_ui') || hiddenVideo?.value || 'faixa_rodape';
      const highlight = document.getElementById('video-cor-destaque')?.value || '#facc15';
      if (model === 'faixa_topo') {
        overlay.className = 'absolute inset-x-0 top-0 bg-gradient-to-b from-black/90 to-black/40 px-2 py-2';
        textEl.innerHTML = 'Título do reel';
        textEl.className = 'text-center text-[10px] font-black uppercase leading-tight text-white';
      } else if (model === 'destaque_viral') {
        overlay.className = 'absolute bottom-3 left-2 right-[40%] space-y-1 text-left bg-transparent';
        textEl.innerHTML =
          'Sabe por que o livro <span style="background:' + highlight + ';color:#0f172a" class="px-0.5">secreto</span> de <span style="background:' + highlight + ';color:#0f172a" class="px-0.5">enoque</span> não está na <span style="background:' + highlight + ';color:#0f172a" class="px-0.5">bíblia?</span>';
        textEl.className = 'text-left text-[9px] font-black uppercase leading-snug text-white drop-shadow';
      } else if (model === 'impacto_central') {
        overlay.className = 'absolute inset-x-3 bottom-6 rounded-lg bg-black/75 px-2 py-2 text-center';
        textEl.innerHTML = 'Título com <span style="background:' + highlight + ';color:#0f172a" class="px-0.5">destaque</span>';
        textEl.className = 'text-center text-[10px] font-black uppercase leading-tight text-white';
      } else {
        overlay.className = 'absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-black/40 px-2 py-2';
        textEl.innerHTML = 'Título do reel';
        textEl.className = 'text-center text-[10px] font-black uppercase leading-tight text-white';
      }
    }

    document.querySelectorAll('.js-brand-font, .js-title-color').forEach((el) => {
      el.addEventListener('change', updateTitlePreview);
    });
    titleSizeInput?.addEventListener('input', updateTitlePreview);
    document.querySelectorAll('input[name="marca_cor_primaria"], input[name="marca_cor_secundaria"]').forEach((el) => {
      el.addEventListener('input', updateTitlePreview);
    });
    document.getElementById('video-cor-destaque')?.addEventListener('input', updateVideoPreview);
    if (activeTab === 'imagem') updateTitlePreview();
    if (activeTab === 'video') updateVideoPreview();

    function releaseLogoPreview() {
      if (previewObjectUrl) URL.revokeObjectURL(previewObjectUrl);
      previewObjectUrl = null;
    }

    function showLogo(src) {
      if (!logoPreview) return;
      logoPreview.src = src;
      logoPreview.classList.remove('hidden');
      logoEmpty?.classList.add('hidden');
    }

    function showNoLogo(message) {
      if (!logoPreview) return;
      logoPreview.removeAttribute('src');
      logoPreview.classList.add('hidden');
      if (logoEmpty) {
        logoEmpty.textContent = message;
        logoEmpty.classList.remove('hidden');
      }
    }

    logoInput?.addEventListener('change', () => {
      releaseLogoPreview();
      const file = logoInput.files && logoInput.files[0];
      if (!file) {
        if (removeLogoInput?.checked) showNoLogo('A logomarca será removida ao salvar.');
        else if (currentLogoUrl) showLogo(currentLogoUrl);
        else showNoLogo('Nenhuma logomarca configurada.');
        return;
      }
      if (removeLogoInput) removeLogoInput.checked = false;
      previewObjectUrl = URL.createObjectURL(file);
      showLogo(previewObjectUrl);
    });

    removeLogoInput?.addEventListener('change', () => {
      releaseLogoPreview();
      if (removeLogoInput.checked) {
        if (logoInput) logoInput.value = '';
        showNoLogo('A logomarca será removida ao salvar.');
      } else if (currentLogoUrl) showLogo(currentLogoUrl);
      else showNoLogo('Nenhuma logomarca configurada.');
    });

    window.addEventListener('beforeunload', releaseLogoPreview);
  
    // ---- Personalização por modelo (clicar no modelo abre o painel) --------
    const modelConfigs = <%- JSON.stringify(typeof modelConfigs !== 'undefined' ? modelConfigs : {}) %>;
    const artModelsMeta = <%- JSON.stringify(artModels) %>;
    const marcaPadrao = {
      tamanho: <%= Number(profile.marca_titulo_tamanho) || (Number(defaultTitleSize) || 43) %>,
      cor1: <%- JSON.stringify(profile.marca_cor_primaria || '#ffbd59') %>,
      cor2: <%- JSON.stringify(profile.marca_cor_secundaria || '#fb923c') %>,
      tituloCor: <%- JSON.stringify(profile.marca_titulo_cor || defaultTitleColor) %>,
      fonte: <%- JSON.stringify(profile.marca_fonte || defaultBrandFont) %>,
      zoom: <%= Number(typeof zoomDefault !== 'undefined' ? zoomDefault : 100) %>,
      tituloEspaco: <%= Number(typeof jmTitleGapDefault !== 'undefined' ? jmTitleGapDefault : 18) %>,
      painelLargura: <%= Number(typeof painelWidthDefault !== 'undefined' ? painelWidthDefault : 92) %>,
      painelAltura: <%= Number(typeof painelHeightDefault !== 'undefined' ? painelHeightDefault : 27) %>,
    };

    const cfgModal = document.getElementById('modelo-config-modal');
    const cfgNome = document.getElementById('modelo-config-nome');
    const cfgPreview = document.getElementById('modelo-config-preview');
    const cfgCarregando = document.getElementById('modelo-config-carregando');
    const cfgTamanho = document.getElementById('cfg-tamanho');
    const cfgTamanhoValor = document.getElementById('cfg-tamanho-valor');
    const cfgTituloEspacoWrap = document.getElementById('cfg-titulo-espaco-wrap');
    const cfgTituloEspaco = document.getElementById('cfg-titulo-espaco');
    const cfgTituloEspacoValor = document.getElementById('cfg-titulo-espaco-valor');
    const cfgPainelLarguraWrap = document.getElementById('cfg-painel-largura-wrap');
    const cfgPainelLargura = document.getElementById('cfg-painel-largura');
    const cfgPainelLarguraValor = document.getElementById('cfg-painel-largura-valor');
    const cfgPainelAlturaWrap = document.getElementById('cfg-painel-altura-wrap');
    const cfgPainelAltura = document.getElementById('cfg-painel-altura');
    const cfgPainelAlturaValor = document.getElementById('cfg-painel-altura-valor');
    const cfgZoom = document.getElementById('cfg-zoom');
    const cfgZoomValor = document.getElementById('cfg-zoom-valor');
    const cfgCor1 = document.getElementById('cfg-cor1');
    const cfgCor2 = document.getElementById('cfg-cor2');
    const cfgDegrade = document.getElementById('cfg-degrade');
    const cfgTituloCor = document.getElementById('cfg-titulo-cor');
    const cfgFonte = document.getElementById('cfg-fonte');
    const cfgSalvar = document.getElementById('cfg-salvar');
    const cfgRestaurar = document.getElementById('cfg-restaurar');
    const cfgStatus = document.getElementById('cfg-status');
    let cfgModeloAtual = null;
    let cfgSombra = 'media';
    let cfgTimer = null;

    function cfgSetStatus(texto, erro) {
      if (!cfgStatus) return;
      cfgStatus.textContent = texto || '';
      cfgStatus.className = 'text-xs ' + (erro ? 'text-rose-300' : 'text-emerald-300');
    }

    function cfgSyncSombra() {
      document.querySelectorAll('.cfg-sombra-btn').forEach(function (btn) {
        const ativo = btn.dataset.cfgSombra === cfgSombra;
        btn.className =
          'cfg-sombra-btn rounded-md px-3 py-1.5 text-xs ' +
          (ativo ? 'bg-emerald-500 font-semibold text-slate-950' : 'text-slate-300 hover:text-white');
      });
    }

    function cfgValores() {
      return {
        tamanho: Number(cfgTamanho && cfgTamanho.value) || marcaPadrao.tamanho,
        tituloEspaco: Number(cfgTituloEspaco && cfgTituloEspaco.value),
        painelLargura: Number(cfgPainelLargura && cfgPainelLargura.value) || marcaPadrao.painelLargura,
        painelAltura: Number(cfgPainelAltura && cfgPainelAltura.value) || marcaPadrao.painelAltura,
        zoom: Number(cfgZoom && cfgZoom.value) || marcaPadrao.zoom,
        cor1: (cfgCor1 && cfgCor1.value) || marcaPadrao.cor1,
        cor2: (cfgCor2 && cfgCor2.value) || marcaPadrao.cor2,
        degrade: cfgDegrade ? cfgDegrade.checked : true,
        sombra: cfgSombra,
        tituloCor: (cfgTituloCor && cfgTituloCor.value) || marcaPadrao.tituloCor,
        fonte: (cfgFonte && cfgFonte.value) || marcaPadrao.fonte,
      };
    }

    function cfgAtualizarPreview() {
      if (!cfgModeloAtual || !cfgPreview) return;
      const v = cfgValores();
      const q = new URLSearchParams({
        tamanho: String(v.tamanho),
        tituloEspaco: String(v.tituloEspaco),
        painelLargura: String(v.painelLargura),
        painelAltura: String(v.painelAltura),
        zoom: String(v.zoom),
        cor1: v.cor1,
        cor2: v.cor2,
        degrade: v.degrade ? '1' : '0',
        sombra: v.sombra,
        tituloCor: v.tituloCor,
        fonte: v.fonte,
        t: String(Date.now()),
      });
      if (cfgCarregando) {
        cfgCarregando.classList.remove('hidden');
        cfgCarregando.classList.add('flex');
      }
      cfgPreview.onload = function () {
        if (!cfgCarregando) return;
        cfgCarregando.classList.add('hidden');
        cfgCarregando.classList.remove('flex');
      };
      cfgPreview.onerror = cfgPreview.onload;
      cfgPreview.src = '/minha-marca/preview/' + cfgModeloAtual + '.png?' + q.toString();
    }

    function cfgAgendarPreview() {
      if (cfgTimer) clearTimeout(cfgTimer);
      cfgTimer = setTimeout(cfgAtualizarPreview, 280);
    }

    function cfgAbrir(modeloId) {
      const meta = artModelsMeta.find(function (m) { return m.id === modeloId; });
      if (!meta || !cfgModal) return;
      cfgModeloAtual = modeloId;
      const salvo = modelConfigs[modeloId] || {};
      if (cfgNome) cfgNome.textContent = meta.name;
      if (cfgTamanho) cfgTamanho.value = salvo.tituloTamanho != null ? salvo.tituloTamanho : marcaPadrao.tamanho;
      if (cfgTituloEspaco) cfgTituloEspaco.value = salvo.tituloEspaco != null ? salvo.tituloEspaco : marcaPadrao.tituloEspaco;
      if (cfgTituloEspacoWrap) cfgTituloEspacoWrap.classList.toggle('hidden', modeloId !== 'jm');
      if (cfgPainelLargura) cfgPainelLargura.value = salvo.painelLargura != null ? salvo.painelLargura : marcaPadrao.painelLargura;
      if (cfgPainelLarguraWrap) cfgPainelLarguraWrap.classList.toggle('hidden', modeloId !== 'painel_premium');
      if (cfgPainelAltura) cfgPainelAltura.value = salvo.painelAltura != null ? salvo.painelAltura : marcaPadrao.painelAltura;
      if (cfgPainelAlturaWrap) cfgPainelAlturaWrap.classList.toggle('hidden', modeloId !== 'painel_premium');
      if (cfgZoom) cfgZoom.value = salvo.zoom != null ? salvo.zoom : marcaPadrao.zoom;
      if (cfgCor1) cfgCor1.value = salvo.corPrimaria || marcaPadrao.cor1;
      if (cfgCor2) cfgCor2.value = salvo.corSecundaria || marcaPadrao.cor2;
      if (cfgDegrade) cfgDegrade.checked = salvo.degrade !== false;
      if (cfgTituloCor) cfgTituloCor.value = salvo.tituloCor || marcaPadrao.tituloCor;
      if (cfgFonte) cfgFonte.value = salvo.fonte || marcaPadrao.fonte;
      cfgSombra = salvo.sombra || 'media';
      if (cfgTamanhoValor && cfgTamanho) cfgTamanhoValor.textContent = String(cfgTamanho.value);
      if (cfgTituloEspacoValor && cfgTituloEspaco) cfgTituloEspacoValor.textContent = String(cfgTituloEspaco.value);
      if (cfgPainelLarguraValor && cfgPainelLargura) cfgPainelLarguraValor.textContent = String(cfgPainelLargura.value);
      if (cfgPainelAlturaValor && cfgPainelAltura) cfgPainelAlturaValor.textContent = String(cfgPainelAltura.value);
      if (cfgZoomValor && cfgZoom) cfgZoomValor.textContent = String(cfgZoom.value);
      cfgSyncSombra();
      cfgSetStatus('');
      cfgModal.classList.remove('hidden');
      cfgModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      cfgAtualizarPreview();
    }

    function cfgFechar() {
      if (!cfgModal) return;
      cfgModal.classList.add('hidden');
      cfgModal.classList.remove('flex');
      document.body.style.overflow = '';
      cfgModeloAtual = null;
    }

    const cfgBtnFechar = document.getElementById('modelo-config-fechar');
    if (cfgBtnFechar) cfgBtnFechar.addEventListener('click', cfgFechar);
    if (cfgModal) {
      cfgModal.addEventListener('click', function (e) {
        if (e.target === cfgModal) cfgFechar();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && cfgModal && !cfgModal.classList.contains('hidden')) cfgFechar();
    });

    if (cfgTamanho) {
      cfgTamanho.addEventListener('input', function () {
        if (cfgTamanhoValor) cfgTamanhoValor.textContent = cfgTamanho.value;
        cfgAgendarPreview();
      });
    }
    if (cfgTituloEspaco) {
      cfgTituloEspaco.addEventListener('input', function () {
        if (cfgTituloEspacoValor) cfgTituloEspacoValor.textContent = cfgTituloEspaco.value;
        cfgAgendarPreview();
      });
    }
    if (cfgPainelLargura) {
      cfgPainelLargura.addEventListener('input', function () {
        if (cfgPainelLarguraValor) cfgPainelLarguraValor.textContent = cfgPainelLargura.value;
        cfgAgendarPreview();
      });
    }
    if (cfgPainelAltura) {
      cfgPainelAltura.addEventListener('input', function () {
        if (cfgPainelAlturaValor) cfgPainelAlturaValor.textContent = cfgPainelAltura.value;
        cfgAgendarPreview();
      });
    }
    if (cfgZoom) {
      cfgZoom.addEventListener('input', function () {
        if (cfgZoomValor) cfgZoomValor.textContent = cfgZoom.value;
        cfgAgendarPreview();
      });
    }
    [cfgCor1, cfgCor2, cfgTituloCor, cfgFonte, cfgDegrade].forEach(function (el) {
      if (el) el.addEventListener('change', cfgAgendarPreview);
    });
    document.querySelectorAll('.cfg-sombra-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        cfgSombra = btn.dataset.cfgSombra || 'media';
        cfgSyncSombra();
        cfgAtualizarPreview();
      });
    });

    function cfgEnviar(corpo, mensagem) {
      cfgSetStatus('Salvando...');
      const modelo = cfgModeloAtual;
      return fetch('/minha-marca/modelo-config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(corpo),
      })
        .then(function (res) {
          return res.json().then(function (data) {
            if (!res.ok) throw new Error(data.error || 'Falha ao salvar');
            return data;
          });
        })
        .then(function (data) {
          modelConfigs[modelo] = data.config || {};
          cfgSetStatus(mensagem);
          document
            .querySelectorAll('img[src*="/minha-marca/preview/' + modelo + '.png"]')
            .forEach(function (img) {
              img.src = '/minha-marca/preview/' + modelo + '.png?v=' + Date.now();
            });
        })
        .catch(function (err) {
          cfgSetStatus(err.message, true);
        });
    }

    if (cfgSalvar) {
      cfgSalvar.addEventListener('click', function () {
        if (!cfgModeloAtual) return;
        const v = cfgValores();
        cfgEnviar(
          {
            modelo: cfgModeloAtual,
            config: {
              tituloTamanho: v.tamanho,
              tituloEspaco: v.tituloEspaco,
              painelLargura: v.painelLargura,
              painelAltura: v.painelAltura,
              zoom: v.zoom,
              corPrimaria: v.cor1,
              corSecundaria: v.cor2,
              degrade: v.degrade,
              sombra: v.sombra,
              tituloCor: v.tituloCor,
              fonte: v.fonte,
            },
          },
          'Personalizacao salva'
        );
      });
    }

    if (cfgRestaurar) {
      cfgRestaurar.addEventListener('click', function () {
        if (!cfgModeloAtual) return;
        const modelo = cfgModeloAtual;
        cfgEnviar({ modelo: modelo, limpar: true }, 'Voltou ao padrao da marca').then(function () {
          cfgAbrir(modelo);
        });
      });
    }

    // Clicar no card do modelo escolhe E abre a personalizacao.
    document.querySelectorAll('.js-modelo-arte, .js-modelo-arte-sec').forEach(function (input) {
      const label = input.closest('label');
      if (!label) return;
      label.addEventListener('click', function () {
        const id = input.value;
        if (!id) return;
        setTimeout(function () { cfgAbrir(id); }, 60);
      });
    });

  </script>
<%- include('partials/app-end') %>
