<%- include('partials/app-start') %>
  <link rel="stylesheet" href="/css/dots.css?v=20261003e" />
<%
  const provider = String(typeof publishProvider !== 'undefined' ? publishProvider : 'auto').toLowerCase();
  const useAyrshare = provider === 'ayrshare' || (provider === 'auto' && Boolean(ayrshareConfigured));
%>

  <main class="dots-pagina pages-page mx-auto max-w-8xl px-4 py-6 sm:px-6 sm:py-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="dots-etiqueta">Configurações</p>
        <h1 class="dots-titulo mt-1">Páginas do Facebook</h1>
    <% if (useAyrshare) { %>
        <p class="dots-sub">
      Publicação via <strong class="font-medium text-emerald-300">Ayrshare</strong>.
      Um User Profile na Ayrshare = uma Página Facebook. Cole o <strong class="font-medium text-slate-300">Profile Key</strong> de cada profile.
        </p>
    <% } else { %>
        <p class="dots-sub">Conecte sua conta e vincule as páginas ao PostSyncer para publicar.</p>
    <% } %>
      </div>
    </header>

    <div id="alert" class="mt-4 hidden rounded-lg px-4 py-3 text-sm"></div>
    <%- include('partials/page-distribution', { mode: 'settings' }) %>

    <% if (useAyrshare) { %>
    <div class="mt-6 rounded-xl border border-emerald-800/50 bg-emerald-950/20 px-5 py-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-sm font-semibold text-white">Ayrshare</h2>
          <p class="mt-1 text-xs text-slate-400 leading-relaxed">
            1) Em
            <a href="https://app.ayrshare.com" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">app.ayrshare.com</a>
            crie um <strong class="font-medium text-slate-300">User Profile</strong> por Página FB e conecte a Página em Social Accounts.<br />
            2) Clique em <strong class="font-medium text-slate-300">Buscar perfis na Ayrshare</strong> ou adicione diretamente pelo Profile Key abaixo.<br />
            3) Atenção: em <em>Manage Profiles</em> aparece o <strong class="font-medium text-amber-300">RefId</strong>,
            que não substitui a chave. Para copiar o <strong class="font-medium text-slate-300">Profile Key</strong>,
            selecione o perfil na Ayrshare e abra a tela Profile Key. Cole a chave uma única vez no cadastro.<br />
            4) Sem Profile Key, o post iria para o <em>Primary Profile</em>; com mais de uma Página, o ViralizeAI bloqueia
            a publicação em vez de postar na Página errada.
          </p>
          <p class="mt-2 text-sm text-emerald-200/90">
            <%= ayrshareConfigured ? 'API Key configurada · PUBLISH_PROVIDER=' + provider : 'Configure AYRSHARE_API_KEY no .env' %>
          </p>
        </div>
        <a href="https://app.ayrshare.com" target="_blank" rel="noopener"
          class="rounded-lg border border-emerald-700/60 px-3 py-1.5 text-sm text-emerald-200 hover:border-emerald-400">
          Abrir Ayrshare
        </a>
      </div>
    </div>

    <section class="mt-6 rounded-xl border border-slate-800 bg-slate-900/40 px-5 py-4">
      <h2 class="text-sm font-semibold text-white">Adicionar página da Ayrshare</h2>
      <p class="mt-2 text-sm text-slate-400">Conectou uma página nova? Adicione aqui sem alterar o projeto. O nome e o destino serão identificados pelo Profile Key.</p>
      <% if (typeof user !== 'undefined' && user?.nivel_acesso === 'administrador') { %>
      <button type="button" id="ay-discover" class="mt-3 rounded-lg border border-emerald-700/60 px-3 py-1.5 text-sm text-emerald-200">Buscar perfis na Ayrshare</button>
      <p id="ay-discovery-status" role="status" class="mt-2 text-sm text-slate-400"></p>
      <div id="ay-discovery-results" class="mt-3 space-y-3"></div>
      <% } %>
      <form id="ay-add-page" class="mt-4 space-y-3">
        <p id="ay-selected-profile" class="text-sm text-emerald-200">Adicionar diretamente pelo Profile Key</p>
        <label class="block text-sm text-slate-300" for="ay-new-key">Profile Key da nova página</label>
        <input id="ay-new-key" type="password" required maxlength="128" autocomplete="off" placeholder="Cole o Profile Key, não o RefId" class="w-full rounded border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-200" />
        <button type="submit" class="rounded-lg border border-emerald-700/60 px-3 py-1.5 text-sm text-emerald-200">Adicionar página</button>
        <button type="button" id="ay-clear-selection" class="text-sm text-slate-400">Limpar seleção</button>
        <p id="ay-add-status" role="status" class="text-sm text-slate-300"></p>
      </form>
    </section>

    <div id="content" class="mt-8">
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-6 py-10 text-center">
        <p class="text-slate-300">Carregando…</p>
      </div>
    </div>
    <% } else { %>

    <div id="postsyncer-box" class="mt-6 rounded-xl border border-slate-800 bg-slate-900/40 px-5 py-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-sm font-semibold text-white">PostSyncer</h2>
          <p class="mt-1 text-xs text-slate-400">
            Conecte as Páginas em
            <a href="https://app.postsyncer.com" target="_blank" rel="noopener" class="text-sky-400 hover:underline">app.postsyncer.com</a>
            e clique em <strong class="font-medium text-slate-300">Sincronizar / vincular</strong>.
            O sistema importa as contas Facebook do PostSyncer para você publicar em todas elas.
          </p>
          <p id="ps-status" class="mt-2 text-sm text-slate-300">Carregando status…</p>
          <div id="ps-link-panel" class="mt-3 hidden"></div>
        </div>
        <div id="ps-actions" class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <div id="content" class="mt-8">
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-6 py-10 text-center">
        <p class="text-slate-300">Carregando…</p>
      </div>
    </div>
    <% } %>
  </main>

  <script>
    const alertEl = document.getElementById('alert');
    const contentEl = document.getElementById('content');
    const useAyrshare = <%= useAyrshare ? 'true' : 'false' %>;

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showAlert(msg, isError) {
      alertEl.textContent = msg;
      alertEl.className =
        'mt-4 rounded-lg border px-4 py-3 text-sm ' +
        (isError
          ? 'border-rose-500/30 bg-rose-500/10 text-rose-200'
          : 'border-emerald-500/30 bg-emerald-500/10 text-emerald-200');
    }

    <% if (useAyrshare) { %>
    let selectedRefId = '';
    let profileCursor = null;
    document.getElementById('ay-clear-selection').addEventListener('click', () => {
      selectedRefId = '';
      document.getElementById('ay-selected-profile').textContent = 'Adicionar diretamente pelo Profile Key';
      document.getElementById('ay-new-key').value = '';
    });
    document.getElementById('ay-discover')?.addEventListener('click', async (event) => {
      const btn = event.currentTarget;
      const status = document.getElementById('ay-discovery-status');
      const results = document.getElementById('ay-discovery-results');
      btn.disabled = true;
      status.textContent = 'Consultando perfis…';
      if (!profileCursor) results.replaceChildren();
      try {
        const response = await fetch('/api/facebook/ayrshare/profiles' + (profileCursor ? '?cursor=' + encodeURIComponent(profileCursor) : ''));
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Falha ao buscar perfis');
        for (const profile of data.profiles || []) {
          const row = document.createElement('div');
          row.className = 'rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300';
          const label = document.createElement('p');
          label.textContent = profile.title + (profile.facebook_connected ? ' · Facebook conectado' : ' · Conecte o Facebook em Social Accounts');
          row.append(label);
          if (profile.facebook_connected && profile.status === 'active') {
            const select = document.createElement('button');
            select.type = 'button';
            select.className = 'mt-2 text-emerald-300';
            select.textContent = 'Selecionar perfil';
            select.addEventListener('click', () => {
              selectedRefId = profile.ref_id;
              document.getElementById('ay-selected-profile').textContent = 'Perfil selecionado: ' + profile.title;
              document.getElementById('ay-new-key').value = '';
              document.getElementById('ay-new-key').focus();
            });
            row.append(select);
          }
          results.append(row);
        }
        profileCursor = data.next_cursor || null;
        btn.textContent = profileCursor ? 'Carregar mais perfis' : 'Atualizar perfis da Ayrshare';
        status.textContent = results.children.length ? 'Selecione o perfil e cole seu Profile Key abaixo. A Ayrshare não fornece as chaves nesta consulta.' : 'Nenhum User Profile encontrado nesta API Key. Confira a conta principal na Ayrshare. Você também pode adicionar diretamente pelo Profile Key.';
      } catch (err) { status.textContent = err.message; }
      finally { btn.disabled = false; }
    });
    document.getElementById('ay-add-page').addEventListener('submit', async (event) => {
      event.preventDefault();
      const btn = event.currentTarget.querySelector('[type="submit"]');
      const status = document.getElementById('ay-add-status');
      btn.disabled = true;
      status.textContent = 'Validando o perfil e identificando a página…';
      try {
        const response = await fetch('/api/facebook/ayrshare/pages', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profile_key: document.getElementById('ay-new-key').value.trim(), ref_id: selectedRefId }),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Não foi possível adicionar a página');
        document.getElementById('ay-clear-selection').click();
        status.textContent = data.page.page_name + ': ' + data.aviso;
        await loadAyrshare();
      } catch (err) { status.textContent = err.message; }
      finally { btn.disabled = false; }
    });
    async function loadAyrshare() {
      try {
        const res = await fetch('/api/facebook/pages');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha ao carregar');

        if (!data.conectado || !(data.pages || []).length) {
          contentEl.innerHTML = `
            <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-6 py-8 text-center">
              <p class="text-slate-300">Nenhuma página listada no app ainda.</p>
              <p class="mt-2 text-sm text-slate-500">
                Use “Adicionar página da Ayrshare” acima para cadastrar sua primeira página pelo Profile Key.
              </p>
              <a href="/api/auth/facebook"
                class="mt-5 inline-block rounded-lg border border-slate-700 px-5 py-2.5 text-sm font-medium text-slate-200 hover:border-[#1877F2] hover:text-white">
                Importar nomes via Facebook
              </a>
            </div>`;
          return;
        }

        const pagesHtml = (data.pages || [])
          .map((p) => {
            const isDefault = Boolean(p.is_default);
            const key = p.ayrshare_profile_key || '';
            const defaultBtn = isDefault
              ? `<span class="rounded-full bg-violet-500/20 px-2.5 py-0.5 text-xs font-semibold text-violet-200">página padrão</span>`
              : `<button type="button" data-set-default="${p.id}" class="ay-default-btn rounded-lg border border-violet-500/40 px-2.5 py-1 text-xs text-violet-200 hover:bg-violet-500/15">Usar como padrão</button>`;
            const keyBadge = p.has_ayrshare_profile_key
              ? `<span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs text-emerald-200">Profile Key ok</span>`
              : isDefault
                ? `<span class="rounded-full bg-sky-500/15 px-2.5 py-0.5 text-xs text-sky-200">usa Primary Profile</span>`
                : `<span class="rounded-full bg-amber-500/15 px-2.5 py-0.5 text-xs text-amber-200">sem Profile Key</span>`;
            const igOn = Boolean(p.instagram_ativo);
            const igUser = p.instagram_username ? '@' + p.instagram_username : '';
            const igBadge = igOn
              ? `<span class="rounded-full bg-pink-500/15 px-2.5 py-0.5 text-xs text-pink-200">Instagram ${escapeHtml(igUser) || 'ligado'}</span>`
              : `<span class="rounded-full bg-slate-700/40 px-2.5 py-0.5 text-xs text-slate-400">Instagram desligado</span>`;
            const igBtn = `<button type="button" data-ay-ig="${p.id}" data-ig-on="${igOn ? '1' : '0'}"
                class="ay-ig-btn rounded-lg border border-pink-500/40 px-2.5 py-1 text-xs text-pink-200 hover:bg-pink-500/15">
                ${igOn ? 'Desligar Instagram' : 'Ativar Instagram'}
              </button>`;
            const xOn = Boolean(p.x_ativo);
            const xUser = p.x_username ? '@' + p.x_username : '';
            const xBadge = xOn
              ? `<span class="rounded-full bg-slate-100/10 px-2.5 py-0.5 text-xs text-slate-100">X.com ${escapeHtml(xUser) || 'ligado'}</span>`
              : `<span class="rounded-full bg-slate-700/40 px-2.5 py-0.5 text-xs text-slate-400">X.com desligado</span>`;
            const xBtn = `<button type="button" data-ay-x="${p.id}" data-x-on="${xOn ? '1' : '0'}"
                class="ay-x-btn rounded-lg border border-slate-300/35 px-2.5 py-1 text-xs text-slate-100 hover:bg-slate-100/10">
                ${xOn ? 'Desligar X.com' : 'Ativar X.com'}
              </button>`;
            return `
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 ${isDefault ? 'ring-1 ring-violet-500/40' : ''}">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-white">${escapeHtml(p.page_name)}</p>
                <p class="text-xs text-slate-500">Alvo de publicação no ViralizeAI</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">${keyBadge}${igBadge}${xBadge}${defaultBtn}</div>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              ${igBtn}
              <span class="text-[11px] text-slate-500">
                Ligado, a matéria pode ser publicada também no Instagram do mesmo profile Ayrshare.
              </span>
            </div>
            <p data-ay-ig-msg="${p.id}" class="mt-1 text-[11px] text-slate-400"></p>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              ${xBtn}
              <span class="text-[11px] text-slate-500">
                Quando ativado, a matéria poderá ser publicada também no X.com do mesmo profile Ayrshare.
              </span>
            </div>
            <p data-ay-x-msg="${p.id}" class="mt-1 text-[11px] text-slate-400"></p>
            <label class="mt-3 block text-[11px] text-slate-500">
              Profile Key Ayrshare
              <div class="mt-1 flex flex-wrap gap-2">
                <input type="text" data-ay-key="${p.id}" value="${escapeHtml(key)}"
                  placeholder="Cole o Profile Key deste User Profile"
                  class="min-w-[16rem] flex-1 rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-xs text-slate-200 focus:border-emerald-500 focus:outline-none" />
                <button type="button" data-ay-save="${p.id}"
                  class="ay-save-btn rounded-lg border border-emerald-700/60 px-3 py-1.5 text-xs text-emerald-200 hover:border-emerald-400">
                  Salvar
                </button>
              </div>
            </label>
          </div>`;
          })
          .join('');

        contentEl.innerHTML = `
          <p class="text-xs text-slate-500 mb-4">
            A <strong class="font-medium text-slate-400">página padrão</strong> desta conta define para onde vão as
            matérias. As telas de matéria não têm mais seletor de Página: o destino é sempre a padrão marcada aqui.
          </p>
          <div class="space-y-3">${pagesHtml}</div>`;

        contentEl.querySelectorAll('.ay-default-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/pages/default', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ facebook_page_id: Number(btn.dataset.setDefault) }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao definir padrão');
              showAlert('Página padrão: ' + (j.page?.page_name || 'ok'));
              loadAyrshare();
            } catch (err) {
              showAlert(err.message, true);
              btn.disabled = false;
            }
          });
        });

        contentEl.querySelectorAll('.ay-ig-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = Number(btn.dataset.ayIg);
            const ligando = btn.dataset.igOn !== '1';
            const msgEl = contentEl.querySelector('[data-ay-ig-msg="' + id + '"]');
            const rotulo = btn.textContent;
            btn.disabled = true;
            btn.textContent = ligando ? 'Verificando na Ayrshare…' : 'Desligando…';
            if (msgEl) {
              msgEl.textContent = '';
              msgEl.className = 'mt-1 text-[11px] text-slate-400';
            }
            try {
              const r = await fetch('/api/facebook/ayrshare/instagram', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ facebook_page_id: id, ativo: ligando }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao configurar o Instagram');
              showAlert(j.aviso || 'Instagram atualizado');
              loadAyrshare();
            } catch (err) {
              if (msgEl) {
                msgEl.textContent = err.message;
                msgEl.className = 'mt-1 text-[11px] text-rose-300';
              }
              showAlert(err.message, true);
              btn.disabled = false;
              btn.textContent = rotulo;
            }
          });
        });

        contentEl.querySelectorAll('.ay-x-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = Number(btn.dataset.ayX);
            const ligando = btn.dataset.xOn !== '1';
            const msgEl = contentEl.querySelector('[data-ay-x-msg="' + id + '"]');
            const rotulo = btn.textContent;
            btn.disabled = true;
            btn.textContent = ligando ? 'Verificando na Ayrshare…' : 'Desligando…';
            if (msgEl) {
              msgEl.textContent = '';
              msgEl.className = 'mt-1 text-[11px] text-slate-400';
            }
            try {
              const r = await fetch('/api/facebook/ayrshare/x', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ facebook_page_id: id, ativo: ligando }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao configurar o X.com');
              showAlert(j.aviso || 'X.com atualizado');
              loadAyrshare();
            } catch (err) {
              if (msgEl) {
                msgEl.textContent = err.message;
                msgEl.className = 'mt-1 text-[11px] text-rose-300';
              }
              showAlert(err.message, true);
              btn.disabled = false;
              btn.textContent = rotulo;
            }
          });
        });

        contentEl.querySelectorAll('.ay-save-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = Number(btn.dataset.aySave);
            const input = contentEl.querySelector('input[data-ay-key="' + id + '"]');
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/ayrshare/profile-key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  facebook_page_id: id,
                  ayrshare_profile_key: input?.value || '',
                }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao salvar Profile Key');
              const base = j.page?.has_profile_key
                ? 'Profile Key salvo: ' + (j.page.page_name || '')
                : 'Profile Key removido';
              showAlert([base, j.aviso].filter(Boolean).join(' · '), !j.page?.has_profile_key);
              loadAyrshare();
            } catch (err) {
              showAlert(err.message, true);
              btn.disabled = false;
            }
          });
        });
      } catch (err) {
        contentEl.innerHTML = `<p class="text-rose-300">${escapeHtml(err.message)}</p>`;
      }
    }

    loadAyrshare();
    <% } else { %>
    const psStatusEl = document.getElementById('ps-status');
    const psActionsEl = document.getElementById('ps-actions');
    const psLinkPanel = document.getElementById('ps-link-panel');
    let lastPages = [];
    window.__psAccounts = [];

    function renderPsLinkPanel() {
      if (!psLinkPanel) return;
      const accounts = window.__psAccounts || [];
      const unlinked = (lastPages || []).filter((p) => !p.postsyncer_account_id);
      if (!accounts.length) {
        psLinkPanel.classList.add('hidden');
        psLinkPanel.innerHTML = '';
        return;
      }
      if (!unlinked.length) {
        psLinkPanel.classList.remove('hidden');
        psLinkPanel.innerHTML =
          '<p class="text-xs text-emerald-300/90">Todas as páginas do app já estão vinculadas ao PostSyncer.</p>';
        return;
      }
      const pageOpts = unlinked
        .map((p) => `<option value="${p.id}">${escapeHtml(p.page_name)}</option>`)
        .join('');
      const accOpts = accounts
        .map(
          (a) =>
            `<option value="${a.id}">${escapeHtml(a.label || a.name || a.username || a.id)}</option>`
        )
        .join('');
      psLinkPanel.classList.remove('hidden');
      psLinkPanel.innerHTML = `
        <div class="rounded-lg border border-sky-800/50 bg-sky-950/20 p-3">
          <p class="mb-2 text-xs text-sky-300/90">Escolha a Página do app e a conta correspondente no PostSyncer:</p>
          <div class="flex flex-wrap items-end gap-2 text-slate-300">
            <label class="text-xs">Página do app
              <select id="ps-link-page" class="mt-1 block rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-slate-200">${pageOpts}</select>
            </label>
            <label class="text-xs">Conta PostSyncer
              <select id="ps-link-account" class="mt-1 block rounded border border-slate-700 bg-slate-950 px-2 py-1.5 text-slate-200">${accOpts}</select>
            </label>
            <button type="button" id="ps-link-do"
              class="rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-sky-500">
              Vincular agora
            </button>
          </div>
        </div>`;

      document.getElementById('ps-link-do')?.addEventListener('click', async () => {
        const pageId = Number(document.getElementById('ps-link-page').value);
        const psId = Number(document.getElementById('ps-link-account').value);
        const btn = document.getElementById('ps-link-do');
        btn.disabled = true;
        try {
          const r = await fetch('/api/facebook/postsyncer/link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ facebook_page_id: pageId, postsyncer_account_id: psId }),
          });
          const j = await r.json();
          if (!r.ok) throw new Error(j.error || 'Falha ao vincular');
          showAlert('Vinculado: ' + (j.page?.page_name || 'ok') + ' → PostSyncer');
          await load();
          renderPsLinkPanel();
        } catch (err) {
          showAlert('Erro: ' + err.message, true);
          btn.disabled = false;
        }
      });
    }

    const connectHtml = `
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-6 py-10 text-center">
        <p class="text-slate-300">Ainda não há páginas neste app.</p>
        <p class="mt-2 text-sm text-slate-500">
          Com o PostSyncer já conectado acima, clique em <strong class="font-medium text-slate-400">Sincronizar / vincular</strong>
          para importar as páginas — sem precisar do OAuth do Facebook.
        </p>
        <a href="/api/auth/facebook"
          class="mt-5 inline-block rounded-lg border border-slate-700 px-5 py-2.5 text-sm font-medium text-slate-200 hover:border-[#1877F2] hover:text-white">
          Ou conectar com Facebook (opcional)
        </a>
      </div>`;

    async function load() {
      try {
        const res = await fetch('/api/facebook/pages');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha ao carregar');

        if (!data.conectado) {
          contentEl.innerHTML = connectHtml;
          lastPages = [];
          renderPsLinkPanel();
          return;
        }

        lastPages = data.pages || [];
        renderPsLinkPanel();

        const psAccounts = window.__psAccounts || [];
        const pagesHtml = (data.pages || [])
          .map((p) => {
            const linked = Boolean(p.postsyncer_account_id);
            const via = linked ? 'PostSyncer' : 'Não vinculado';
            const viaClass = linked ? 'bg-sky-500/15 text-sky-300' : 'bg-amber-500/15 text-amber-300';
            const isDefault = Boolean(p.is_default);
            let linkBtn = '';
            if (!linked && psAccounts.length === 1) {
              linkBtn = `<button type="button" data-ps-link-page="${p.id}" data-ps-id="${psAccounts[0].id}"
                class="ps-link-btn rounded-lg border border-sky-700 px-2.5 py-1 text-xs text-sky-300 hover:border-sky-400">
                Vincular PostSyncer
              </button>`;
            } else if (!linked && psAccounts.length > 1) {
              const opts = psAccounts
                .map(
                  (a) =>
                    `<option value="${a.id}">${escapeHtml(a.label || a.name || a.username || a.id)}</option>`
                )
                .join('');
              linkBtn = `<span class="inline-flex items-center gap-1">
                <select data-ps-page="${p.id}" class="ps-select rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-slate-200">${opts}</select>
                <button type="button" data-ps-link-select="${p.id}" class="ps-link-select rounded-lg border border-sky-700 px-2.5 py-1 text-xs text-sky-300">Vincular</button>
              </span>`;
            }
            const defaultBtn = isDefault
              ? `<span class="rounded-full bg-violet-500/20 px-2.5 py-0.5 text-xs font-semibold text-violet-200">página padrão</span>`
              : `<button type="button" data-set-default="${p.id}" class="ps-default-btn rounded-lg border border-violet-500/40 px-2.5 py-1 text-xs text-violet-200 hover:bg-violet-500/15">Usar como padrão</button>`;
            const unlinkBtn = linked
              ? `<button type="button" data-ps-unlink="${p.id}" class="ps-unlink-btn rounded-lg border border-rose-500/40 px-2.5 py-1 text-xs text-rose-300 hover:bg-rose-500/10">Remover PostSyncer</button>`
              : '';
            return `
          <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-3 ${isDefault ? 'ring-1 ring-violet-500/40' : ''}">
            <div>
              <p class="text-white">${escapeHtml(p.page_name)}</p>
              <p class="text-xs text-slate-500">ID: ${escapeHtml(p.page_id)}</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              ${defaultBtn}
              ${linkBtn}
              ${unlinkBtn}
              <span class="rounded-full ${viaClass} px-2.5 py-0.5 text-xs">via ${via}</span>
              <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs text-emerald-300">conectada</span>
            </div>
          </div>`;
          })
          .join('');

        contentEl.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-slate-400">
              ${data.oauth
                ? 'Conta Facebook conectada (FB user ' + escapeHtml(data.fb_user_id) + ')'
                  + (data.expira_em ? ' · token expira em ' + new Date(data.expira_em).toLocaleDateString('pt-BR') : '')
                : 'Páginas importadas do PostSyncer (OAuth Facebook opcional)'}
            </p>
            <div class="flex gap-2">
              ${data.oauth
                ? '<button id="refresh-pages" class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 hover:border-emerald-500 hover:text-emerald-300">Atualizar páginas</button>'
                : ''}
              <a href="/api/auth/facebook" class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 hover:border-emerald-500 hover:text-emerald-300">${data.oauth ? 'Reconectar' : 'Conectar Facebook'}</a>
            </div>
          </div>
          <p class="mt-3 text-xs text-slate-500">A <strong class="font-medium text-slate-400">página padrão</strong> já vem selecionada ao publicar matérias, na Biblioteca e na fila.</p>
          <div class="mt-5 space-y-3">
            ${pagesHtml || '<p class="text-slate-400">Nenhuma página encontrada. Clique em Sincronizar / vincular no PostSyncer acima.</p>'}
          </div>`;

        contentEl.querySelectorAll('.ps-default-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/pages/default', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ facebook_page_id: Number(btn.dataset.setDefault) }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao definir padrão');
              showAlert('Página padrão: ' + (j.page?.page_name || 'ok'));
              await load();
              renderPsLinkPanel();
            } catch (err) {
              showAlert('Erro: ' + err.message, true);
              btn.disabled = false;
            }
          });
        });

        contentEl.querySelectorAll('.ps-link-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/postsyncer/link', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  facebook_page_id: Number(btn.dataset.psLinkPage),
                  postsyncer_account_id: Number(btn.dataset.psId),
                }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao vincular');
              showAlert('Página vinculada ao PostSyncer: ' + (j.page?.page_name || ''));
              await load();
              renderPsLinkPanel();
            } catch (err) {
              showAlert('Erro: ' + err.message, true);
              btn.disabled = false;
            }
          });
        });

        contentEl.querySelectorAll('.ps-link-select').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const pageId = btn.dataset.psLinkSelect;
            const sel = contentEl.querySelector('select[data-ps-page="' + pageId + '"]');
            if (!sel) return;
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/postsyncer/link', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  facebook_page_id: Number(pageId),
                  postsyncer_account_id: Number(sel.value),
                }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao vincular');
              showAlert('Página vinculada ao PostSyncer');
              await load();
              renderPsLinkPanel();
            } catch (err) {
              showAlert('Erro: ' + err.message, true);
              btn.disabled = false;
            }
          });
        });

        contentEl.querySelectorAll('.ps-unlink-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            if (
              !confirm(
                'Remover o PostSyncer desta página?\n\nA publicação deixa de passar pelo PostSyncer.'
              )
            ) {
              return;
            }
            btn.disabled = true;
            try {
              const r = await fetch('/api/facebook/postsyncer/unlink', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ facebook_page_id: Number(btn.dataset.psUnlink) }),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || 'Falha ao remover');
              showAlert(j.aviso || 'PostSyncer removido desta página.');
              await load();
              renderPsLinkPanel();
            } catch (err) {
              showAlert('Erro: ' + err.message, true);
              btn.disabled = false;
            }
          });
        });

        document.getElementById('refresh-pages')?.addEventListener('click', async (e) => {
          e.currentTarget.disabled = true;
          await fetch('/api/facebook/pages?refresh=1');
          load();
        });
      } catch (err) {
        contentEl.innerHTML = `<p class="text-rose-300">${escapeHtml(err.message)}</p>` + connectHtml;
      }
    }

    async function loadPostsyncer() {
      if (!psStatusEl || !psActionsEl) return;
      try {
        const res = await fetch('/api/facebook/postsyncer/status');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha no status PostSyncer');

        if (!data.configured) {
          psStatusEl.textContent = 'Não configurado — adicione POSTSYNCER_API_KEY no .env';
          psActionsEl.innerHTML = '';
          return;
        }

        window.__psAccounts = data.accounts || [];
        const n = (data.accounts || []).length;
        psStatusEl.textContent =
          'API ok · workspace #' +
          (data.workspace_id || '?') +
          ' · ' +
          n +
          ' conta(s) Facebook' +
          (n ? '' : ' — conecte a Página em app.postsyncer.com');

        psActionsEl.innerHTML = `
          <button type="button" id="ps-unlink-all"
            class="rounded-lg border border-rose-500/40 px-3 py-1.5 text-sm text-rose-300 hover:bg-rose-500/10">
            Remover PostSyncer de todas
          </button>
          <a href="https://app.postsyncer.com" target="_blank" rel="noopener"
            class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 hover:border-sky-500">
            Abrir PostSyncer
          </a>
          <button type="button" id="ps-sync"
            class="rounded-lg border border-sky-700 px-3 py-1.5 text-sm text-sky-300 hover:border-sky-400">
            Sincronizar / vincular
          </button>`;

        document.getElementById('ps-unlink-all')?.addEventListener('click', async () => {
          if (
            !confirm(
              'Remover o PostSyncer de TODAS as páginas?\n\nNão precisa entrar no PostSyncer.'
            )
          ) {
            return;
          }
          try {
            const r = await fetch('/api/facebook/postsyncer/unlink', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ all: true }),
            });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || 'Falha');
            showAlert(j.aviso || 'PostSyncer removido.');
            await load();
            renderPsLinkPanel();
          } catch (err) {
            showAlert('Erro: ' + err.message, true);
          }
        });

        document.getElementById('ps-sync')?.addEventListener('click', async () => {
          const btn = document.getElementById('ps-sync');
          btn.disabled = true;
          try {
            const r = await fetch('/api/facebook/postsyncer/sync', { method: 'POST' });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || 'Falha sync');
            showAlert(
              'PostSyncer: ' +
                (j.message || 'sincronizado') +
                (j.linked != null ? ' · vinculados: ' + j.linked : '')
            );
            await load();
            renderPsLinkPanel();
          } catch (err) {
            showAlert('Erro PostSyncer: ' + err.message, true);
          } finally {
            btn.disabled = false;
          }
        });

        renderPsLinkPanel();
      } catch (err) {
        psStatusEl.textContent = err.message;
        psActionsEl.innerHTML = '';
      }
    }

    loadPostsyncer();
    load();
    <% } %>
  </script>
<%- include('partials/app-end') %>
