<%- include('partials/app-start') %>

  <main class="mx-auto max-w-9xl px-4 py-10">
    <h1 class="text-2xl font-semibold text-white">Cookies</h1>
    <p class="mt-2 max-w-3xl text-slate-400">
      Sessões do YouTube, Instagram e Facebook. Quando uma expirar, cole o conteúdo aqui
      (ou envie o <span class="font-mono text-xs">.txt</span>) e teste —
      <strong class="text-slate-300">sem precisar de SSH nem subir arquivo no servidor</strong>.
    </p>

    <div id="cartoes" class="mt-6 space-y-5">
      <p class="text-sm text-slate-400">Carregando…</p>
    </div>

    <section class="mt-8 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
      <h2 class="font-medium text-white">Como gerar o arquivo de cookies</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-sm text-slate-300">
        <li>
          Instale a extensão <strong class="text-white">Get cookies.txt LOCALLY</strong> no Chrome/Edge
          (exporta no formato Netscape).
        </li>
        <li>
          Abra uma <strong class="text-white">janela anônima</strong> (Ctrl+Shift+N) e permita a extensão nela
          (em <span class="font-mono text-xs">chrome://extensions</span> → detalhes → "Permitir em anônimo").
        </li>
        <li>
          Na janela anônima, entre no site e <strong class="text-white">faça login</strong> — de preferência
          com uma conta secundária, não a principal.
        </li>
        <li>
          No YouTube, ainda logado, visite
          <span class="font-mono text-xs">youtube.com/robots.txt</span>
          antes de exportar (evita que a sessão seja invalidada na exportação).
        </li>
        <li>
          Clique na extensão, use <strong class="text-white">Export</strong> e abra o
          <span class="font-mono text-xs">.txt</span>. Cole o conteúdo no cartão da plataforma, ou envie o arquivo.
        </li>
        <li>
          <strong class="text-white">Feche a janela anônima sem deslogar.</strong> Se usar essa conta no
          navegador depois, os cookies expiram rápido.
        </li>
        <li>Salve e clique em <strong class="text-white">Testar sessão</strong>.</li>
      </ol>
      <p class="mt-4 text-xs text-amber-300/80">
        Pode colar o export inteiro do navegador: o sistema descarta tudo que não for do domínio da
        plataforma antes de gravar, e o conteúdo nunca volta para a tela nem para o log.
      </p>
    </section>
  </main>

  <script>
    const PLATAFORMAS = [
      { id: 'youtube', rotulo: 'YouTube', dominio: '.youtube.com', usadoEm: 'transcrição de vídeo, legendas e importação' },
      { id: 'instagram', rotulo: 'Instagram', dominio: '.instagram.com', usadoEm: 'leitura de perfis e posts na biblioteca' },
      { id: 'facebook', rotulo: 'Facebook', dominio: '.facebook.com', usadoEm: 'leitura de páginas e posts' },
    ];

    const container = document.getElementById('cartoes');

    function escapar(valor) {
      return String(valor == null ? '' : valor).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    }

    function formatarData(iso) {
      if (!iso) return '—';
      try { return new Date(iso).toLocaleString('pt-BR'); } catch { return iso; }
    }

    function montarCartao(p) {
      return `
        <section class="rounded-xl border border-slate-800 bg-slate-900/60 p-5" data-plataforma="${p.id}">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="font-medium text-white">${escapar(p.rotulo)}</h2>
              <p class="mt-0.5 text-xs text-slate-500">Usado em: ${escapar(p.usadoEm)}</p>
            </div>
            <span class="js-badge rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-400">…</span>
          </div>

          <div class="js-status mt-3 text-sm text-slate-400">Carregando…</div>

          <div class="mt-4 space-y-3">
            <label class="block text-xs text-slate-400">
              Enviar arquivo .txt
              <input type="file" accept=".txt" class="js-arquivo mt-1 w-full text-sm text-slate-300 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-700 file:px-3 file:py-2 file:text-sm file:text-slate-100 hover:file:bg-slate-600" />
            </label>

            <label class="block text-xs text-slate-400">
              ou cole o conteúdo dos cookies
              <textarea rows="4" spellcheck="false"
                class="js-conteudo mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-xs text-slate-200 placeholder:text-slate-600 focus:border-emerald-500 focus:outline-none"
                placeholder="# Netscape HTTP Cookie File&#10;${escapar(p.dominio)}&#9;TRUE&#9;/&#9;TRUE&#9;…"></textarea>
            </label>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <button type="button" class="js-salvar rounded-lg bg-emerald-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-emerald-400 disabled:opacity-50">
              Salvar
            </button>
            <button type="button" class="js-testar rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-200 hover:border-emerald-500 hover:text-emerald-300 disabled:opacity-50">
              Testar sessão
            </button>
            <button type="button" class="js-remover ml-auto rounded-lg border border-slate-800 px-3 py-2 text-xs text-slate-500 hover:border-rose-500/50 hover:text-rose-300 disabled:opacity-50">
              Apagar
            </button>
          </div>

          <p class="js-resultado mt-3 text-sm"></p>
        </section>
      `;
    }

    function pintarStatus(cartao, dados) {
      const badge = cartao.querySelector('.js-badge');
      const status = cartao.querySelector('.js-status');

      if (!dados.existe) {
        badge.className = 'js-badge rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-400';
        badge.textContent = 'sem cookies';
        status.innerHTML = 'Nenhum cookie salvo ainda.'
          + (dados.porEnv
            ? ` O servidor aponta <span class="font-mono text-xs">${escapar(dados.variavelEnv)}</span> para <span class="font-mono text-xs">${escapar(dados.caminho)}</span>.`
            : '');
        return;
      }

      const problema = !dados.temSessao || dados.expirou;
      badge.className = problema
        ? 'js-badge rounded-full border border-rose-500/50 bg-rose-500/10 px-2.5 py-1 text-xs text-rose-300'
        : 'js-badge rounded-full border border-emerald-500/50 bg-emerald-500/10 px-2.5 py-1 text-xs text-emerald-300';
      badge.textContent = dados.expirou ? 'expirado' : (dados.temSessao ? 'sessão ativa' : 'sem login');

      const linhas = [
        `${dados.total} cookie(s) · ` + (dados.temSessao
          ? '<span class="text-emerald-400">com cookies de login</span>'
          : '<span class="text-rose-400">sem cookies de login — refaça a exportação logado</span>'),
        `Salvo em ${escapar(formatarData(dados.atualizadoEm))}`,
      ];
      if (dados.expiraEm) {
        linhas.push(dados.expirou
          ? `<span class="text-rose-400">A sessão expirou em ${escapar(formatarData(dados.expiraEm))} — envie cookies novos.</span>`
          : `Expira em ${escapar(formatarData(dados.expiraEm))}`);
      }
      // O caminho só interessa a quem for mexer no servidor: fica discreto.
      linhas.push(`<span class="text-xs text-slate-600">${escapar(dados.caminho)}${dados.porEnv ? ' (via ' + escapar(dados.variavelEnv) + ')' : ''}</span>`);
      status.innerHTML = linhas.join('<br>');
    }

    function mostrar(cartao, texto, tipo) {
      const cores = { ok: 'text-emerald-400', erro: 'text-rose-400', neutro: 'text-slate-400' };
      const alvo = cartao.querySelector('.js-resultado');
      alvo.className = 'js-resultado mt-3 text-sm ' + (cores[tipo] || cores.neutro);
      alvo.textContent = texto;
    }

    async function carregarStatus() {
      try {
        const res = await fetch('/api/cookies/status');
        const data = await res.json();
        const porId = new Map((data.plataformas || []).map((p) => [p.plataforma, p]));
        for (const p of PLATAFORMAS) {
          const cartao = container.querySelector(`[data-plataforma="${p.id}"]`);
          const dados = porId.get(p.id);
          if (cartao && dados) pintarStatus(cartao, dados);
        }
      } catch {
        container.querySelectorAll('.js-status').forEach((el) => {
          el.textContent = 'Erro ao carregar o status.';
        });
      }
    }

    async function salvar(cartao, id) {
      const arquivo = cartao.querySelector('.js-arquivo').files[0];
      const conteudo = cartao.querySelector('.js-conteudo').value.trim();
      if (!arquivo && !conteudo) {
        mostrar(cartao, 'Escolha um arquivo ou cole o conteúdo dos cookies.', 'erro');
        return;
      }

      const botao = cartao.querySelector('.js-salvar');
      botao.disabled = true;
      mostrar(cartao, 'Salvando…', 'neutro');
      try {
        let res;
        if (arquivo) {
          const fd = new FormData();
          fd.append('arquivo', arquivo);
          res = await fetch(`/api/cookies/${id}`, { method: 'POST', body: fd });
        } else {
          res = await fetch(`/api/cookies/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ conteudo }),
          });
        }
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha ao salvar');
        mostrar(cartao, '✓ ' + data.message, 'ok');
        // Não deixa o conteúdo da sessão parado na tela depois de gravado.
        cartao.querySelector('.js-conteudo').value = '';
        cartao.querySelector('.js-arquivo').value = '';
        carregarStatus();
      } catch (err) {
        mostrar(cartao, '✗ ' + err.message, 'erro');
      } finally {
        botao.disabled = false;
      }
    }

    async function testar(cartao, id) {
      const botao = cartao.querySelector('.js-testar');
      botao.disabled = true;
      mostrar(cartao, 'Consultando a plataforma (pode levar ~20s)…', 'neutro');
      try {
        const res = await fetch(`/api/cookies/${id}/test`, { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          mostrar(cartao, '✓ ' + data.message + (data.detalhe ? ` (${data.detalhe})` : ''), 'ok');
        } else {
          mostrar(cartao, '✗ ' + (data.error || 'Falha no teste'), 'erro');
        }
      } catch {
        mostrar(cartao, '✗ Erro de rede ao testar.', 'erro');
      } finally {
        botao.disabled = false;
        carregarStatus();
      }
    }

    async function remover(cartao, id, rotulo) {
      if (!window.confirm(`Apagar os cookies do ${rotulo}? As funções que dependem dessa sessão param até você enviar outros.`)) {
        return;
      }
      const botao = cartao.querySelector('.js-remover');
      botao.disabled = true;
      try {
        const res = await fetch(`/api/cookies/${id}`, { method: 'DELETE' });
        const data = await res.json();
        mostrar(cartao, data.message || 'Apagado.', 'neutro');
        carregarStatus();
      } catch {
        mostrar(cartao, '✗ Erro ao apagar.', 'erro');
      } finally {
        botao.disabled = false;
      }
    }

    container.innerHTML = PLATAFORMAS.map(montarCartao).join('');
    for (const p of PLATAFORMAS) {
      const cartao = container.querySelector(`[data-plataforma="${p.id}"]`);
      cartao.querySelector('.js-salvar').addEventListener('click', () => salvar(cartao, p.id));
      cartao.querySelector('.js-testar').addEventListener('click', () => testar(cartao, p.id));
      cartao.querySelector('.js-remover').addEventListener('click', () => remover(cartao, p.id, p.rotulo));
    }
    carregarStatus();
  </script>
<%- include('partials/app-end') %>
